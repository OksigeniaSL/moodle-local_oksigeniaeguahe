{{!
    The poster of an open day, to print in A4 or A3 from the browser (DESIGN.md of the sendings, by the art director):
    the brand of the centre and the language of the page of the family. A sheet of A4 of 794 x 1123 CSS px; A3 scales
    the same sheet, so nothing moves. Backgrounds to the edge; every text 14 mm inside.
}}<!doctype html>
<html lang="{{lang}}">
<head>
<meta charset="utf-8">
<title>{{titular}} · {{centro.nombre}}</title>
<style>
@font-face { font-family: 'Eg Sans'; src: url('{{fuente_sans}}') format('woff2'); font-weight: 400 800; font-display: block; }
@page { size: {{papel}} portrait; margin: 0; }
:root {
  --c-acento: {{c.acento}}; --c-sobre-acento: {{c.sobre_acento}}; --c-acento-texto: {{c.acento_texto}};
  --c-vivo: {{c.vivo}}; --c-pared: {{c.pared}};
  --tinta: #2B2226; --tinta-2: #5F5459; --papel: #FFFFFF;
  --madera: #BC8759; --madera-luz: #D2A57C; --madera-sombra: #8E5E3A; --gancho: #7A5236;
  --mochila: #CF6450; --mochila-sombra: #9E4A3B; --mochila-luz: #F1C9C0;
  --k: {{escala}};
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: #FFFFFF; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font-family: 'Eg Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: var(--tinta); }
.pliego { width: calc(794px * var(--k)); height: calc(1122px * var(--k)); overflow: hidden; }
.hoja { position: relative; width: 794px; height: 1123px; transform: scale(var(--k)); transform-origin: 0 0; overflow: hidden;
  display: flex; flex-direction: column; background: var(--papel); }
.muestra { position: absolute; z-index: 2; top: 18px; right: 53px; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--tinta-2); }

/* The wall, as on the family page */
.pared { position: relative; background: radial-gradient(ellipse 70% 90% at 25% 20%, rgba(255, 248, 236, .9), transparent 70%), var(--c-pared); padding: 50px 53px 0; }
.cabecera { display: flex; align-items: center; gap: 14px; height: 48px; }
.cabecera img { display: block; height: 48px; width: auto; }
.cabecera .nombre { font-size: 22px; font-weight: 750; letter-spacing: -.01em; }
.rotulo { margin: 32px 0 0; font-size: 17px; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; color: var(--c-acento-texto); }
h1 { margin: 6px 0 0; font-size: 82px; line-height: .96; font-weight: 790; letter-spacing: -.035em; }
.riel { position: relative; height: 34px; margin: 30px -53px 0; background:
    linear-gradient(to bottom, var(--madera-luz) 0 2px, transparent 2px calc(100% - 5px), var(--madera-sombra) calc(100% - 5px)),
    repeating-linear-gradient(90deg, transparent 0 46px, rgba(90, 55, 30, .07) 46px 47px, transparent 47px 83px, rgba(255, 240, 220, .08) 83px 84px),
    var(--madera); box-shadow: 0 14px 22px -14px rgba(70, 45, 30, .3); }
.percha { display: flex; align-items: flex-start; gap: 34px; padding: 0 0 18px 30px; }
.colgante { display: block; width: 210px; height: auto; margin-top: -2px; overflow: visible; flex: none; }
.pregunta { padding-top: 104px; position: relative; }
.pregunta p { margin: 0; }
.pregunta .q { font-size: 36px; line-height: 1.08; font-weight: 780; letter-spacing: -.02em; }
.pregunta .sub { margin-top: 12px; font-size: 19px; line-height: 1.4; color: var(--tinta-2); }
.flecha { position: absolute; left: -84px; top: 118px; width: 78px; height: 74px; overflow: visible; }

/* The day */
.dia { padding: 34px 53px 0; flex: 1; }
.fecha { margin: 0; font-size: 58px; line-height: 1; font-weight: 790; letter-spacing: -.03em; }
.hora { margin: 12px 0 0; font-size: 28px; font-weight: 700; }
.lugar { margin: 6px 0 0; font-size: 22px; color: var(--tinta-2); }

/* The band with the QR */
.banda { position: relative; display: flex; align-items: center; gap: 34px; padding: 32px 53px 53px; background: var(--c-acento); color: var(--c-sobre-acento); }
.banda .firma { position: absolute; right: 53px; bottom: 18px; font-size: 11px; letter-spacing: .02em; }
.qr { flex: none; width: 184px; height: 184px; padding: 14px; border-radius: 18px; background: #FFFFFF; }
.qr svg, .qr img { display: block; width: 100%; height: 100%; }
.banda p { margin: 0; }
.banda .llamada { font-size: 34px; line-height: 1.05; font-weight: 790; letter-spacing: -.02em; }
.banda .como { margin-top: 10px; font-size: 19px; line-height: 1.4; }
.banda .url { margin-top: 14px; font-size: 25px; font-weight: 750; letter-spacing: -.005em; }
.banda .tel { margin-top: 6px; font-size: 18px; }
</style>
</head>
<body>
<div class="pliego"><div class="hoja">
  {{#muestra}}<span class="muestra">{{muestra}}</span>{{/muestra}}
  <section class="pared">
    <header class="cabecera">{{#centro.logo}}<img src="{{centro.logo}}" alt="">{{/centro.logo}}{{#centro.nombre_visible}}<span class="nombre">{{centro.nombre}}</span>{{/centro.nombre_visible}}</header>
    <p class="rotulo">{{acto}}</p>
    <h1>{{{titular_html}}}</h1>
    <div class="riel" aria-hidden="true"></div>
    <div class="percha">
      <svg class="colgante" viewBox="6 13 52 64" aria-hidden="true">
        <defs><filter id="sombra" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="1.1"/></filter></defs>
        <path fill="var(--gancho)" d="M31 13 L33.6 13 L33.6 23.4 L31 23.4 Z"/>
        <g transform="translate(0.3 16) rotate(-3.5 32 9)">
          <path fill="rgba(70,45,30,.16)" filter="url(#sombra)" transform="translate(2 2.4)" d="M13 30 C13 21 19.5 14 28.5 14 L35.5 14 C44.5 14 51 21 51 30 L51 55.5 C51 58 49 60 46.5 60 L17.5 60 C15 60 13 58 13 55.5 Z"/>
          <path fill="var(--mochila)" d="M28 15.5 L28 11 C28 8.8 29.8 7 32 7 C34.2 7 36 8.8 36 11 L36 15.5 L34.4 15.5 L34.4 11 C34.4 9.7 33.3 8.6 32 8.6 C30.7 8.6 29.6 9.7 29.6 11 L29.6 15.5 Z"/>
          <path fill="var(--mochila-sombra)" d="M48 19 C55 23 56.4 40 54.6 62 L52.4 61.8 C54 41 52.6 25.4 46.6 21.6 Z"/>
          <path fill="var(--mochila)" d="M13 30 C13 21 19.5 14 28.5 14 L35.5 14 C44.5 14 51 21 51 30 L51 55.5 C51 58 49 60 46.5 60 L17.5 60 C15 60 13 58 13 55.5 Z"/>
          <path fill="var(--mochila-luz)" d="M16 22 L16 28.5 C16 31.5 18.4 33.6 21.4 33.6 L42.6 33.6 C45.6 33.6 48 31.5 48 28.5 L48 22 L46.2 22 L46.2 28.5 C46.2 30.5 44.6 31.8 42.6 31.8 L21.4 31.8 C19.4 31.8 17.8 30.5 17.8 28.5 L17.8 22 Z"/>
          <g transform="translate(32 47) rotate(-8) scale(0.68)">
            <path fill="var(--mochila)" stroke="var(--mochila)" stroke-width="3.5" stroke-linejoin="round" d="M-23 -12 Q-23 -16 -19 -16 L19 -16 Q23 -16 23 -12 L23 8 L15 16 L-19 16 Q-23 16 -23 12 Z"/>
            <path fill="var(--c-vivo)" d="M-23 -12 Q-23 -16 -19 -16 L19 -16 Q23 -16 23 -12 L23 8 L15 16 L-19 16 Q-23 16 -23 12 Z"/>
            <path fill="#FFFFFF" d="M-20.6 -6.2 L20.6 -6.2 L20.6 7 L13.8 13.8 L-18.6 13.8 Q-20.6 13.8 -20.6 11.8 Z"/>
            <path fill="#8C8178" d="M-15 6.2 L9 6.2 L9 7.9 L-15 7.9 Z"/>
            <path fill="#DCCDBB" d="M23 8 L15 16 L15 8 Z"/>
          </g>
        </g>
        <path fill="var(--gancho)" d="M32.3 21.2 A3 3 0 1 1 32.29 21.2 Z"/>
        <path fill="#FFFFFF" opacity=".28" d="M31.1 22.6 A1.2 1.2 0 1 1 31.09 22.6 Z"/>
      </svg>
      <div class="pregunta">
        <svg class="flecha" viewBox="0 0 78 74" aria-hidden="true"><path d="M74 6 C46 4 20 22 10 64" fill="none" stroke="var(--tinta-2)" stroke-width="3" stroke-linecap="round"/><path d="M2 52 L10 66 L22 55" fill="none" stroke="var(--tinta-2)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p class="q">{{{pregunta_html}}}</p>
        <p class="sub">{{pregunta_sub}}</p>
      </div>
    </div>
  </section>
  <section class="dia">
    <p class="fecha">{{fecha}}</p>
    <p class="hora">{{hora}}</p>
    <p class="lugar">{{lugar}}</p>
  </section>
  <section class="banda">
    <div class="qr" role="img" aria-label="{{qr_alt}}">{{{qr_svg}}}</div>
    <div>
      <p class="llamada">{{llamada}}</p>
      <p class="como">{{como}}</p>
      {{#url_corta}}<p class="url">{{url_corta}}</p>{{/url_corta}}
      {{#telefono_texto}}<p class="tel">{{telefono_texto}}</p>{{/telefono_texto}}
    </div>
    {{#firma}}<p class="firma">{{firma}}</p>{{/firma}}
  </section>
</div></div>
</body>
</html>
