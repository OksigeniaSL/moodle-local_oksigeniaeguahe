// Oksigenia Eguahe · {{{name}}}
{{#form}}
// Sends each answer of this form, as it comes, to the inbox of the centre.
//   1. In the form, menu ⋮ › Apps Script. Replace what is there with all of this, and save.
//   2. Choose «eguaheInstall» and press Run, once. Google asks for permission the first time.
//   3. To send also the answers the form already has, choose «eguaheSendAll» and press Run.
{{/form}}
{{#sheet}}
// Sends each new row of this sheet to the inbox of the centre, every ten minutes, and every night all the rows again,
// so that what the team writes later in a row (a second call, the day of the visit) arrives too. Nothing comes in twice.
//   1. In the sheet, menu Extensions › Apps Script. Replace what is there with all of this, and save.
//   2. If the rows are not in the first tab, write the names of their tabs below, between quotes and separated by
//      commas: ['Publi', 'Visitas'].
//   3. Choose «eguaheInstall» and press Run, once. Google asks for permission the first time.
//   4. To send also the rows the sheet already has, choose «eguaheSendAll» and press Run.
const EGUAHE_TABS = [];
// The titles of the columns, to find their row if something is written above it.
const EGUAHE_TITLES = {{{titles}}}.map(eguahePlain_);
{{/sheet}}
// The key below signs what is sent: whoever has it can send families to the centre. Do not share it.
const EGUAHE_URL = {{{url}}};
const EGUAHE_KEY = {{{secret}}};
{{#form}}

function eguaheInstall() {
  const form = FormApp.getActiveForm();
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (['eguaheOnSubmit', 'eguaheNightly'].indexOf(trigger.getHandlerFunction()) !== -1) {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  ScriptApp.newTrigger('eguaheOnSubmit').forForm(form).onFormSubmit().create();
  // Every night it calls though there is nothing new, so the centre knows that it is still there.
  ScriptApp.newTrigger('eguaheNightly').timeBased().atHour(2).everyDays(1).create();
}

function eguaheNightly() {
  eguahePost_([], []);
}

function eguaheOnSubmit(e) {
  eguahePost_([eguaheItem_(e.response, false)]);
}

function eguaheSendAll() {
  const items = FormApp.getActiveForm().getResponses().map(function (response) {
    return eguaheItem_(response, true);
  });
  for (let i = 0; i < items.length; i += 100) {
    eguahePost_(items.slice(i, i + 100));
  }
}

function eguaheItem_(response, past) {
  const answers = {};
  const email = response.getRespondentEmail();
  if (email) {
    answers['Email'] = email;
  }
  response.getItemResponses().forEach(function (item) {
    const value = item.getResponse();
    answers[item.getItem().getTitle()] = Array.isArray(value) ? value.join(', ') : String(value);
  });
  return { id: response.getId(), time: response.getTimestamp().toISOString(), past: past, answers: answers };
}
{{/form}}
{{#sheet}}

function eguaheInstall() {
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (['eguaheCheck', 'eguaheNightly'].indexOf(trigger.getHandlerFunction()) !== -1) {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  ScriptApp.newTrigger('eguaheCheck').timeBased().everyMinutes(10).create();
  ScriptApp.newTrigger('eguaheNightly').timeBased().atHour(2).everyDays(1).create();
  // From now on, only the rows that arrive.
  eguaheTabs_().forEach(function (tab) {
    PropertiesService.getScriptProperties().setProperty('eguaheRows:' + tab.getName(), String(tab.getLastRow()));
  });
}

function eguaheCheck() {
  eguaheTabs_().forEach(function (tab) {
    const done = Number(PropertiesService.getScriptProperties().getProperty('eguaheRows:' + tab.getName()) || '1');
    if (tab.getLastRow() > done) {
      eguaheRows_(tab, done + 1, false);
    }
  });
}

function eguaheNightly() {
  eguaheTabs_().forEach(function (tab) {
    eguaheRows_(tab, 2, true);
  });
  // It calls though there is nothing, and says which tabs it did not find (renamed or gone).
  const book = SpreadsheetApp.getActiveSpreadsheet();
  eguahePost_([], EGUAHE_TABS.filter(function (name) { return !book.getSheetByName(name); }));
}

function eguaheSendAll() {
  eguaheNightly();
}

function eguaheRows_(tab, from, past) {
  const values = tab.getDataRange().getDisplayValues();
  const top = eguaheTop_(values);
  // A name that comes twice keeps both: the second one is «… (2)».
  const seen = {};
  const head = values[top].map(function (question) {
    const name = String(question).trim();
    seen[name] = (seen[name] || 0) + 1;
    return name !== '' && seen[name] > 1 ? name + ' (' + seen[name] + ')' : name;
  });
  let items = [];
  for (let r = from <= top + 2 ? 0 : from - 1; r < values.length; r++) {
    // Above the titles, only what is clearly a contact: a tool that did not find them wrote it there.
    if (r === top || (r < top && !values[r].some(eguaheValue_))) {
      continue;
    }
    const answers = {};
    head.forEach(function (question, c) {
      if (question !== '' && values[r][c] !== '') {
        answers[question] = values[r][c];
      }
    });
    if (Object.keys(answers).length) {
      items.push({ past: past, answers: answers });
    }
    if (items.length === 100) {
      eguahePost_(items);
      items = [];
    }
  }
  if (items.length) {
    eguahePost_(items);
  }
  PropertiesService.getScriptProperties().setProperty('eguaheRows:' + tab.getName(), String(values.length));
}

// The row of titles, among the first three: one without any value in it, with most of the titles this sheet has had.
function eguaheTop_(values) {
  let top = 0;
  let most = -1;
  values.slice(0, 3).forEach(function (row, r) {
    const found = {};
    row.forEach(function (cell) {
      const title = eguahePlain_(cell);
      if (title !== '' && EGUAHE_TITLES.indexOf(title) !== -1) {
        found[title] = true;
      }
    });
    const n = Object.keys(found).length - (row.some(eguaheValue_) ? 1000 : 0);
    if (n > most) {
      top = r;
      most = n;
    }
  });
  return top;
}

// An email, a phone, a moment or an identifier of the ads: never the title of a column.
function eguaheValue_(cell) {
  const text = String(cell).trim();
  return /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(text) || /^\d{4}-\d{2}-\d{2}[T ]\d{1,2}:\d{2}/.test(text) ||
    /^[a-z]{1,2}:\+?\d{6,}$/i.test(text) || /^\+\d[\d\s().-]{7,}$/.test(text) || /^\d{9,16}$/.test(text);
}

function eguahePlain_(text) {
  return String(text).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
}

function eguaheTabs_() {
  const book = SpreadsheetApp.getActiveSpreadsheet();
  return EGUAHE_TABS.length ? EGUAHE_TABS.map(function (name) { return book.getSheetByName(name); })
    .filter(function (tab) { return tab; }) : [book.getSheets()[0]];
}
{{/sheet}}

function eguahePost_(items, missing) {
  const body = JSON.stringify(missing ? { items: items, beat: true, missing: missing } : { items: items });
  const signature = Utilities.computeHmacSha256Signature(body, EGUAHE_KEY, Utilities.Charset.UTF_8)
    .map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
  const reply = UrlFetchApp.fetch(EGUAHE_URL, {
    method: 'post',
    contentType: 'application/json; charset=utf-8',
    payload: body,
    headers: { 'X-Eguahe-Signature': 'sha256=' + signature },
    muteHttpExceptions: true
  });
  if (reply.getResponseCode() !== 200) {
    throw new Error('Eguahe: ' + reply.getResponseCode() + ' ' + reply.getContentText());
  }
}
