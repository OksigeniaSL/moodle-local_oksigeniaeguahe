{{!
    @template local_oksigeniaeguahe/panel_invite_state

    How the invitation of an act goes, on its page and on the page of the act: what was just done, the letters still to go
    out, to stop them, and what Marandu says of the send by phone, to take it back while it waits.

    Example context (json):
    {
        "i": {"info": "", "enviado": ""}, "notice": {"text": "La carta se ha mandado a elena@example.com.", "error": false}, "posturl": "https://example.com/event.php", "sesskey": "abc",
        "going": {"text": "Quedan 3 cartas por salir. Las últimas, hoy a las 18:02.", "stop": true},
        "said": "Espera a que la dirección lo apruebe.", "withdraw": {"bulk": 4},
        "paused": {"text": "La carta está parada: quedan 12 familias por recibirla.", "resume": true},
        "phonetoo": {"title": "También por WhatsApp o Telegram", "text": "Para las 71 familias que tienen la carta por correo y aún no han contestado.",
            "url": "", "check": {"boxes": [{"key": "go", "n": 60, "label": "la recibirán"}, {"key": "nophone", "n": 11, "label": "sin teléfono"},
            {"key": "cannot", "n": 0, "label": "no se puede"}], "why": [{"text": "Sin teléfono: se quedan con la carta."}],
            "lines": [{"text": "Por WhatsApp son 60 mensajes, unos 3,00 €."}], "note": "Las que solo tienen su número la reciben por WhatsApp.",
            "go": "Mandarla a las 60"} }
    }
}}
{{#notice}}<p class="aviso-suave invitar-estado{{#error}} con-error{{/error}}" role="{{#error}}alert{{/error}}{{^error}}status{{/error}}" data-aviso>{{{i.info}}}<span>{{text}}</span></p>{{/notice}}
{{#going}}<div class="aviso-suave invitar-estado">{{{i.enviado}}}<span>{{text}}</span>{{#stop}}<form method="post" action="{{posturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="invitestop"><button class="boton secundario pequeno" type="submit">{{#str}}panel_invite_stop, local_oksigeniaeguahe{{/str}}</button></form>{{/stop}}</div>{{/going}}
{{#paused}}<div class="aviso-suave invitar-estado">{{{i.enviado}}}<span>{{text}}</span>{{#resume}}<form method="post" action="{{posturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="inviteresume"><button class="boton principal pequeno" type="submit">{{#str}}panel_invite_resume, local_oksigeniaeguahe{{/str}}</button></form>{{/resume}}</div>{{/paused}}
{{#said}}<div class="aviso-suave invitar-estado">{{{i.info}}}<span>{{said}}</span>{{#withdraw}}<form method="post" action="{{posturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="withdraw"><input type="hidden" name="bulk" value="{{bulk}}"><button class="boton secundario pequeno" type="submit">{{#str}}panel_invite_withdraw, local_oksigeniaeguahe{{/str}}</button></form>{{/withdraw}}</div>{{/said}}
{{#skipped}}<div class="aviso-suave invitar-estado">{{{i.info}}}<details><summary>{{text}}</summary><ul class="repaso-nombres">{{#names}}<li><a href="{{url}}">{{name}}</a> <span class="secundario">{{note}}</span></li>{{/names}}</ul></details></div>{{/skipped}}
{{#phonetoo}}<section class="aviso-suave invitar-telefono" id="invitar-telefono" aria-labelledby="invitar-telefono-titulo"><h3 id="invitar-telefono-titulo">{{{i.enviado}}}<span>{{title}}</span></h3><p>{{text}}</p>{{#check}}<ul class="carta-cuenta">{{#boxes}}<li class="carta-{{key}}{{^n}} carta-cero{{/n}}"><b>{{n}}</b><span>{{label}}</span></li>{{/boxes}}</ul>{{#why}}<p class="invitar-telefono-por">{{text}}</p>{{/why}}{{#lines}}<p class="invitar-telefono-linea">{{text}}</p>{{/lines}}<p class="invitar-telefono-por">{{note}}</p>{{#go}}<form method="post" action="{{posturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="invitephone"><button class="boton principal pequeno" type="submit">{{go}}</button></form>{{/go}}{{/check}}{{#url}}<a class="boton secundario pequeno" href="{{url}}">{{#str}}panel_phonetoo_see, local_oksigeniaeguahe{{/str}}</a>{{/url}}</section>{{/phonetoo}}
