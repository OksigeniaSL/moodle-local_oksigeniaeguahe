{{!
    @template local_oksigeniaeguahe/panel_opening

    To open admissions (panel_inbox::opening()), at the head of the inbox while something is missing: six steps as
    slips of the desk, each with its number, what it is and why. A step done carries the ink stamp «Done»; the next one
    to do, its button; the rest, a link. Under them, the sheet of the office, to print.

    Example context (json):
    {
        "title": "Para abrir las admisiones", "count": "2 de 6",
        "steps": [{"n": 1, "key": "offer", "name": "La oferta y sus plazas", "why": "Lo que ven las familias al apuntarse.",
            "done": true, "url": "#", "go": "Ponerlo", "next": false},
            {"n": 2, "key": "team", "name": "Quién los recibe", "why": "Con su cara, en la página de cada familia.",
            "done": false, "url": "#", "go": "Ponerlo", "next": true}],
        "sheet": {"url": "#", "text": "La hoja de la secretaría, para imprimir"}
    }
}}
<section class="abrir-admisiones" aria-labelledby="abrir-t">
    <header class="abrir-cab"><h2 id="abrir-t">{{title}}</h2><span class="abrir-cuenta">{{count}}</span></header>
    <ol class="abrir-pasos">
        {{#steps}}
        <li class="abrir-paso{{#done}} hecho{{/done}}{{#next}} siguiente{{/next}}">
            <span class="abrir-n" aria-hidden="true">{{n}}</span>
            <span class="abrir-que"><b>{{name}}</b><span>{{why}}</span></span>
            {{#done}}<span class="abrir-sello">{{#str}}panel_opening_done, local_oksigeniaeguahe{{/str}}</span>{{/done}}
            {{^done}}<a class="{{#next}}boton principal pequeno{{/next}}{{^next}}enlace{{/next}}" href="{{url}}">{{go}}<span class="oculto"> · {{name}}</span></a>{{/done}}
        </li>
        {{/steps}}
    </ol>
    {{#sheet}}<p class="abrir-hoja"><a class="enlace" href="{{url}}">{{text}}</a></p>{{/sheet}}
</section>
