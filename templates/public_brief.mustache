{{!
    @template local_oksigeniaeguahe/public_brief

    The brief form inside the web of a centre: what is needed to answer, all of it in sight; and, once sent, two lines in
    the same place. What is wrong takes the place of the name of its field, so nothing moves.

    Example context (json):
    {
        "action": "#", "mark": "1", "trap": "web2", "self": false, "sent": false,
        "ask": {"name": "f7", "label": "¿Cómo quieren conocernos?", "error": false,
            "options": [{"id": "o0", "value": "Un día de clase", "label": "Un día de clase", "checked": true}]},
        "fields": [{"id": "b0", "name": "a0first", "label": "Su nombre", "value": "", "error": "", "type": "text", "autocomplete": "name", "inputmode": "", "ltr": false, "select": false, "last": false, "need": "nombre"},
            {"id": "b1", "name": "c0offer", "label": "Curso", "value": "", "error": "", "type": "text", "autocomplete": "off", "inputmode": "", "ltr": false, "last": true, "need": "",
                "select": {"none": "Aún no lo sabemos", "groups": [{"label": "Infantil", "options": [{"value": 3, "name": "Infantil 3 años", "selected": false}]}], "options": []} }],
        "arrival": [{"key": "src", "value": "chatgpt.com"}], "hint": "Basta con un teléfono o un correo.", "hinterror": false,
        "privacyurl": "#", "privacy": "Cómo tratamos sus datos", "send": "Enviar"
    }
}}
{{#sent}}
<div class="recibido" role="status">
    <svg class="sello" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="21"/><path d="M14.5 25l6.5 6.5L34 17.5"/></svg>
    <div><h1>{{title}}</h1>
    <p>{{text}}{{#url}} <a href="{{url}}" target="_blank" rel="noopener">{{more}}</a>{{/url}}</p></div>
</div>
{{/sent}}
{{^sent}}
<form method="post" action="{{action}}" novalidate>
    <input type="hidden" name="sesskey" value="{{mark}}"><input type="hidden" name="llegadasent" value="1">
    {{#arrival}}<input type="hidden" name="llegada{{key}}" value="{{value}}">{{/arrival}}
    {{#self}}<input type="hidden" name="para" value="yo">{{/self}}
    <div class="trampa" aria-hidden="true"><label for="trampa">Web</label><input id="trampa" name="{{trap}}" tabindex="-1" autocomplete="off"></div>
    {{#ask}}
    <fieldset class="opciones">
        <legend{{#error}} class="mal"{{/error}}>{{label}}</legend>
        {{#options}}<label for="{{id}}"><input type="radio" id="{{id}}" name="{{name}}" value="{{value}}"{{#checked}} checked{{/checked}}><span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{label}}</span></label>{{/options}}
    </fieldset>
    {{/ask}}
    <div class="campos">
        {{#fields}}
        <p class="campo{{#last}} ancho{{/last}}{{#select}} con-lista{{/select}}">
            {{#select}}<select id="{{id}}" name="{{name}}"{{#need}} data-hace-falta="{{need}}"{{/need}}{{#error}} aria-invalid="true"{{/error}}><option value="0">{{none}}</option>{{#groups}}<optgroup label="{{label}}">{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/options}}</optgroup>{{/groups}}{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/options}}</select>{{/select}}
            {{^select}}<input id="{{id}}" name="{{name}}" type="{{type}}" value="{{value}}" placeholder=" " autocomplete="{{autocomplete}}"{{#inputmode}} inputmode="{{inputmode}}"{{/inputmode}}{{#ltr}} dir="ltr"{{/ltr}}{{#need}} data-hace-falta="{{need}}"{{/need}}{{#error}} aria-invalid="true"{{/error}}>{{/select}}
            {{#error}}<label for="{{id}}" class="mal" data-nombre="{{label}}"><span class="oculto">{{label}}: </span>{{error}}</label>{{/error}}{{^error}}<label for="{{id}}">{{label}}</label>{{/error}}
            <svg class="listo" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11"/><path d="M7 12.5l3.4 3.4L17 9"/></svg>
        </p>
        {{/fields}}
    </div>
    <div class="pie">
        <p class="nota{{#hinterror}} mal{{/hinterror}}"{{#hinterror}} role="alert"{{/hinterror}}>{{hint}} <a href="{{privacyurl}}" target="_blank" rel="noopener">{{privacy}}</a></p>
        <button type="submit"><span>{{send}}</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg></button>
    </div>
</form>
{{/sent}}
