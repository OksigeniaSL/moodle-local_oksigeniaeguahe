{{!
    @template local_oksigeniaeguahe/centres

    The centres of the site: each with its team and who waits for an answer, and a new one.

    Example context (json):
    {"hascentres": true, "newurl": "#",
     "centres": [{"name": "Colegio de ejemplo", "url": "#", "settingsurl": "#", "members": 2, "waiting": 3}]}
}}
<div class="eguahe">
    <p><a class="btn btn-primary" href="{{newurl}}">{{#str}}centre_new, local_oksigeniaeguahe{{/str}}</a></p>
    {{#hascentres}}
    <table class="table eguahe-table">
        <thead><tr>
            <th scope="col">{{#str}}centre_name, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col" class="eguahe-num">{{#str}}centre_members, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col" class="eguahe-num">{{#str}}inbox_filter_waiting, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col"><span class="visually-hidden">{{#str}}settings{{/str}}</span></th>
        </tr></thead>
        <tbody>
        {{#centres}}
            <tr>
                <th scope="row"><a href="{{url}}">{{name}}</a></th>
                <td class="eguahe-num">{{members}}</td>
                <td class="eguahe-num">{{waiting}}</td>
                <td><a href="{{settingsurl}}">{{#str}}settings{{/str}}</a></td>
            </tr>
        {{/centres}}
        </tbody>
    </table>
    {{/hascentres}}
    {{^hascentres}}<div class="eguahe-empty"><p>{{#str}}centres_none, local_oksigeniaeguahe{{/str}}</p></div>{{/hascentres}}
</div>
