{{!
    @template local_oksigeniaeguahe/panel_familyform_adult

    The fields of one adult when writing down a family: name, surnames, mobile (with the warning of a family already
    written down under it) and email.

    Example context (json):
    {"i": 0, "id": 0, "required": true, "firstname": {"name": "firstname0", "value": "", "error": ""},
        "lastname": {"name": "lastname0", "value": "", "error": ""}, "phone": {"name": "phone0", "value": "", "error": ""},
        "email": {"name": "email0", "value": "", "error": ""} }
}}
<input type="hidden" name="adultid{{i}}" value="{{id}}">
<div class="rejilla-2 ap-lineas">
    {{#firstname}}<div class="campo"><label for="{{name}}">{{#str}}firstname{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" autocomplete="off"{{#required}} required{{/required}}{{#error}} aria-invalid="true" aria-describedby="{{name}}-e"{{/error}}>{{#error}}<span class="error" id="{{name}}-e">{{error}}</span>{{/error}}</div>{{/firstname}}
    {{#lastname}}<div class="campo"><label for="{{name}}">{{#str}}lastname{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" autocomplete="off"></div>{{/lastname}}
    {{#phone}}<div class="campo"><label for="{{name}}">{{#str}}panel_ff_mobile, local_oksigeniaeguahe{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" type="tel" inputmode="tel" dir="ltr" autocomplete="off" data-movil{{#error}} aria-invalid="true" aria-describedby="{{name}}-e"{{/error}}>{{#error}}<span class="error" id="{{name}}-e">{{error}}</span>{{/error}}</div>{{/phone}}
    {{#email}}<div class="campo"><label for="{{name}}">{{#str}}email{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" type="email" spellcheck="false" autocomplete="off"{{#error}} aria-invalid="true" aria-describedby="{{name}}-e"{{/error}}>{{#error}}<span class="error" id="{{name}}-e">{{error}}</span>{{/error}}</div>{{/email}}
</div>
<p class="duplicado" data-duplicado role="status" hidden></p>
