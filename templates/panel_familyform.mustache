{{!
    @template local_oksigeniaeguahe/panel_familyform

    Writing down a family (a call, the desk, the door of an open day), in the order of the call: who calls and their
    mobile first (a family already written down shows up while the number is typed), who would come, with the label
    being written at the side and, once a course is chosen, its rail in small; how they came and what they said; the
    rest only if it comes up, folded; and their permissions. At the end «Write them down» or «Write them down and
    propose a visit now». The Moodle form behind it checks and saves; this page only draws it.

    New in this round: dupurl, children[].emptybag, offersinfo. Kept: everything of 0.15.
    Review of 13 November 2026 (Jujol): gestures instead of form fields where the answer is chosen, not written. The
    names, the mobile and the email are written on lines; the course is a chip of the courses of the campaign, each with
    its free places (other school years folded); how they came, a chip; the act, the leaf of its day; the people who
    come, «−» and «+»; «Ha venido», a stamp; «Espera respuesta», the permissions and «Ya es familia del centro», lamps;
    how they heard of the centre and their language, chips. Every control keeps its name, so the Moodle form behind
    reads the same values. New: children[].offergroups, eventleaves, peoplecount.

    Example context (json):
    {
        "head": {"title": "Apuntar a una familia", "sub": "", "back": {"url": "#", "name": "Bandeja"}, "ante": "", "action": false},
        "i": {"atras": "", "info": ""}, "action": "#", "sesskey": "abc", "marker": "_qf__form", "centreid": 1, "id": 0, "isnew": true,
        "haserrors": false, "backurl": "#", "dupurl": "#",
        "adults": [{"i": 0, "id": 0, "open": true, "required": true,
            "firstname": {"name": "firstname0", "value": "", "error": ""}, "lastname": {"name": "lastname0", "value": "", "error": ""},
            "phone": {"name": "phone0", "value": "", "error": ""}, "email": {"name": "email0", "value": "", "error": ""} }],
        "children": [{"i": 0, "number": 1, "id": 0, "open": true, "offername": "offerid0", "emptybag": {"name": "", "style": ""},
            "name": {"name": "childname0", "value": "", "error": ""}, "tag": {"name": "childtag0", "value": "", "error": ""}, "birth": {"name": "childbirth0", "value": "", "error": "", "max": "2026-11-10",
                "date": {"id": "childbirth0", "first": "childbirth0d", "form": false, "child": false, "invalid": false,
                "labelled": true, "arialabel": false, "describedby": false, "mirror": false, "value": "",
                "parts": [{"key": "d", "id": "childbirth0d", "name": "childbirth0d", "label": "Día", "value": "", "size": 2, "months": false}]} },
            "offers": [{"value": 0, "name": "Sin decir", "selected": true}],
            "offergroups": [{"year": "2027-28", "campaign": true, "offers": [{"value": 0, "name": "Sin curso todavía", "free": "", "selected": true, "id": "o00"},
                {"value": 1, "name": "Infantil 3 años", "free": "19 libres", "selected": false, "id": "o01"}]}]}],
        "offersinfo": [{"value": 1, "free": "19 libres de 25", "next": "la próxima jornada, el sábado 21", "rail": ""}],
        "channels": [{"value": "phone", "name": "Teléfono", "selected": true}], "hasevents": true, "events": [],
        "eventleaves": [{"value": 0, "name": "A ninguna", "leaf": false, "selected": true},
            {"value": 3, "name": "Jornada de puertas abiertas", "leaf": {"weekday": "sáb", "day": "21", "month": "nov"}, "hour": "10:00", "selected": false}],
        "peoplecount": [{"value": 1, "selected": true, "prev": 1, "next": 2}, {"value": 2, "selected": false, "prev": 1, "next": 2}],
        "came": false, "people": "1", "body": "", "awaits": true, "places": [], "placeother": {"name": "municipalityother",
        "value": "", "error": ""}, "heard": [], "incentre": false, "langs": [], "consents": [{"name": "consentemail",
        "label": "Correo", "checked": false}]
    }
}}
<div class="pagina apuntar">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    <form class="formulario-panel tablilla" method="post" action="{{action}}" novalidate data-apuntar{{#dupurl}} data-duplicados="{{dupurl}}"{{/dupurl}}>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="{{marker}}" value="1">
        <input type="hidden" name="c" value="{{centreid}}">
        <input type="hidden" name="id" value="{{id}}">
        {{#haserrors}}<p class="aviso-suave error" role="alert">{{#str}}panel_ff_errors, local_oksigeniaeguahe{{/str}}</p>{{/haserrors}}

        <section class="apartado paso-llamada" aria-labelledby="ap-1">
            <header><span class="num-paso" aria-hidden="true">1</span><h2 id="ap-1">{{#str}}panel_ff_who_calls, local_oksigeniaeguahe{{/str}}</h2></header>
            {{#adults}}
            {{#required}}<div class="bloque-adulto">{{> local_oksigeniaeguahe/panel_familyform_adult }}</div>{{/required}}
            {{^required}}<details class="bloque-form"{{#open}} open{{/open}}><summary>{{#str}}form_adult2, local_oksigeniaeguahe{{/str}}</summary>{{> local_oksigeniaeguahe/panel_familyform_adult }}</details>{{/required}}
            {{/adults}}
        </section>

        <section class="apartado paso-llamada" aria-labelledby="ap-2">
            <header><span class="num-paso" aria-hidden="true">2</span><h2 id="ap-2">{{#str}}panel_ff_who_comes, local_oksigeniaeguahe{{/str}}</h2></header>
            {{#children}}
            <details class="bloque-form hijo-form"{{#open}} open{{/open}}>
                <summary>{{#str}}form_child, local_oksigeniaeguahe, {{number}}{{/str}}</summary>
                <input type="hidden" name="childid{{i}}" value="{{id}}">
                <div class="hijo-campos">
                    <div class="rejilla-2 ap-lineas">
                        {{#name}}<div class="campo"><label for="{{name}}">{{#str}}form_childname, local_oksigeniaeguahe{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" autocomplete="off" data-nombre-hijo="{{i}}"></div>{{/name}}
                        {{#tag}}<div class="campo"><label for="{{name}}">{{#str}}form_tagname, local_oksigeniaeguahe{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" autocomplete="off" data-etiqueta-hijo="{{i}}"><span class="ayuda">{{#str}}panel_ff_tag_help, local_oksigeniaeguahe{{/str}}</span></div>{{/tag}}
                        {{#birth}}<div class="campo"><label id="{{name}}-l" for="{{date.first}}">{{#str}}form_birthdate, local_oksigeniaeguahe{{/str}}</label>{{#date}}{{> local_oksigeniaeguahe/public_date }}{{/date}}{{#error}}<span class="error">{{error}}</span>{{/error}}<span class="ayuda">{{#str}}panel_ff_birth_help, local_oksigeniaeguahe{{/str}}</span></div>{{/birth}}
                        <fieldset class="campo ancho ap-cursos" data-curso-hijo="{{i}}">
                            <legend>{{#str}}offer, local_oksigeniaeguahe{{/str}}</legend>
                            {{#offergroups}}
                            {{#campaign}}<div class="ap-fichas">{{#offers}}<input class="oculto" type="radio" name="{{offername}}" id="{{offername}}-{{id}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-ficha{{#quiet}} ap-ficha-callada{{/quiet}}" for="{{offername}}-{{id}}"><b>{{name}}</b>{{#free}}<small>{{free}}</small>{{/free}}</label>{{/offers}}</div>{{/campaign}}
                            {{^campaign}}<details class="ap-otro-curso"><summary>{{#str}}panel_ff_course_other, local_oksigeniaeguahe, {{year}}{{/str}}</summary><div class="ap-fichas">{{#offers}}<input class="oculto" type="radio" name="{{offername}}" id="{{offername}}-{{id}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-ficha" for="{{offername}}-{{id}}"><b>{{name}}</b>{{#free}}<small>{{free}}</small>{{/free}}</label>{{/offers}}</div></details>{{/campaign}}
                            {{/offergroups}}
                            <div class="plazas-mini" data-plazas-mini="{{i}}" aria-live="polite"></div>
                        </fieldset>
                    </div>
                    <div class="etiqueta-viva" aria-hidden="true" data-etiqueta-viva="{{i}}">{{#emptybag}}{{> local_oksigeniaeguahe/panel_hanging }}{{/emptybag}}</div>
                </div>
            </details>
            {{/children}}
            <div hidden data-plazas-todas>{{#offersinfo}}<div class="plazas-uno" data-plazas-de="{{value}}">{{{rail}}}<p><b>{{free}}</b> · {{next}}</p></div>{{/offersinfo}}</div>
        </section>

        {{#isnew}}
        <section class="apartado paso-llamada" aria-labelledby="ap-3">
            <header><span class="num-paso" aria-hidden="true">3</span><h2 id="ap-3">{{#str}}form_how, local_oksigeniaeguahe{{/str}}</h2></header>
            <fieldset class="ap-grupo"><legend>{{#str}}channel, local_oksigeniaeguahe{{/str}}</legend>
                <div class="ap-fichas">{{#channels}}<input class="oculto" type="radio" name="channel" id="canal-{{value}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-ficha" for="canal-{{value}}"><b>{{name}}</b></label>{{/channels}}</div>
            </fieldset>
            {{#hasevents}}
            <fieldset class="ap-grupo"><legend>{{#str}}form_event, local_oksigeniaeguahe{{/str}}</legend>
                <div class="ap-hojas">{{#eventleaves}}<input class="oculto" type="radio" name="eventid" id="acto-{{value}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-hoja{{^leaf}} ap-hoja-nada{{/leaf}}" for="acto-{{value}}">{{#leaf}}<span class="hoja-cal" aria-hidden="true"><small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span></span>{{/leaf}}<span class="ap-hoja-que"><b>{{name}}</b>{{#hour}}<small>{{hour}}</small>{{/hour}}</span></label>{{/eventleaves}}</div>
            </fieldset>
            <div class="ap-fila">
                <fieldset class="ap-grupo ap-contador"><legend>{{#str}}panel_ff_people, local_oksigeniaeguahe{{/str}}</legend>
                    {{#peoplecount}}<input class="oculto" type="radio" name="people" id="gente-{{value}}" value="{{value}}"{{#selected}} checked{{/selected}}><span class="ap-cuenta"><label class="ap-signo" for="gente-{{prev}}" aria-hidden="true">−</label><b>{{value}}</b><label class="ap-signo" for="gente-{{next}}" aria-hidden="true">+</label></span>{{/peoplecount}}
                </fieldset>
                <label class="ap-sello"><input type="hidden" name="came" value="0"><input class="oculto" type="checkbox" name="came" value="1"{{#came}} checked{{/came}}><span>{{#str}}panel_ff_came, local_oksigeniaeguahe{{/str}}</span></label>
            </div>
            {{/hasevents}}
            <div class="campo ap-papel"><label for="body">{{#str}}form_said, local_oksigeniaeguahe{{/str}}</label><textarea id="body" name="body" rows="3">{{body}}</textarea></div>
            <label class="ap-luz"><input type="hidden" name="awaits" value="0"><input class="oculto" type="checkbox" name="awaits" value="1"{{#awaits}} checked{{/awaits}}><span class="ap-bombilla" aria-hidden="true"></span><span>{{#str}}form_awaits, local_oksigeniaeguahe{{/str}}</span></label>
        </section>
        {{/isnew}}

        <details class="apartado plegado paso-llamada">
            <summary><span class="num-paso" aria-hidden="true">4</span><h2>{{#str}}panel_ff_rest, local_oksigeniaeguahe{{/str}}</h2><span class="secundario">{{#str}}panel_ff_rest_help, local_oksigeniaeguahe{{/str}}</span></summary>
            <div class="rejilla-2">
                <div class="campo"><label for="municipality">{{#str}}panel_locality, local_oksigeniaeguahe{{/str}}</label><select id="municipality" name="municipality">{{#places}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/places}}</select></div>
                {{#placeother}}<div class="campo"><label for="{{name}}">{{#str}}form_place_other, local_oksigeniaeguahe{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}"></div>{{/placeother}}
                <fieldset class="ap-grupo ancho" data-cual-red="social"><legend>{{#str}}heardfrom, local_oksigeniaeguahe{{/str}}</legend>
                    <div class="ap-fichas">{{#heard}}<input class="oculto" type="radio" name="heardfrom" id="oyo-{{value}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-ficha" for="oyo-{{value}}"><b>{{name}}</b></label>{{/heard}}</div>
                </fieldset>
                {{#heardnet}}<div class="campo cual-red"{{^heardnetshown}} hidden{{/heardnetshown}}><label for="{{name}}">{{#str}}heardnet, local_oksigeniaeguahe{{/str}}</label><input id="{{name}}" name="{{name}}" value="{{value}}" list="redes" maxlength="60" autocomplete="off"><datalist id="redes">{{#networks}}<option value="{{name}}"></option>{{/networks}}</datalist></div>{{/heardnet}}
                <fieldset class="ap-grupo ancho"><legend>{{#str}}form_lang, local_oksigeniaeguahe{{/str}}</legend>
                    <div class="ap-fichas">{{#langs}}<input class="oculto" type="radio" name="lang" id="idioma-{{value}}" value="{{value}}"{{#selected}} checked{{/selected}}><label class="ap-ficha" for="idioma-{{value}}"><b>{{name}}</b></label>{{/langs}}</div>
                </fieldset>
                <label class="ap-luz ancho"><input type="hidden" name="incentre" value="0"><input class="oculto" type="checkbox" name="incentre" value="1"{{#incentre}} checked{{/incentre}}><span class="ap-bombilla" aria-hidden="true"></span><span>{{#str}}incentre, local_oksigeniaeguahe{{/str}}</span></label>
            </div>
        </details>

        {{#isnew}}
        <section class="apartado paso-llamada" aria-labelledby="ap-5">
            <header><span class="num-paso" aria-hidden="true">5</span><h2 id="ap-5">{{#str}}permissions, local_oksigeniaeguahe{{/str}}</h2></header>
            <p class="secundario">{{#str}}form_consent_help, local_oksigeniaeguahe{{/str}}</p>
            <div class="ap-luces">{{#consents}}<label class="ap-luz"><input type="hidden" name="{{name}}" value="0"><input class="oculto" type="checkbox" name="{{name}}" value="1"{{#checked}} checked{{/checked}}><span class="ap-bombilla" aria-hidden="true"></span><span>{{label}}</span></label>{{/consents}}</div>
        </section>
        {{/isnew}}

        <div class="acciones guardar-pie ap-pie">
            {{#isnew}}
            <button class="boton principal" type="submit" name="submitbutton" value="1">{{#str}}panel_ff_save, local_oksigeniaeguahe{{/str}}</button>
            <button class="boton secundario" type="submit" name="answernow" value="1">{{#str}}panel_ff_save_answer, local_oksigeniaeguahe{{/str}}</button>
            {{/isnew}}
            {{^isnew}}<button class="boton principal" type="submit" name="submitbutton" value="1">{{#str}}savechanges{{/str}}</button>{{/isnew}}
            <a class="boton terciario" href="{{backurl}}">{{#str}}cancel{{/str}}</a>
        </div>
    </form>
</div>
