{{!
    @template local_oksigeniaeguahe/panel_appt

    One appointment of a family, on its file: its day, what it is, how many come, what is known, and what can be done with it.

    Example context (json):
    {"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false, "peopletext": "2 personas", "year": "", "sesskey": "abc", "markurl": "#", "canact": true}
}}
<div class="su-cita su-cita-{{state}}" data-cita="{{id}}">
    <span class="su-cita-dia"{{#isasked}} aria-hidden="true"{{/isasked}}>{{#isasked}}<b>?</b>{{/isasked}}{{^isasked}}<small>{{wday}}</small><b>{{dnum}}</b><small>{{mon}}</small>{{#year}}<small>{{year}}</small>{{/year}}{{/isasked}}</span>
    <span class="su-cita-que"><b>{{#isasked}}{{#str}}agenda_asked_one, local_oksigeniaeguahe{{/str}}{{/isasked}}{{^isasked}}{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}}{{#acttitle}} · {{acttitle}}{{/acttitle}}{{/isasked}}</b><span class="secundario">{{place}}{{#guide}}{{#place}} · {{/place}}{{first}}{{/guide}}{{#sourcename}} {{sourcename}}{{/sourcename}}</span>{{^isasked}}<span class="su-cita-estado">{{statename}}{{#peopletext}}<span class="secundario"> · {{peopletext}}</span>{{/peopletext}}</span>{{/isasked}}
    {{#canact}}{{#isunknown}}<form class="cita-marcas" method="post" action="{{markurl}}" data-marca><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="mark"><input type="hidden" name="ids[]" value="{{id}}"><button type="submit" name="state" value="came">{{{i.check}}}<span>{{#str}}agenda_came, local_oksigeniaeguahe{{/str}}</span></button><button type="submit" name="state" value="notcame"><span>{{#str}}agenda_notcame, local_oksigeniaeguahe{{/str}}</span></button></form>{{/isunknown}}{{/canact}}</span>
    <span class="su-cita-mandos">{{#moveurl}}{{#isasked}}<a class="boton secundario pequeno" href="{{moveurl}}">{{#str}}agenda_giveday, local_oksigeniaeguahe{{/str}}</a>{{/isasked}}{{^isasked}}<a class="enlace" href="{{moveurl}}">{{#str}}agenda_change, local_oksigeniaeguahe{{/str}}</a>{{/isasked}}{{/moveurl}}</span>
</div>
