{{!
    @template local_oksigeniaeguahe/panel_event

    One event and its door, the flagship page. The band in the colour of the centre with how many came, in words; on a
    phone the band, the search and «Someone arrives without signing up» stay on top. Small, the wall of the turn of
    now: one knob per family, and the backpack of those that came. The families by their turn, the turn of now open;
    each child with the label of its name, its corner lifted; «Came» (52 px) sticks the label down and the row says
    «Came 10:41» (pressed again, it undoes). Without coverage the arrivals wait on the phone («3 to save») until the
    server takes them. At the side, what is shared: the QR, the link, the posters and the sheet of labels.

    New in this round: nowturn (with wall[came, name, style]), checkurl, checkevery, labelsurl, labelsname.
    Kept: everything of 0.15.
    Review of 13 November 2026: the two moments of an act. Before its day (before), the band says who is
    coming (families and people against the room), the list is «Who is coming», each family with «They are not
    coming», never «Came»; what is shared comes first, beside it. On the day (door), the door as before, and what is
    shared folds under one line. New: before, door, opens, signedsentence, signedpeople, signedpercent.

    Example context (json):
    {
        "invite": false,
        "i": {"atras": "", "buscar": "", "mas1": "", "check": "", "copiar": "", "imprimir": "", "lapiz": "", "chev": "", "etiqueta": "", "altavoz": ""},
        "back": {"url": "#", "name": "Jornadas y visitas"}, "band": "En la puerta · sábado 21 · 10:52", "name": "Jornada",
        "detail": "10:00 a 13:00 · Entrada", "counts": true, "came": 12, "households": 31, "past": false,
        "camesentence": "de 31 familias han venido", "peoplesentence": "30 de 87 personas", "percent": 34,
        "tailored": false, "hasrequests": false, "requests": [], "own": false, "family": "", "familyurl": "",
        "nowturn": {"wall": [{"came": true, "name": "Leo", "style": "--reposo:-3.5deg"}]},
        "checkurl": "#", "checkevery": 30,
        "hassignups": true, "groups": [{"title": "10:00 a 10:45", "now": true, "open": true, "count": "1 de 2 han venido", "families": "2 familias inscritas",
            "hassignups": true, "signups": [{"id": 1, "adults": "Marta Ruiz", "children": [{"drawingurl": "#", "hasdrawing": false, "tag": "Leo",
            "course": "Infantil 3 años"}], "people": "3 personas", "came": true, "cametext": "Vino 10:41", "url": "#",
            "search": "marta leo"}]}],
        "canact": true, "reloj": 36000, "addurl": "#", "action": "https://example.com/event.php", "sesskey": "abc", "qr": "", "qrfile": "Jornada de puertas abiertas", "link": "https://example.com/v",
        "posterurl": "#", "posterurla3": "#", "deskurl": "#", "embed": "<iframe></iframe>", "doorposter": "#", "doorpostera5": "#", "kiturl": false, "labelsurl": "#", "labelsname": "Las etiquetas del sábado", "doorsound": false,
        "kind": "Jornada de puertas abiertas", "capacity": "120 personas",
        "slots": "4 turnos", "questions": "", "open": true, "editurl": "#", "cancel": true, "letters": "Avisar también a las 12 familias que tienen la carta y no se han inscrito.", "cancelled": "",
        "before": false, "door": true, "opens": "", "signedsentence": "familias inscritas", "signedpeople": "87 de 120 personas", "signedpercent": 72
    }
}}
<div class="pagina puerta{{#past}} paso{{/past}}{{#before}} antes{{/before}}" data-puerta data-accion="{{action}}" data-sesskey="{{sesskey}}" data-reloj="{{reloj}}"{{#checkurl}} data-comprobar="{{checkurl}}" data-cada="{{checkevery}}"{{/checkurl}}>
    {{#back}}<nav class="migas" aria-label="{{#str}}panel_crumbs, local_oksigeniaeguahe{{/str}}"><a href="{{url}}">{{{i.atras}}}{{name}}</a></nav>{{/back}}
    <section class="banda" aria-labelledby="acto-t">
        <span class="etiqueta-b">{{band}}</span>
        <div class="banda-texto"><h1 class="acto-n" id="acto-t" tabindex="-1">{{name}}</h1>{{#detail}}<p class="detalle">{{detail}}</p>{{/detail}}</div>
        {{#counts}}
        {{#before}}
        <div class="cuentas-banda">
            <p class="cuenta-grande"><b>{{households}}</b> <span>{{signedsentence}}</span></p>
            <span class="personas">{{signedpeople}}</span>
            <span class="barra-b" aria-hidden="true"><i style="width:{{signedpercent}}%"></i></span>
        </div>
        {{/before}}
        {{^before}}
        <div class="cuentas-banda">
            <p class="cuenta-grande" aria-live="polite"><b data-vinieron>{{came}}</b> <span>{{camesentence}}</span></p>
            <span class="personas" data-personas>{{peoplesentence}}</span>
            <span class="barra-b" aria-hidden="true"><i style="width:{{percent}}%" data-barra-personas></i></span>
            <p class="por-guardar" data-por-guardar role="status" hidden></p>
        </div>
        {{/before}}
        {{/counts}}
    </section>
    {{#fresh}}
    <section class="acto-recien" aria-labelledby="recien-t">
        <h2 id="recien-t">{{#str}}panel_fresh_title, local_oksigeniaeguahe{{/str}}</h2>
        <div class="acto-pasos">
            {{#invite}}<a class="acto-paso" href="{{invite}}">{{{i.correo}}}<span><b>{{#str}}panel_invite_go, local_oksigeniaeguahe{{/str}}</b><span class="secundario">{{#str}}panel_fresh_invite, local_oksigeniaeguahe{{/str}}</span></span></a>{{/invite}}
            <a class="acto-paso" href="{{share}}">{{{i.enlace}}}<span><b>{{#str}}panel_to_share, local_oksigeniaeguahe{{/str}}</b><span class="secundario">{{#str}}panel_fresh_share, local_oksigeniaeguahe{{/str}}</span></span></a>
            <a class="acto-paso" href="{{poster}}" target="_blank" rel="noopener">{{{i.imprimir}}}<span><b>{{#str}}panel_fresh_poster, local_oksigeniaeguahe{{/str}}</b><span class="secundario">{{#str}}panel_fresh_poster_sub, local_oksigeniaeguahe{{/str}}</span></span></a>
            <a class="acto-paso" href="{{edit}}">{{{i.lapiz}}}<span><b>{{#str}}panel_change_event, local_oksigeniaeguahe{{/str}}</b><span class="secundario">{{#str}}panel_fresh_edit, local_oksigeniaeguahe{{/str}}</span></span></a>
        </div>
    </section>
    {{/fresh}}
    {{#topass}}<p class="agenda-nota"><span>{{text}}</span><a class="boton secundario pequeno" href="{{url}}">{{#str}}agenda_pass, local_oksigeniaeguahe{{/str}}</a></p>{{/topass}}
    {{#howitwent}}{{> local_oksigeniaeguahe/panel_howitwent }}{{/howitwent}}
    {{#nowturn}}
    <div class="pared-turno" aria-hidden="true" data-pared-turno>
        <div class="riel"></div>
        <div class="pomos">{{#wall}}<span class="pomo-t{{#came}} con-mochila{{/came}}" data-pomo-de="{{name}}">{{> local_oksigeniaeguahe/panel_hanging }}</span>{{/wall}}</div>
    </div>
    {{/nowturn}}
    <div class="puerta-cuerpo">
        {{#doorsound}}<audio data-sonido-puerta preload="auto"><source src="{{.}}.ogg" type="audio/ogg"><source src="{{.}}.mp3" type="audio/mpeg"></audio>{{/doorsound}}
        <section class="llegadas" aria-label="{{#str}}panel_at_door_list, local_oksigeniaeguahe{{/str}}">
            {{#own}}<p class="aviso-suave">{{#str}}panel_visit_of, local_oksigeniaeguahe{{/str}} <a href="{{familyurl}}">{{family}}</a></p>{{/own}}
            {{#tailored}}
            {{#requests}}
            <a class="medida" href="{{url}}">
                <span class="quien"><b>{{adults}}</b>{{#tag}} <span class="etq" translate="no" dir="auto">{{tag}}</span>{{/tag}}<span class="secundario">{{suits}}</span></span>
                <span class="estado">{{state}}</span>
            </a>
            {{/requests}}
            {{^hasrequests}}<p class="secundario">{{#str}}panel_events_no_requests, local_oksigeniaeguahe{{/str}}</p>{{/hasrequests}}
            {{/tailored}}
            {{^tailored}}
            {{#before}}<p class="se-abre">{{opens}}</p>{{#invite}}{{#url}}<a class="boton secundario invitar-cerca" href="{{url}}">{{{i.correo}}}{{#str}}panel_invite_go, local_oksigeniaeguahe{{/str}}</a>{{/url}}{{/invite}}<h2 class="quien-viene">{{#str}}panel_before_who, local_oksigeniaeguahe{{/str}}</h2>{{/before}}
            <div class="buscar-puerta">
                <label class="buscar"><span class="oculto">{{#str}}panel_door_search_label, local_oksigeniaeguahe{{/str}}</span>{{{i.buscar}}}<input type="search" data-filtrar=".llegada" data-tecla="/" data-tecla-que="{{#str}}panel_door_search_label, local_oksigeniaeguahe{{/str}}" placeholder="{{#str}}panel_door_search, local_oksigeniaeguahe{{/str}}" spellcheck="false" autocomplete="off"></label>
                {{#addurl}}{{^before}}<a class="boton principal en-ancho" href="{{addurl}}" data-tecla="a" data-tecla-que="{{#str}}panel_walk_in, local_oksigeniaeguahe{{/str}}">{{{i.mas1}}}<span class="largo">{{#str}}panel_walk_in, local_oksigeniaeguahe{{/str}}</span><span class="corto-b">{{#str}}panel_walk_in_short, local_oksigeniaeguahe{{/str}}</span></a>{{/before}}{{#before}}<a class="boton secundario en-ancho" href="{{addurl}}">{{{i.mas1}}}<span>{{#str}}household_new, local_oksigeniaeguahe{{/str}}</span></a>{{/before}}{{/addurl}}
            </div>
            {{#groups}}
            <details class="turno-p{{#now}} ahora-t{{/now}}"{{#open}} open{{/open}}>
                <summary>{{#title}}<span class="hora">{{title}}</span>{{/title}}{{#now}}<span class="ahora">{{#str}}panel_now, local_oksigeniaeguahe{{/str}}</span>{{/now}}<span class="cuantos">{{^before}}<span data-cuenta-turno>{{count}}</span>{{/before}}{{#before}}<span>{{families}}</span>{{/before}}{{{i.chev}}}</span></summary>
                {{#signups}}
                <div class="llegada{{#came}} ya{{/came}}" id="s{{id}}" data-buscar="{{search}}" data-llegada="{{id}}">
                    <div class="quien"><b><a href="{{url}}">{{adults}}</a></b>{{#aside}} <span class="aparte-acto">{{aside}}</span>{{/aside}}<span class="ninos-l">{{#children}}<span class="nino"><span class="etq etq-puerta" translate="no" dir="auto">{{tag}}</span><span class="curso">{{course}}</span>{{#drawingurl}}<a class="enlace su-dibujo" href="{{drawingurl}}">{{#hasdrawing}}{{#str}}panel_drawing_has, local_oksigeniaeguahe{{/str}}{{/hasdrawing}}{{^hasdrawing}}{{#str}}panel_drawing_link, local_oksigeniaeguahe{{/str}}{{/hasdrawing}}</a>{{/drawingurl}}</span>{{/children}}</span><span class="personas">{{people}}</span></div>
                    {{#canact}}
                    {{^before}}
                    <form method="post" action="{{action}}#s{{id}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="signup" value="{{id}}"><input type="hidden" name="came" value="{{^came}}1{{/came}}{{#came}}0{{/came}}">
                        <button class="vino" type="submit" aria-pressed="{{#came}}true{{/came}}{{^came}}false{{/came}}" aria-label="{{adults}}: {{cametext}}">{{{i.check}}}<span>{{cametext}}</span></button>
                    </form>
                    {{/before}}
                    {{^came}}<form class="quitar-inscripcion" method="post" action="{{action}}#s{{id}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="unsign"><input type="hidden" name="signup" value="{{id}}">
                        <button class="enlace" type="submit">{{#str}}event_unsign, local_oksigeniaeguahe{{/str}}</button>
                    </form>{{/came}}
                    {{/canact}}
                </div>
                {{/signups}}
                {{^hassignups}}<p class="secundario">{{#str}}panel_nobody_yet, local_oksigeniaeguahe{{/str}}</p>{{/hassignups}}
            </details>
            {{/groups}}
            {{^hassignups}}<p class="secundario">{{#str}}panel_nobody_yet, local_oksigeniaeguahe{{/str}}</p>{{/hassignups}}
            <p class="secundario sin-resultados" hidden>{{#str}}panel_search_none, local_oksigeniaeguahe{{/str}}</p>
            {{^before}}<button class="sonido" type="button" data-sonido aria-pressed="false" hidden>{{{i.altavoz}}}<span>{{#str}}panel_door_sound, local_oksigeniaeguahe{{/str}}</span></button>{{/before}}
            {{/tailored}}
        </section>
        <aside class="compartir-acto">
            {{#invite}}
            <section class="bloque invitar-acto" id="invitar">
                <h2>{{#str}}panel_invite_title, local_oksigeniaeguahe{{/str}}</h2>
                <p>{{text}}</p>
                {{#done}}<p class="secundario">{{done}}</p>{{/done}}
                {{#hastally}}<ul class="carta-cuenta">{{#tally}}<li class="carta-{{key}}"><b>{{n}}</b> {{label}}</li>{{/tally}}</ul>{{/hastally}}
                {{> local_oksigeniaeguahe/panel_invite_state }}
                {{#replies}}{{> local_oksigeniaeguahe/panel_replies }}{{/replies}}
                {{#url}}<div><a class="boton principal" href="{{url}}">{{{i.correo}}}{{#str}}panel_invite_prepare, local_oksigeniaeguahe{{/str}}</a></div>{{/url}}
            </section>
            {{/invite}}
            {{^own}}
            <details class="bloque compartir-plegable" id="compartir"{{^door}} open{{/door}}>
                <summary><h2>{{#str}}panel_to_share, local_oksigeniaeguahe{{/str}}</h2>{{{i.chev}}}</summary>
                {{#linkout}}
                <div class="qr-caja" data-qr><span class="qr">{{{qr}}}</span><div class="qr-texto"><span class="corto" dir="ltr">{{link}}</span><span class="secundario">{{#str}}panel_share_help, local_oksigeniaeguahe{{/str}}</span><button class="enlace" type="button" data-copiar="{{link}}" hidden>{{{i.copiar}}}{{#str}}panel_copy_link, local_oksigeniaeguahe{{/str}}</button><span class="qr-bajar"><button class="boton secundario pequeno" type="button" data-qr-bajar="png" data-nombre="{{qrfile}}" hidden>{{{i.bajar}}}{{#str}}panel_qr_picture, local_oksigeniaeguahe{{/str}}</button><button class="enlace" type="button" data-qr-bajar="svg" data-nombre="{{qrfile}}" hidden>{{#str}}panel_qr_print, local_oksigeniaeguahe{{/str}}</button></span></div></div>
                {{/linkout}}
                {{^linkout}}
                <p>{{#str}}panel_nolink, local_oksigeniaeguahe{{/str}}</p>
                {{/linkout}}
                {{#linkmay}}<form class="sin-enlace" method="post" action="{{posturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="linkout"><button class="interruptor" type="submit" name="linkout" value="{{#linkout}}0{{/linkout}}{{^linkout}}1{{/linkout}}" aria-pressed="{{#linkout}}true{{/linkout}}{{^linkout}}false{{/linkout}}"><span class="lampara" aria-hidden="true"></span><span>{{#str}}panel_link_offer, local_oksigeniaeguahe{{/str}}</span></button><span class="secundario">{{#str}}panel_link_what, local_oksigeniaeguahe{{/str}}</span></form>{{/linkmay}}
                {{^tailored}}
                <div class="cabeza-acciones">
                    <a class="boton secundario pequeno" href="{{posterurl}}" target="_blank" rel="noopener">{{{i.imprimir}}}{{#str}}panel_poster_a4, local_oksigeniaeguahe{{/str}}</a>
                    <a class="boton secundario pequeno" href="{{posterurla3}}" target="_blank" rel="noopener">{{{i.imprimir}}}{{#str}}panel_poster_a3, local_oksigeniaeguahe{{/str}}</a>
                    {{#labelsurl}}<a class="boton secundario pequeno" href="{{labelsurl}}" target="_blank" rel="noopener">{{{i.etiqueta}}}{{labelsname}}</a>{{/labelsurl}}
                    {{#kiturl}}<a class="boton secundario pequeno" href="{{kiturl}}">{{#str}}kit_title, local_oksigeniaeguahe{{/str}}</a>{{/kiturl}}
                </div>
                {{#deskurl}}
                <div class="puesto-acto">
                    <a class="boton secundario pequeno" href="{{deskurl}}" target="_blank" rel="noopener">{{#str}}desk_open, local_oksigeniaeguahe{{/str}}</a>
                    <p class="secundario">{{#str}}desk_open_help, local_oksigeniaeguahe{{/str}}</p>
                    {{#doorposter}}<p class="cabeza-acciones"><a class="boton secundario pequeno" href="{{doorposter}}" target="_blank" rel="noopener">{{{i.imprimir}}}{{#str}}panel_poster_door, local_oksigeniaeguahe{{/str}}</a> <a class="boton secundario pequeno" href="{{doorpostera5}}" target="_blank" rel="noopener">{{{i.imprimir}}}{{#str}}panel_poster_door_a5, local_oksigeniaeguahe{{/str}}</a></p>{{/doorposter}}
                </div>
                {{/deskurl}}
                {{#embed}}
                <div class="campo codigo-web codigo-acto"><label for="codigo-acto">{{{i.codigo}}}{{#str}}event_embed, local_oksigeniaeguahe{{/str}}</label><textarea id="codigo-acto" readonly rows="4" spellcheck="false" dir="ltr">{{embed}}</textarea><span class="ayuda">{{#str}}event_embed_help, local_oksigeniaeguahe{{/str}}</span>
                    <button class="boton terciario pequeno" type="button" data-copiar="{{embed}}" hidden>{{{i.copiar}}}{{#str}}panel_copy_code, local_oksigeniaeguahe{{/str}}</button></div>
                {{/embed}}
                {{/tailored}}
            </details>
            {{/own}}
            <section class="bloque">
                <h2>{{#str}}panel_the_event, local_oksigeniaeguahe{{/str}}</h2>
                {{#told}}{{#any}}
                <div class="acto-dicho">
                    {{#poster}}<a class="acto-dicho-cartel" href="{{url}}" target="_blank" rel="noopener"><img src="{{url}}" alt="{{alt}}" width="{{w}}" height="{{h}}" loading="lazy"></a>{{/poster}}
                    <div>
                        {{#about}}<p class="acto-dicho-va">{{about}}</p>{{/about}}
                        {{#speakers}}<p><b>{{name}}</b>{{#role}} <span class="secundario">{{role}}</span>{{/role}}</p>{{/speakers}}
                        {{#audience}}<p class="secundario">{{audience}}</p>{{/audience}}
                        {{#free}}<p><b>{{freetext}}</b></p>{{/free}}
                    </div>
                </div>
                {{/any}}{{/told}}
                <div class="lista-simple">
                    <div class="fila-s"><span>{{#str}}panel_kind, local_oksigeniaeguahe{{/str}}</span><b>{{kind}}</b></div>
                    {{#capacity}}<div class="fila-s"><span>{{#str}}panel_capacity, local_oksigeniaeguahe{{/str}}</span><b>{{capacity}}</b></div>{{/capacity}}
                    {{#slots}}<div class="fila-s"><span>{{#str}}panel_turns, local_oksigeniaeguahe{{/str}}</span><b>{{slots}}</b></div>{{/slots}}
                    {{#questions}}<div class="fila-s"><span>{{#str}}panel_questions, local_oksigeniaeguahe{{/str}}</span><b>{{questions}}</b></div>{{/questions}}
                    <div class="fila-s"><span>{{#str}}panel_signup, local_oksigeniaeguahe{{/str}}</span><b>{{#open}}{{#str}}panel_open, local_oksigeniaeguahe{{/str}}{{/open}}{{^open}}{{#str}}panel_closed, local_oksigeniaeguahe{{/str}}{{/open}}</b></div>
                </div>
                {{#editurl}}<div><a class="boton secundario pequeno" href="{{editurl}}">{{{i.lapiz}}}{{#str}}panel_change_event, local_oksigeniaeguahe{{/str}}</a></div>{{/editurl}}
                {{#cancelled}}<p class="secundario">{{cancelled}}</p>{{/cancelled}}
                {{#cancel}}
                <details class="anular-acto">
                    <summary class="enlace">{{#str}}event_cancel, local_oksigeniaeguahe{{/str}}</summary>
                    <form method="post" action="{{action}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="cancel">
                        <p>{{#str}}event_cancel_help, local_oksigeniaeguahe{{/str}}</p>
                        <div class="campo"><label for="anular-mensaje">{{#str}}event_cancel_message, local_oksigeniaeguahe{{/str}}</label><textarea id="anular-mensaje" name="message" rows="3" maxlength="2000"></textarea></div>
                        {{#letters}}<label class="casilla"><input type="checkbox" name="letters" value="1" checked> <span>{{letters}}</span></label>{{/letters}}
                        <button class="boton secundario pequeno" type="submit">{{#str}}event_cancel_do, local_oksigeniaeguahe{{/str}}</button>
                    </form>
                </details>
                {{/cancel}}
            </section>
        </aside>
    </div>
</div>
