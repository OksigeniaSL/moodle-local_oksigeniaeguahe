{{!
    @template local_oksigeniaeguahe/import

    What a centre imported, with the way to remove each one; and, for a file just given, what Eguahe makes of each of
    its sheets: what it is, what stays, what becomes a key and what is removed on the way in.

    Example context (json):
    {"tabs": [], "hasimports": true, "preview": true, "filename": "Campaña.xlsx", "draft": 123, "sesskey": "abc",
     "action": "#",
     "imports": [{"label": "Captación 26/27", "kind": "Contactos de una campaña", "rows": 528,
        "file": "Campaña.xlsx · Hoja 1", "when": "07/11/26, 18:00", "deleteurl": "#"}],
     "sheets": [{"index": 0, "name": "Hoja 1", "rows": 528, "none": false, "label": "Captación 26/27",
        "schoolyear": "", "kinds": [{"value": "contacts", "name": "Contactos de una campaña", "selected": true}],
        "haskept": true, "kept": "created_time · platform", "haskeys": true, "keys": "E-mail · Teléfono",
        "hasremoved": true, "removed": "Nombre y apellidos", "health": false}]}
}}
<div class="eguahe eguahe-import">
    {{> local_oksigeniaeguahe/tabs }}
    {{#preview}}
    <form method="post" action="{{action}}" class="eguahe-preview">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="draft" value="{{draft}}">
        <h3>{{filename}}</h3>
        <p class="eguahe-quiet">{{#str}}import_preview_intro, local_oksigeniaeguahe{{/str}}</p>
        {{#sheets}}
        <section class="eguahe-box eguahe-sheet{{#none}} eguahe-sheet-out{{/none}}">
            <h4>{{name}} <span class="eguahe-quiet">· {{#str}}import_rowsn, local_oksigeniaeguahe, {{rows}}{{/str}}</span></h4>
            <div class="eguahe-fields">
                <label>{{#str}}import_kind, local_oksigeniaeguahe{{/str}}
                    <select class="form-select custom-select" name="kind[{{index}}]">{{#kinds}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/kinds}}</select>
                </label>
                <label>{{#str}}import_label, local_oksigeniaeguahe{{/str}}
                    <input class="form-control" type="text" name="label[{{index}}]" value="{{label}}" maxlength="100">
                </label>
                <label>{{#str}}import_schoolyear, local_oksigeniaeguahe{{/str}}
                    <input class="form-control eguahe-money" type="text" name="schoolyear[{{index}}]" value="{{schoolyear}}" maxlength="9">
                </label>
            </div>
            {{#none}}<p class="eguahe-quiet">{{#str}}import_sheet_out, local_oksigeniaeguahe{{/str}}</p>{{/none}}
            {{^none}}
            <dl class="eguahe-fates">
                {{#haskept}}<dt>{{#str}}import_fate_kept, local_oksigeniaeguahe{{/str}}</dt><dd>{{kept}}</dd>{{/haskept}}
                {{#haskeys}}<dt>{{#str}}import_fate_key, local_oksigeniaeguahe{{/str}}</dt><dd>{{keys}}</dd>{{/haskeys}}
                {{#hasremoved}}<dt>{{#str}}import_fate_removed, local_oksigeniaeguahe{{/str}}</dt><dd>{{removed}}</dd>{{/hasremoved}}
            </dl>
            {{#health}}<p class="eguahe-quiet">{{#str}}import_health, local_oksigeniaeguahe{{/str}}</p>{{/health}}
            {{/none}}
        </section>
        {{/sheets}}
        <div class="eguahe-actions">
            <button type="submit" name="action" value="import" class="btn btn-primary">{{#str}}import_go, local_oksigeniaeguahe{{/str}}</button>
            <button type="submit" name="action" value="refresh" class="btn btn-secondary">{{#str}}import_refresh, local_oksigeniaeguahe{{/str}}</button>
            <button type="submit" name="action" value="cancel" class="btn btn-link">{{#str}}import_cancel, local_oksigeniaeguahe{{/str}}</button>
        </div>
    </form>
    {{/preview}}
    {{#hasimports}}
    <h3>{{#str}}import_done_list, local_oksigeniaeguahe{{/str}}</h3>
    <table class="table eguahe-table">
        <thead><tr>
            <th scope="col">{{#str}}import_label, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col">{{#str}}import_kind, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col" class="eguahe-num">{{#str}}import_rows, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col">{{#str}}import_file, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col"><span class="visually-hidden">{{#str}}delete{{/str}}</span></th>
        </tr></thead>
        <tbody>
        {{#imports}}
            <tr>
                <th scope="row">{{label}}</th>
                <td>{{kind}}</td>
                <td class="eguahe-num">{{rows}}</td>
                <td><span class="eguahe-quiet">{{file}} · {{when}}</span></td>
                <td><a class="eguahe-danger-link" href="{{deleteurl}}">{{#str}}import_delete, local_oksigeniaeguahe{{/str}}</a></td>
            </tr>
        {{/imports}}
        </tbody>
    </table>
    {{/hasimports}}
</div>
