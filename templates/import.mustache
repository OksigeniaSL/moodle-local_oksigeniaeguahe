{{!
    @template local_oksigeniaeguahe/import

    What a centre imported, with the way to remove each one, and the errors of a file that was refused.

    Example context (json):
    {"tabs": [], "hasimports": true, "haserrors": true,
     "imports": [{"label": "2025-26", "kind": "Contactos de una campaña", "rows": 831, "file": "contactos.csv",
        "when": "07/11/26, 18:00", "deleteurl": "#"}],
     "errors": [{"line": 12, "message": "La columna «source_detail» parece llevar un correo o un teléfono."}]}
}}
<div class="eguahe">
    {{> local_oksigeniaeguahe/tabs }}
    {{#haserrors}}
    <div class="alert alert-danger" role="alert">
        <p><strong>{{#str}}import_refused, local_oksigeniaeguahe{{/str}}</strong></p>
        <ul>{{#errors}}<li>{{#str}}import_line, local_oksigeniaeguahe, {{line}}{{/str}}: {{message}}</li>{{/errors}}</ul>
    </div>
    {{/haserrors}}
    {{#hasimports}}
    <table class="table eguahe-table">
        <thead><tr>
            <th scope="col">{{#str}}import_label, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col">{{#str}}import_kind, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col" class="eguahe-num">{{#str}}import_rows, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col">{{#str}}import_file, local_oksigeniaeguahe{{/str}}</th>
            <th scope="col"><span class="visually-hidden">{{#str}}delete{{/str}}</span></th>
        </tr></thead>
        <tbody>
        {{#imports}}
            <tr>
                <th scope="row">{{label}}</th>
                <td>{{kind}}</td>
                <td class="eguahe-num">{{rows}}</td>
                <td><span class="eguahe-quiet">{{file}} · {{when}}</span></td>
                <td><a class="eguahe-danger-link" href="{{deleteurl}}">{{#str}}import_delete, local_oksigeniaeguahe{{/str}}</a></td>
            </tr>
        {{/imports}}
        </tbody>
    </table>
    {{/hasimports}}
</div>
