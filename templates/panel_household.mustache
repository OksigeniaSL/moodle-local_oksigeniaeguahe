                        <div class="campo"><label for="se-van-linea">{{#str}}panel_leave_line, local_oksigeniaeguahe{{/str}}</label><input id="se-van-linea" name="note" maxlength="255" placeholder="{{#str}}panel_leave_line_example, local_oksigeniaeguahe{{/str}}"></div>
                        <button class="boton secundario pequeno" type="submit">{{#str}}panel_leave_save, local_oksigeniaeguahe{{/str}}</button>
                    </form>
                </details>
                {{/canact}}{{/gone}}
            </div>
            {{/leave}}
            {{#renewal}}
            <div class="sigue" id="sigue">
                <h3>{{title}}</h3>
                {{#rows}}
                <div class="sigue-nino" id="sigue-{{id}}">
                    <p class="sigue-quien"><span class="etq etq-puerta" translate="no" dir="auto">{{tag}}</span> <span class="secundario">{{next}}</span></p>
                    <p class="sigue-dicho">{{said}}</p>
                    {{#note}}<p class="sigue-nota" dir="auto">{{note}}</p>{{/note}}
                    {{#canact}}
                    <form class="sigue-botones" method="post" action="{{action}}#sigue-{{id}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="renewal"><input type="hidden" name="child" value="{{id}}">
                        {{#answers}}<button class="eleccion pequena" type="submit" name="answer" value="{{key}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/answers}}
                        {{#hasreasons}}<span class="sigue-motivos">{{#reasons}}<button class="ficha-boton" type="submit" name="reason" value="{{key}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/reasons}}</span>{{/hasreasons}}
                    </form>
                    {{/canact}}
