            {{^owner}}<span class="lleva-ficha nadie">{{#str}}panel_owner_none, local_oksigeniaeguahe{{/str}}</span>{{/owner}}
            {{#canact}}{{^ownedbyme}}
            <form class="en-linea" method="post" action="{{takeurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="boton terciario pequeno" type="submit" name="action" value="take">{{{i.mano}}}{{#str}}panel_take, local_oksigeniaeguahe{{/str}}</button></form>
            {{/ownedbyme}}{{/canact}}
            {{#promise}}
