                <p class="secundario">{{#str}}panel_family_same_help, local_oksigeniaeguahe{{/str}}</p>{{/canact}}{{/hashints}}
                {{#linked}}<p>{{linked}}</p>{{/linked}}
                {{#in}}<p class="secundario">{{in}}</p>{{/in}}
            </div>
            {{/family}}
            {{#leave}}
