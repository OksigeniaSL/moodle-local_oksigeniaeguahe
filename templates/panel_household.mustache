                        {{^drawing}}{{#drawingpage}}<a class="enlace su-dibujo" href="{{drawingpage}}">{{#str}}panel_drawing_link, local_oksigeniaeguahe{{/str}}</a>{{/drawingpage}}{{/drawing}}
                        {{^closed}}
                        <form class="camino" method="post" action="{{action}}" aria-label="{{label}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}">
                            {{#steps}}<button type="submit" name="stage" value="{{value}}" class="{{#done}}hecho{{/done}}{{#here}}aqui{{/here}}"{{#here}} aria-current="step"{{/here}}{{^canact}} disabled{{/canact}}>{{name}}</button>{{^last}}<span class="flecha" aria-hidden="true"></span>{{/last}}{{/steps}}
                        </form>
                        {{#incentre}}<p class="en-centro">{{{i.check}}}<span>{{incentre}}</span></p>{{/incentre}}
                        {{#canact}}
                        <div class="otros">
                            <form class="en-linea" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><button class="enlace" type="submit" name="stage" value="waitlist">{{#str}}stage_waitlist, local_oksigeniaeguahe{{/str}}</button></form>
                            <span aria-hidden="true">·</span>
                            <details class="cerrar-con-motivo">
                                <summary class="enlace">{{#str}}panel_close_with_reason, local_oksigeniaeguahe{{/str}}</summary>
                                <form method="post" action="{{action}}">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><input type="hidden" name="stage" value="closed">
                                    <div class="campo"><label for="motivo-{{id}}">{{#str}}panel_why_close, local_oksigeniaeguahe{{/str}}</label>
                                        <select id="motivo-{{id}}" name="reason">{{#reasons}}<option value="{{value}}">{{name}}</option>{{/reasons}}</select></div>
                                    <button class="boton secundario pequeno" type="submit">{{#str}}panel_close, local_oksigeniaeguahe{{/str}}</button>
                                </form>
                            </details>
                        </div>
                        {{/canact}}
                        {{/closed}}
                        {{#closed}}
                        <p class="cerrado">{{#str}}stage_closed, local_oksigeniaeguahe{{/str}}{{#reason}} · {{reason}}{{/reason}}</p>
                        {{#canact}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><button class="enlace" type="submit" name="stage" value="inquiry">{{#str}}panel_reopen, local_oksigeniaeguahe{{/str}}</button></form>{{/canact}}
