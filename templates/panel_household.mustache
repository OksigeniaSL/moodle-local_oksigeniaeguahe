                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="promisedone"><input type="hidden" name="promise" value="{{id}}">
                {{#who}}{{> local_oksigeniaeguahe/panel_face }}{{/who}}<span class="promesa-texto">{{text}}</span>
                <button class="boton secundario pequeno" type="submit">{{#str}}panel_promise_done, local_oksigeniaeguahe{{/str}}</button>
            </form>
            {{/promise}}
        </div>
        {{/relay}}
        <section class="pared-hijos" aria-label="{{#str}}panel_children, local_oksigeniaeguahe{{/str}}">
            <div class="riel" aria-hidden="true"></div>
            <div class="hijos-lista">
