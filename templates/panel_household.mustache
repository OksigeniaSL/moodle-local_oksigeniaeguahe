<div class="pagina ficha{{#waiting}} espera{{/waiting}}" data-hoja data-url="{{url}}">
    <div class="hoja-mandos">
        <a class="enlace" href="{{url}}" data-abrir-entera>{{{i.fuera}}}{{#str}}panel_open_whole, local_oksigeniaeguahe{{/str}}</a>
