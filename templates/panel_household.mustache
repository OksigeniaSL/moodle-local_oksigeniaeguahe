                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="propose"><input type="hidden" name="people" value="{{people}}">
                    <div class="rejilla-2">
                        <div class="campo"><label id="vd-l" for="{{datedate.first}}">{{#str}}panel_day, local_oksigeniaeguahe{{/str}}</label>{{#datedate}}{{> local_oksigeniaeguahe/public_date }}{{/datedate}}</div>
                        <div class="campo"><label for="vh">{{#str}}panel_hour, local_oksigeniaeguahe{{/str}}</label><input id="vh" type="{{#h24}}text{{/h24}}{{^h24}}time{{/h24}}"{{#h24}} inputmode="numeric" maxlength="5" placeholder="hh:mm" autocomplete="off"{{/h24}} name="time" value="17:30" required data-hora></div>
                        <div class="campo"><label for="vm">{{#str}}panel_length, local_oksigeniaeguahe{{/str}}</label><select id="vm" name="minutes">{{#minutes}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/minutes}}</select></div>
                        <div class="campo"><label for="vl">{{#str}}panel_where, local_oksigeniaeguahe{{/str}}</label><input id="vl" name="place" value="{{place}}"></div>
                        {{#hasguides}}<div class="campo ancho"><label for="vg">{{#str}}panel_guide, local_oksigeniaeguahe{{/str}}</label><select id="vg" name="guide">{{#guides}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/guides}}</select></div>{{/hasguides}}
                    </div>
                    <button class="boton secundario" type="submit">{{{i.actos}}}{{#str}}panel_propose, local_oksigeniaeguahe{{/str}}</button>
                    <p class="def">{{#str}}panel_propose_help, local_oksigeniaeguahe{{/str}}</p>
                </form>
                {{/canact}}
            </details>
            {{/visit}}
            {{#canact}}
            <section class="turno-tuyo{{^waiting}} ya{{/waiting}}" data-turno aria-labelledby="turno-t">
                    <div class="que">
                    <div class="turno-cab">
                        {{#me}}{{> local_oksigeniaeguahe/panel_face }}{{/me}}
                        <h2 class="turno-titulo" id="turno-t" data-turno-titulo>{{#waiting}}{{#str}}panel_your_turn, local_oksigeniaeguahe{{/str}}{{/waiting}}{{^waiting}}{{#str}}panel_answered_already, local_oksigeniaeguahe{{/str}}{{/waiting}}</h2>
                        {{#answered}}{{#stamp}}<span class="sello-grande" aria-hidden="true"><small>{{top}}</small><b>{{day}}</b><span>{{hour}}</span></span>{{/stamp}}{{/answered}}
                    </div>
                    {{#typing}}<p class="escribiendo">{{> local_oksigeniaeguahe/panel_face }}<span>{{#str}}panel_typing, local_oksigeniaeguahe, {{first}}{{/str}}</span></p>{{/typing}}
                    {{#ai}}{{#summary}}
                    <aside class="ia-resumen" aria-labelledby="ia-resumen-t">
                        <p class="ia-firma" id="ia-resumen-t"><span class="ia-marca" aria-hidden="true">{{{i.ia}}}</span><span>{{#str}}panel_ai_summary, local_oksigeniaeguahe, {{when}}{{/str}}</span></p>
                        <p class="ia-hechos">{{summary}}</p>
                    </aside>
                    {{/summary}}{{/ai}}
                    <form class="paso" id="contestar" method="post" action="{{action}}" data-canales="1" data-redactor{{#composer}} data-latido="{{typingurl}}"{{/composer}}>
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        {{#composer}}
                        {{#hassuggestions}}
                        <div class="ya-dijisteis" role="group" aria-labelledby="yd-t">
                            <span class="rotulo-p" id="yd-t">{{#str}}panel_said_before, local_oksigeniaeguahe{{/str}}</span>
                            {{#suggestions}}<button class="sugerencia" type="submit" name="use" value="{{id}}" data-texto="{{text}}"><b>{{title}}</b><span>{{uses}}</span></button>{{/suggestions}}
                        </div>
                        {{/hassuggestions}}
                        {{#draft}}
                        <details class="borrador">
                            <summary>{{#str}}panel_draft_of, local_oksigeniaeguahe, {"who": "{{who}}", "when": "{{when}}"}{{/str}}</summary>
                            <p>{{text}}</p>
                            <button class="enlace" type="submit" name="use" value="draft" data-texto="{{text}}">{{#str}}panel_draft_use, local_oksigeniaeguahe{{/str}}</button>
                        </details>
                        {{/draft}}
                        <div class="por" role="radiogroup" aria-label="{{#str}}panel_answer_by, local_oksigeniaeguahe{{/str}}">
                            <span>{{#str}}panel_by, local_oksigeniaeguahe{{/str}}</span>
                            {{#ways}}<input class="oculto" type="radio" name="channel" id="canal-{{value}}" value="{{value}}" data-boton="{{button}}"{{#checked}} checked{{/checked}}{{#disabled}} disabled{{/disabled}}><label class="ficha-canal" for="canal-{{value}}">{{{icon}}}{{name}}{{#why}} <span class="nota">· {{why}}</span>{{/why}}</label>{{/ways}}
                        </div>
                        {{#notes}}<p class="aviso-suave">{{{i.info}}}<span>{{.}}</span></p>{{/notes}}
                        <div class="campo{{#ai}}{{#drafted}} ia-escrito{{/drafted}}{{/ai}}"><label for="borrador">{{#str}}panel_what_you_say, local_oksigeniaeguahe{{/str}}</label>{{#ai}}{{#drafted}}<p class="ia-nota" id="ia-nota"><span class="ia-marca" aria-hidden="true">{{{i.ia}}}</span><span>{{#str}}panel_ai_drafted, local_oksigeniaeguahe{{/str}}</span></p>{{/drafted}}{{/ai}}<textarea id="borrador"{{#ai}}{{#drafted}} aria-describedby="ia-nota"{{/drafted}}{{/ai}} name="body" rows="7" data-tecla="r" data-tecla-que="{{#str}}panel_answer, local_oksigeniaeguahe{{/str}}">{{greeting}}</textarea><span class="ayuda">{{#str}}panel_what_you_say_help, local_oksigeniaeguahe{{/str}}</span></div>
                        {{#ai}}<button class="ia-borrador" type="submit" name="ia" value="1" formaction="{{action}}#contestar"><span class="ia-marca" aria-hidden="true">{{{i.ia}}}</span><span>{{#drafted}}{{#str}}panel_ai_draft_again, local_oksigeniaeguahe{{/str}}{{/drafted}}{{^drafted}}{{#str}}panel_ai_draft, local_oksigeniaeguahe{{/str}}{{/drafted}}</span></button>{{/ai}}
                                <label class="casilla guardar-respuesta"><input type="checkbox" name="savereply" value="1"> {{#str}}panel_keep_reply, local_oksigeniaeguahe{{/str}}</label>
                        {{#next}}
                        <div class="campo siguiente">
                            <label for="siguiente">{{#str}}panel_next, local_oksigeniaeguahe{{/str}} <span class="opcional">{{#str}}panel_optional, local_oksigeniaeguahe{{/str}}</span></label>
                            <div class="siguiente-fila"><input id="siguiente" name="next" value="{{next.value}}" placeholder="{{#str}}panel_next_example, local_oksigeniaeguahe{{/str}}" autocomplete="off">{{#next.date}}{{> local_oksigeniaeguahe/public_date }}{{/next.date}}</div>
                        </div>
                        {{/next}}
                        <div class="acciones">
                            <button class="boton principal" type="submit" name="action" value="send" data-enviar="1">{{{i.enviado}}}<span>{{button}}</span></button>
                            <button class="boton secundario" type="submit" name="action" value="answer" data-tecla="c" data-tecla-que="{{#str}}answer_save, local_oksigeniaeguahe{{/str}}" data-tecla-intro="1">{{{i.check}}}{{#str}}answer_save, local_oksigeniaeguahe{{/str}}</button>
                            <span class="separa-h"></span>
                            <button class="boton terciario pequeno" type="submit" name="action" value="received">{{#str}}panel_wrote_again, local_oksigeniaeguahe{{/str}}</button>
                            <button class="boton terciario pequeno" type="submit" name="action" value="note">{{{i.nota}}}{{#str}}panel_team_note, local_oksigeniaeguahe{{/str}}</button>
                        </div>
                        {{/composer}}
                    </form>
                    </div>
            </section>
            {{/canact}}
        </div>
        <div class="col col-lado">
            <section class="apartado">
                <header><h2>{{#str}}panel_who_writes, local_oksigeniaeguahe{{/str}}</h2>{{#canact}}<a class="enlace" href="{{editurl}}">{{{i.lapiz}}}{{#str}}panel_change, local_oksigeniaeguahe{{/str}}</a>{{/canact}}</header>
                <div class="adultos">
                    {{#adults}}
                    <div class="adulto"><b>{{name}}</b>
                        {{#ways}}<span class="linea-c">{{{icon}}}<span>{{text}} · <a href="{{href}}" dir="ltr">{{value}}</a></span></span>{{/ways}}
                        {{^hasways}}<span class="secundario">{{#str}}panel_no_contact, local_oksigeniaeguahe{{/str}}</span>{{/hasways}}
                        {{#likes}}<span class="le-gusta">{{.}}</span>{{/likes}}
                    </div>
                    {{/adults}}
                    <p class="secundario">{{lang}}</p>
                </div>
            </section>
            {{#hasabout}}
            <section class="apartado">
                <header><h2>{{#str}}panel_answers, local_oksigeniaeguahe{{/str}}</h2></header>
                {{#hasanswers}}<dl class="respuestas">{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>{{/hasanswers}}
                {{#hasuntold}}<p class="sin-contar"><b>{{#str}}panel_untold, local_oksigeniaeguahe{{/str}}</b> {{untoldtext}}. {{#str}}panel_untold_help, local_oksigeniaeguahe{{/str}}</p>{{/hasuntold}}
            </section>
            {{/hasabout}}
            {{#aftervisits}}
            <section class="apartado">
                <header><h2>{{title}}</h2></header>
                <dl class="respuestas">{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>
            </section>
            {{/aftervisits}}
            {{#seen}}
            <section class="apartado su-pagina">
                <header><h2>{{#str}}panel_facts_title, local_oksigeniaeguahe{{/str}}</h2></header>
                <ul class="hechos-pagina">{{#facts}}<li>{{.}}</li>{{/facts}}</ul>
                <p class="secundario">{{#str}}panel_facts_help, local_oksigeniaeguahe{{/str}}</p>
                {{#ambassador}}
                <form class="embajadora-ficha{{#is}} es{{/is}}" id="embajadora" method="post" action="{{action}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="{{do}}">
                    <span class="embajadora-ficha-sello" aria-hidden="true">{{{i.enviado}}}</span>
                    <p>{{text}}</p>
                    <button class="{{#is}}enlace{{/is}}{{^is}}boton secundario pequeno{{/is}}" type="submit">{{label}}</button>
                </form>
                {{/ambassador}}
            </section>
            {{/seen}}
            {{#hasevents}}
            <section class="apartado">
                <header><h2>{{#str}}panel_their_events, local_oksigeniaeguahe{{/str}}</h2></header>
                {{#events}}<p class="visita"><span class="hoja-cal"><small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span></span><span class="que"><b>{{hour}} · {{name}}</b><span class="secundario">{{people}}{{#came}} · {{#str}}panel_came_yes, local_oksigeniaeguahe{{/str}}{{/came}}</span></span></p>{{/events}}
            </section>
            {{/hasevents}}
            <details class="apartado plegado">
                <summary><h2>{{#str}}panel_their_page_and_data, local_oksigeniaeguahe{{/str}}</h2></summary>
                <p>{{#str}}panel_their_page_help, local_oksigeniaeguahe{{/str}}</p>
                {{#newlink}}<div class="campo"><label for="enlace-nuevo">{{#str}}familylink, local_oksigeniaeguahe{{/str}}</label><input id="enlace-nuevo" readonly value="{{newlink}}" spellcheck="false"></div>{{/newlink}}
                {{#canact}}
                <div class="cabeza-acciones">
                    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="boton terciario pequeno" type="submit" name="action" value="link">{{{i.enlace}}}{{#str}}panel_new_link, local_oksigeniaeguahe{{/str}}</button></form>
                    {{#mergeurl}}<a class="boton terciario pequeno" href="{{mergeurl}}">{{{i.fundir}}}{{#str}}panel_merge, local_oksigeniaeguahe{{/str}}</a>{{/mergeurl}}
                </div>
                <p class="secundario">{{#str}}panel_their_data_help, local_oksigeniaeguahe{{/str}}</p>
                <details class="confirmar">
                    <summary class="boton rojo pequeno">{{{i.borrar}}}{{#str}}panel_erase, local_oksigeniaeguahe{{/str}}</summary>
                    <form method="post" action="{{action}}">
                        <p><b>{{erasequestion}}</b></p>
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button class="boton peligro pequeno" type="submit" name="action" value="erase">{{#str}}erase_yes, local_oksigeniaeguahe{{/str}}</button>
                        <button class="boton secundario pequeno" type="button" data-cerrar="1">{{#str}}erase_no, local_oksigeniaeguahe{{/str}}</button>
                    </form>
                </details>
                {{/canact}}
            </details>
        </div>
    </div>
</div>
