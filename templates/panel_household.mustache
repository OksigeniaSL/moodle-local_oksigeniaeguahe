{{!
    @template local_oksigeniaeguahe/panel_household

    The file of a household, in one screen at 1366: since when it waits and who looks after them, the promise that is
    due; the children hanging on the wall, each with its way; the conversation, the old messages folded in one line and
    the last two in sight, and at the end «Your turn» with what the centre already said, the draft with its owner, the
    channel and «What comes next». At the side the proposal, in one sentence that starts with what holds it, and one
    button that writes the answer (it never sends by itself); who writes and how; what they answered and what they have
    not told yet; their events, their page and their data. The same page is the sheet beside the inbox: the script takes
    [data-hoja] from it, and the CSS folds the side under the conversation.

    New in this round: url, inboxurl, answered, owner, takeurl, ownedbyme, promise, typing, historyold, hasold, oldlabel,
    composer.greeting, composer.draft, composer.suggestions, composer.next, proposal, noproposal, untold, hasuntold,
    untoldtext, hasabout, mergeurl. Kept: everything of 0.15. Drawn only when they exist (Eguahe, 8 November 2026,
    until Enrique says yes to them): relay (who looks after the family and the promise), composer.next and mergeurl.

    Example context (json):
    {
        "i": {"atras": "", "check": "", "nota": "", "enviado": "", "enlace": "", "borrar": "", "actos": "", "lapiz": "",
            "persona": "", "sistema": "", "info": "", "mano": "", "fuera": "", "cerrar": "", "fundir": ""},
        "head": {"title": "Marta Ruiz y Daniel Ortega", "ante": "Espera respuesta desde el jueves a las 18:40",
            "sub": "Formulario de la web · desde el 5 de noviembre", "back": {"url": "#", "name": "Bandeja"}, "action": null},
        "url": "#", "inboxurl": "#", "action": "#", "sesskey": "abc", "canact": true, "waiting": true, "answered": null,
        "owner": {"first": "Lucía", "name": "Lucía Medina", "picture": "", "initials": "LM", "mine": false},
        "relay": true, "takeurl": "#", "ownedbyme": false, "promise": null, "typing": null,
        "children": [{"id": 1, "hanging": {"name": "Leo", "style": ""}, "name": "Leonardo", "tagline": "En su etiqueta: Leo",
            "course": "Infantil 3 años · curso 2027-28", "label": "Por dónde va Leo", "closed": false, "reason": "",
            "waitlist": false, "canact": true,
            "steps": [{"value": "inquiry", "name": "Consulta", "here": true, "done": false, "last": false}],
            "reasons": [{"value": "moved", "name": "Se ha mudado"}]}],
        "hasold": true, "oldlabel": "2 mensajes anteriores",
        "historyold": [{"family": true, "team": false, "system": false, "who": "La familia", "how": "llegó por la web", "when": "el jueves", "body": "«¿Tienen comedor?»"}],
        "history": [{"family": true, "team": false, "system": false, "who": "Daniel Ortega", "how": "escribió por WhatsApp", "when": "el viernes", "body": "«Mejor por la tarde.»"}],
        "me": {"name": "Andrés Rivas", "first": "Andrés", "picture": "", "initials": "AR"},
        "composer": {"button": "Mandarlo por WhatsApp", "notes": [], "greeting": "Hola, Marta y Daniel: ",
            "draft": {"who": "Lucía", "when": "hoy a las 10:31", "text": "Hola, Marta y Daniel: sí, hay comedor."},
            "hassuggestions": true, "suggestions": [{"id": "s1", "title": "Comedor en Infantil", "uses": "14 veces", "text": "Hola, Marta y Daniel: sí."}],
            "next": {"value": "", "day": ""},
            "ways": [{"value": "mobile", "name": "WhatsApp", "icon": "", "button": "Mandarlo por WhatsApp", "checked": true, "disabled": false, "why": ""}]},
        "proposal": {"sentence": "Proponerles el jueves 12 a las 17:30 con Lucía", "why": "pidieron tardes y Lucía está libre",
            "button": "Proponer y mandar", "url": "#", "text": "Hola, Marta y Daniel: el jueves 12 a las 17:30."},
        "noproposal": "",
        "adults": [{"name": "Marta Ruiz", "hasways": true, "ways": [{"icon": "", "text": "Por correo", "value": "marta@example.com", "href": "mailto:marta@example.com"}]}],
        "lang": "Hablan español.", "editurl": "#", "hasabout": true,
        "hasanswers": true, "answers": [{"label": "¿Tienen hermanos en el centro?", "value": "No"}],
        "hasuntold": true, "untold": ["dónde viven"], "untoldtext": "dónde viven",
        "visit": {"asked": "Una tarde", "date": "2026-11-12", "place": "", "people": 2, "hasguides": true,
            "guides": [{"id": 1, "name": "Lucía Medina", "selected": true}],
            "minutes": [{"value": 45, "name": "45 min", "selected": true}]},
        "hasevents": false, "events": [], "newlink": "", "mergeurl": "#", "erasequestion": "¿Borramos todo lo de Marta Ruiz?"
    }
}}
<div class="pagina ficha{{#waiting}} espera{{/waiting}}" data-hoja data-url="{{url}}">
    <div class="hoja-mandos">
        <a class="enlace" href="{{url}}" data-abrir-entera>{{{i.fuera}}}{{#str}}panel_open_whole, local_oksigeniaeguahe{{/str}}</a>
        <a class="boton terciario pequeno" href="{{inboxurl}}" data-cerrar-hoja>{{{i.cerrar}}}{{#str}}panel_close_sheet, local_oksigeniaeguahe{{/str}}</a>
    </div>
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    {{#relay}}
    <div class="relevo">
        {{#owner}}<span class="lleva-ficha">{{> local_oksigeniaeguahe/panel_face }}<span>{{#str}}panel_owner, local_oksigeniaeguahe, {{first}}{{/str}}</span></span>{{/owner}}
        {{^owner}}<span class="lleva-ficha nadie">{{#str}}panel_owner_none, local_oksigeniaeguahe{{/str}}</span>{{/owner}}
        {{#canact}}{{^ownedbyme}}
        <form class="en-linea" method="post" action="{{takeurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="boton terciario pequeno" type="submit" name="action" value="take">{{{i.mano}}}{{#str}}panel_take, local_oksigeniaeguahe{{/str}}</button></form>
        {{/ownedbyme}}{{/canact}}
        {{#promise}}
        <form class="promesa" method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="promisedone">
            {{#who}}{{> local_oksigeniaeguahe/panel_face }}{{/who}}<span class="promesa-texto">{{text}}</span>
            <button class="boton secundario pequeno" type="submit">{{#str}}panel_promise_done, local_oksigeniaeguahe{{/str}}</button>
        </form>
        {{/promise}}
    </div>
    {{/relay}}
    <section class="pared-hijos" aria-label="{{#str}}panel_children, local_oksigeniaeguahe{{/str}}">
        <div class="riel" aria-hidden="true"></div>
        <div class="hijos-lista">
            {{#children}}
            <div class="hijo">
                {{#hanging}}{{> local_oksigeniaeguahe/panel_hanging }}{{/hanging}}
                <div class="datos">
                    <span class="nombre">{{name}}</span>
                    <span class="secundario">{{#tagline}}{{tagline}} · {{/tagline}}{{course}}</span>
                    {{^closed}}
                    <form class="camino" method="post" action="{{action}}" aria-label="{{label}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}">
                        {{#steps}}<button type="submit" name="stage" value="{{value}}" class="{{#done}}hecho{{/done}}{{#here}}aqui{{/here}}"{{#here}} aria-current="step"{{/here}}{{^canact}} disabled{{/canact}}>{{name}}</button>{{^last}}<span class="flecha" aria-hidden="true"></span>{{/last}}{{/steps}}
                    </form>
                    {{#canact}}
                    <div class="otros">
                        <form class="en-linea" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><button class="enlace" type="submit" name="stage" value="waitlist">{{#str}}stage_waitlist, local_oksigeniaeguahe{{/str}}</button></form>
                        <span aria-hidden="true">·</span>
                        <details class="cerrar-con-motivo">
                            <summary class="enlace">{{#str}}panel_close_with_reason, local_oksigeniaeguahe{{/str}}</summary>
                            <form method="post" action="{{action}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><input type="hidden" name="stage" value="closed">
                                <div class="campo"><label for="motivo-{{id}}">{{#str}}panel_why_close, local_oksigeniaeguahe{{/str}}</label>
                                    <select id="motivo-{{id}}" name="reason">{{#reasons}}<option value="{{value}}">{{name}}</option>{{/reasons}}</select></div>
                                <button class="boton secundario pequeno" type="submit">{{#str}}panel_close, local_oksigeniaeguahe{{/str}}</button>
                            </form>
                        </details>
                    </div>
                    {{/canact}}
                    {{/closed}}
                    {{#closed}}
                    <p class="cerrado">{{#str}}stage_closed, local_oksigeniaeguahe{{/str}}{{#reason}} · {{reason}}{{/reason}}</p>
                    {{#canact}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="stage"><input type="hidden" name="child" value="{{id}}"><button class="enlace" type="submit" name="stage" value="inquiry">{{#str}}panel_reopen, local_oksigeniaeguahe{{/str}}</button></form>{{/canact}}
                    {{/closed}}
                </div>
            </div>
            {{/children}}
        </div>
    </section>
    <div class="ficha-cuerpo">
        <div class="col col-hilo">
            <section class="apartado conversacion" aria-labelledby="conv-t">
                <header><h2 id="conv-t">{{#str}}panel_conversation, local_oksigeniaeguahe{{/str}}</h2><span class="secundario">{{#str}}panel_conversation_help, local_oksigeniaeguahe{{/str}}</span></header>
                {{#hasold}}
                <details class="anteriores">
                    <summary>{{oldlabel}}</summary>
                    <ol class="historial">{{#historyold}}{{> local_oksigeniaeguahe/panel_history_item }}{{/historyold}}</ol>
                </details>
                {{/hasold}}
                <ol class="historial">
                    {{#history}}{{> local_oksigeniaeguahe/panel_history_item }}{{/history}}
                    {{#canact}}
                    <li class="turno-tuyo{{^waiting}} ya{{/waiting}}" data-turno>
                        {{#me}}{{> local_oksigeniaeguahe/panel_face }}{{/me}}
                        <div class="que">
                            <span class="quien"><b data-turno-titulo>{{#waiting}}{{#str}}panel_your_turn, local_oksigeniaeguahe{{/str}}{{/waiting}}{{^waiting}}{{#str}}panel_answered_already, local_oksigeniaeguahe{{/str}}{{/waiting}}</b></span>
                            {{#answered}}{{#stamp}}<span class="sello-grande" aria-hidden="true"><small>{{top}}</small><b>{{day}}</b><span>{{hour}}</span></span>{{/stamp}}{{/answered}}
                            {{#typing}}<p class="escribiendo">{{> local_oksigeniaeguahe/panel_face }}<span>{{#str}}panel_typing, local_oksigeniaeguahe, {{first}}{{/str}}</span></p>{{/typing}}
                            <form class="paso" id="contestar" method="post" action="{{action}}" data-canales="1" data-redactor>
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                {{#composer}}
                                {{#hassuggestions}}
                                <div class="ya-dijisteis" role="group" aria-labelledby="yd-t">
                                    <span class="rotulo-p" id="yd-t">{{#str}}panel_said_before, local_oksigeniaeguahe{{/str}}</span>
                                    {{#suggestions}}<button class="sugerencia" type="submit" name="use" value="{{id}}" data-texto="{{text}}"><b>{{title}}</b><span>{{uses}}</span></button>{{/suggestions}}
                                </div>
                                {{/hassuggestions}}
                                {{#draft}}
                                <details class="borrador">
                                    <summary>{{#str}}panel_draft_of, local_oksigeniaeguahe, {"who": "{{who}}", "when": "{{when}}"}{{/str}}</summary>
                                    <p>{{text}}</p>
                                    <button class="enlace" type="submit" name="use" value="draft" data-texto="{{text}}">{{#str}}panel_draft_use, local_oksigeniaeguahe{{/str}}</button>
                                </details>
                                {{/draft}}
                                <div class="por" role="radiogroup" aria-label="{{#str}}panel_answer_by, local_oksigeniaeguahe{{/str}}">
                                    <span>{{#str}}panel_by, local_oksigeniaeguahe{{/str}}</span>
                                    {{#ways}}<input class="oculto" type="radio" name="channel" id="canal-{{value}}" value="{{value}}" data-boton="{{button}}"{{#checked}} checked{{/checked}}{{#disabled}} disabled{{/disabled}}><label class="ficha-canal" for="canal-{{value}}">{{{icon}}}{{name}}{{#why}} <span class="nota">· {{why}}</span>{{/why}}</label>{{/ways}}
                                </div>
                                {{#notes}}<p class="aviso-suave">{{{i.info}}}<span>{{.}}</span></p>{{/notes}}
                                <div class="campo"><label for="borrador">{{#str}}panel_what_you_say, local_oksigeniaeguahe{{/str}}</label><textarea id="borrador" name="body" rows="7" data-tecla="r" data-tecla-que="{{#str}}panel_answer, local_oksigeniaeguahe{{/str}}">{{greeting}}</textarea><span class="ayuda">{{#str}}panel_what_you_say_help, local_oksigeniaeguahe{{/str}}</span></div>
                                {{#next}}
                                <div class="campo siguiente">
                                    <label for="siguiente">{{#str}}panel_next, local_oksigeniaeguahe{{/str}} <span class="opcional">{{#str}}panel_optional, local_oksigeniaeguahe{{/str}}</span></label>
                                    <div class="siguiente-fila"><input id="siguiente" name="next" value="{{next.value}}" placeholder="{{#str}}panel_next_example, local_oksigeniaeguahe{{/str}}" autocomplete="off"><input type="date" name="nextday" value="{{next.day}}" aria-label="{{#str}}panel_next_day, local_oksigeniaeguahe{{/str}}"></div>
                                </div>
                                {{/next}}
                                <div class="acciones">
                                    <button class="boton principal" type="submit" name="action" value="send" data-enviar="1">{{{i.enviado}}}<span>{{button}}</span></button>
                                    <button class="boton secundario" type="submit" name="action" value="answer" data-tecla="c" data-tecla-que="{{#str}}answer_save, local_oksigeniaeguahe{{/str}}" data-tecla-intro="1">{{{i.check}}}{{#str}}answer_save, local_oksigeniaeguahe{{/str}}</button>
                                    <span class="separa-h"></span>
                                    <button class="boton terciario pequeno" type="submit" name="action" value="received">{{#str}}panel_wrote_again, local_oksigeniaeguahe{{/str}}</button>
                                    <button class="boton terciario pequeno" type="submit" name="action" value="note">{{{i.nota}}}{{#str}}panel_team_note, local_oksigeniaeguahe{{/str}}</button>
                                </div>
                                {{/composer}}
                            </form>
                        </div>
                    </li>
                    {{/canact}}
                </ol>
            </section>
        </div>
        <div class="col col-lado">
            {{#proposal}}
            <section class="apartado propuesta" aria-labelledby="prop-t">
                <header><h2 id="prop-t">{{#str}}panel_proposal, local_oksigeniaeguahe{{/str}}</h2></header>
                <p class="frase"><b>{{sentence}}</b>: {{why}}.</p>
                <div class="acciones">
                    <a class="boton principal" href="{{url}}" data-propuesta="{{text}}" data-tecla="v" data-tecla-que="{{button}}">{{{i.enviado}}}{{button}}</a>
                    {{#visit}}<a class="boton terciario pequeno" href="#cambiar-visita" data-abre-detalles="cambiar-visita">{{{i.lapiz}}}{{#str}}panel_change, local_oksigeniaeguahe{{/str}}</a>{{/visit}}
                </div>
                <p class="def">{{#str}}panel_proposal_help, local_oksigeniaeguahe{{/str}}</p>
            </section>
            {{/proposal}}
            {{^proposal}}{{#noproposal}}
            <section class="apartado propuesta sin">
                <header><h2>{{#str}}panel_proposal, local_oksigeniaeguahe{{/str}}</h2></header>
                <p class="frase">{{noproposal}}</p>
            </section>
            {{/noproposal}}{{/proposal}}
            {{#visit}}
            <details class="apartado visita-propia" id="cambiar-visita">
                <summary><h2>{{#str}}panel_visit, local_oksigeniaeguahe{{/str}}</h2><span class="secundario">{{#str}}panel_visit_only, local_oksigeniaeguahe{{/str}}</span></summary>
                <div class="pidieron"><span class="secundario">{{#str}}panel_they_asked, local_oksigeniaeguahe{{/str}}</span><b>{{asked}}</b></div>
                {{#canact}}
                <form method="post" action="{{action}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="propose"><input type="hidden" name="people" value="{{people}}">
                    <div class="rejilla-2">
                        <div class="campo"><label for="vd">{{#str}}panel_day, local_oksigeniaeguahe{{/str}}</label><input id="vd" type="date" name="date" value="{{date}}" required></div>
                        <div class="campo"><label for="vh">{{#str}}panel_hour, local_oksigeniaeguahe{{/str}}</label><input id="vh" type="time" name="time" value="17:30" required></div>
                        <div class="campo"><label for="vm">{{#str}}panel_length, local_oksigeniaeguahe{{/str}}</label><select id="vm" name="minutes">{{#minutes}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/minutes}}</select></div>
                        <div class="campo"><label for="vl">{{#str}}panel_where, local_oksigeniaeguahe{{/str}}</label><input id="vl" name="place" value="{{place}}"></div>
                        {{#hasguides}}<div class="campo ancho"><label for="vg">{{#str}}panel_guide, local_oksigeniaeguahe{{/str}}</label><select id="vg" name="guide">{{#guides}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/guides}}</select></div>{{/hasguides}}
                    </div>
                    <button class="boton secundario" type="submit">{{{i.actos}}}{{#str}}panel_propose, local_oksigeniaeguahe{{/str}}</button>
                    <p class="def">{{#str}}panel_propose_help, local_oksigeniaeguahe{{/str}}</p>
                </form>
                {{/canact}}
            </details>
            {{/visit}}
            <section class="apartado">
                <header><h2>{{#str}}panel_who_writes, local_oksigeniaeguahe{{/str}}</h2>{{#canact}}<a class="enlace" href="{{editurl}}">{{{i.lapiz}}}{{#str}}panel_change, local_oksigeniaeguahe{{/str}}</a>{{/canact}}</header>
                <div class="adultos">
                    {{#adults}}
                    <div class="adulto"><b>{{name}}</b>
                        {{#ways}}<span class="linea-c">{{{icon}}}<span>{{text}} · <a href="{{href}}" dir="ltr">{{value}}</a></span></span>{{/ways}}
                        {{^hasways}}<span class="secundario">{{#str}}panel_no_contact, local_oksigeniaeguahe{{/str}}</span>{{/hasways}}
                    </div>
                    {{/adults}}
                    <p class="secundario">{{lang}}</p>
                </div>
            </section>
            {{#hasabout}}
            <section class="apartado">
                <header><h2>{{#str}}panel_answers, local_oksigeniaeguahe{{/str}}</h2></header>
                {{#hasanswers}}<dl class="respuestas">{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>{{/hasanswers}}
                {{#hasuntold}}<p class="sin-contar"><b>{{#str}}panel_untold, local_oksigeniaeguahe{{/str}}</b> {{untoldtext}}. {{#str}}panel_untold_help, local_oksigeniaeguahe{{/str}}</p>{{/hasuntold}}
            </section>
            {{/hasabout}}
            {{#hasevents}}
            <section class="apartado">
                <header><h2>{{#str}}panel_their_events, local_oksigeniaeguahe{{/str}}</h2></header>
                {{#events}}<p class="visita"><span class="hoja-cal"><small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span></span><span class="que"><b>{{hour}} · {{name}}</b><span class="secundario">{{people}}{{#came}} · {{#str}}panel_came_yes, local_oksigeniaeguahe{{/str}}{{/came}}</span></span></p>{{/events}}
            </section>
            {{/hasevents}}
            <details class="apartado plegado">
                <summary><h2>{{#str}}panel_their_page_and_data, local_oksigeniaeguahe{{/str}}</h2></summary>
                <p>{{#str}}panel_their_page_help, local_oksigeniaeguahe{{/str}}</p>
                {{#newlink}}<div class="campo"><label for="enlace-nuevo">{{#str}}familylink, local_oksigeniaeguahe{{/str}}</label><input id="enlace-nuevo" readonly value="{{newlink}}" spellcheck="false"></div>{{/newlink}}
                {{#canact}}
                <div class="cabeza-acciones">
                    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="boton terciario pequeno" type="submit" name="action" value="link">{{{i.enlace}}}{{#str}}panel_new_link, local_oksigeniaeguahe{{/str}}</button></form>
                    {{#mergeurl}}<a class="boton terciario pequeno" href="{{mergeurl}}">{{{i.fundir}}}{{#str}}panel_merge, local_oksigeniaeguahe{{/str}}</a>{{/mergeurl}}
                </div>
                <p class="secundario">{{#str}}panel_their_data_help, local_oksigeniaeguahe{{/str}}</p>
                <details class="confirmar">
                    <summary class="boton rojo pequeno">{{{i.borrar}}}{{#str}}panel_erase, local_oksigeniaeguahe{{/str}}</summary>
                    <form method="post" action="{{action}}">
                        <p><b>{{erasequestion}}</b></p>
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button class="boton peligro pequeno" type="submit" name="action" value="erase">{{#str}}erase_yes, local_oksigeniaeguahe{{/str}}</button>
                        <button class="boton secundario pequeno" type="button" data-cerrar="1">{{#str}}erase_no, local_oksigeniaeguahe{{/str}}</button>
                    </form>
                </details>
                {{/canact}}
            </details>
        </div>
    </div>
</div>
