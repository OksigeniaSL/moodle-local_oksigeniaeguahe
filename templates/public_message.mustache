{{!
    @template local_oksigeniaeguahe/public_message

    A page that only says something kind: a link that no longer works, an event that is full, the data erased. The rail
    waits with its empty hook, and the family can write or call the centre.

    Example context (json):
    {"i": {"mail": "", "phone": ""}, "title": "Este enlace ya no funciona", "text": "Pídannos uno nuevo.", "hook": true,
     "email": "admisiones@example.com", "phone": "+34 900 000 000", "tel": "+34900000000", "writeus": "Escribirnos"}
}}
<section class="pared corta">
    {{#hook}}
    <div class="espera">
        <div class="riel" aria-hidden="true"></div>
        <div class="perchas n1"><div class="percha"><svg class="colgante vacio" viewBox="22 13 20 16" aria-hidden="true" focusable="false"><path class="gancho" d="M31 13 L33.6 13 L33.6 23.4 L31 23.4 Z"/><path class="gancho" d="M32.3 21.2 A3 3 0 1 1 32.29 21.2 Z"/><path class="pomo-luz" d="M31.1 22.6 A1.2 1.2 0 1 1 31.09 22.6 Z"/></svg></div></div>
    </div>
    {{/hook}}
    <div class="mensaje">
        <h1>{{title}}</h1>
        <p class="entradilla">{{text}}</p>
        <div class="acciones">
            {{#email}}<a class="boton principal" href="mailto:{{email}}">{{{i.mail}}}{{writeus}}</a>{{/email}}
            {{#phone}}<a class="enlace" href="tel:{{tel}}">{{{i.phone}}}{{phone}}</a>{{/phone}}
        </div>
    </div>
</section>
