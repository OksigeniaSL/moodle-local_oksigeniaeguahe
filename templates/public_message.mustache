{{!
    @template local_oksigeniaeguahe/public_message

    A page that only says something to a family: a link that no longer works, an event that has closed.

    Example context (json):
    {"title": "Este enlace ya no funciona", "text": "Pidan uno nuevo al centro."}
}}
<article class="eg-card eg-message">
    <h1>{{title}}</h1>
    <p>{{text}}</p>
</article>
