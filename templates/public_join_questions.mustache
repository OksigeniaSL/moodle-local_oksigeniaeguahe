{{!
    @template local_oksigeniaeguahe/public_join_questions

    The questions of a form of the centre on its own page: the same ones as public_questions, under «questions» instead of
    «fields», which are the ones of the form.

    Example context (json):
    {"questions": {"fields": [{"id": 3, "name": "f3", "label": "¿Tienen hermanos en el centro?", "issection": false, "ischips": true, "isscale": false,
        "ismulti": false, "istext": false, "islong": false, "isdate": false, "isnumber": false, "required": false, "help": "", "showif": false,
        "hidden": false, "invalid": false, "error": "", "autosave": false, "pub_if_you_wish": "(si quieren)",
        "options": [{"value": "Sí", "label": "Sí", "checked": false}]}]} }
}}
{{#questions}}{{> local_oksigeniaeguahe/public_questions }}{{/questions}}
