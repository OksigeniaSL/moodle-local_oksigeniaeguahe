{{!
    @template local_oksigeniaeguahe/public_writeby

    How a family wants the centre to write to them: by email, on WhatsApp, on Telegram, several at once, or not
    at all. From a mail, the way pressed there is asked on the wall, and on the paper a card with how they are written to
    now, the ways as boxes with the pressed one already changed and its one big button; beside it, «do not write to us any
    more». «Do not write to us any more» pressed in a mail is asked with its own button, the boxes beside it. Once chosen,
    the wall says it, and under the rail their backpacks with a note in the hand of the centre; for each phone marked and
    not joined yet, the button that joins it and the message as it goes written. Asked on WhatsApp already («asked»), what
    to touch there, drawn with the word of its button («yes»), and beside it the button for whoever does not get it
    («planb»). At a computer, asked once, the codes to point the phone at («computer»).

    Example context (json):
    {"action": "#", "sesskey": "abc", "lang": "es", "ante": "Cómo les escribimos", "pageurl": "#",
     "title": "¿Les escribimos también por WhatsApp?",
     "nowpill": {"icon": "", "text": "Ahora: por correo"},
     "choosing": {"means": "Les llegaría lo mismo por los dos.", "legend": "Por dónde les escribimos",
     "boxes": [{"value": "email", "icon": "", "check": "", "label": "Correo", "line": "A su correo", "checked": true,
     "pressed": false, "tag": ""}, {"value": "whatsapp", "icon": "", "check": "", "label": "WhatsApp",
     "line": "Al teléfono", "checked": true, "pressed": true, "tag": "Nuevo"}],
     "icon": "", "button": "Sí, así", "save": "Sí, así", "nobox": "Marquen al menos una", "noinvites": false, "noinvitestext": "No queremos recibir invitaciones a eventos", "next": "Después nos saludan."},
     "none": false,
     "nonebutton": {"icon": "", "label": "No escribirnos más", "ask": "¿O prefieren que no les escribamos más?",
     "small": "Su página sigue aquí."},
     "done": false}
}}
{{#done}}
<section class="pared es-hecho" aria-labelledby="titulo">
    <div class="saludo-arriba"><p class="antetitulo">{{ante}}</p><h1 class="titular" id="titulo">{{title}}</h1>{{#notnow}}<p class="es-salir"><a class="enlace" href="{{url}}">{{label}}</a> · <a class="enlace" href="{{changeurl}}">{{change}}</a></p>{{/notnow}}</div>
    {{^hasjoins}}
    <div class="riel" aria-hidden="true"></div>
    <div class="heroe-ancho">
        {{#pegs}}{{> local_oksigeniaeguahe/public_pegs }}{{/pegs}}
        <div class="bajo-riel">
            <div class="es-nota" role="img" aria-label="{{note}}">
                <p class="es-mano{{#pending}} es-pendiente{{/pending}}"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M9 25c4 3 7 7 10 12 6-11 12-19 21-27"/></svg><span>{{note}}</span></p>
                <p class="es-firma">{{sign}}</p>
            </div>
        </div>
    </div>
    {{/hasjoins}}
</section>
<section class="es-despues{{#hasjoins}} con-pasos{{/hasjoins}}">
    {{^hasjoins}}<div><p>{{text}}</p></div>{{/hasjoins}}
    {{#hasjoins}}
    <div class="es-carta es-unirse">
        {{#asked}}<div class="es-mirar"><span class="es-globo" aria-hidden="true"><i></i><i></i><b>{{yes}}</b></span><p>{{text}}</p></div>{{/asked}}
        {{^asked}}<p>{{text}}</p>{{/asked}}
        {{#joins}}
        <div class="es-paso">
            {{#text}}<p>{{text}}</p>{{/text}}
            <a class="boton principal" href="{{url}}" target="_blank" rel="noopener">{{{icon}}}{{label}}</a>
            {{#written}}<div class="es-burbuja" dir="auto"><small>{{writtenlabel}}</small>{{written}}</div>{{/written}}
            {{#small}}<p class="es-pequeno">{{small}}</p>{{/small}}
        </div>
        {{/joins}}
        {{#until}}<p class="es-pequeno">{{until}}</p>{{/until}}
    </div>
    <div class="es-aparte">
        {{#planb}}
        <div class="es-paso">
            <p>{{planb}}</p>
            <a class="boton secundario" href="{{url}}" target="_blank" rel="noopener">{{{icon}}}{{label}}</a>
            {{#written}}<div class="es-burbuja" dir="auto"><small>{{writtenlabel}}</small>{{written}}</div>{{/written}}
        </div>
        {{/planb}}
        {{#computer}}
        <details class="es-ordenador"{{#open}} open{{/open}}>
            <summary><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM6 6h1v1H6zM17 6h1v1h-1zM6 17h1v1H6zM14 14h3v3h-3zM18 18h3v3h-3z"/></svg><span>{{ask}}</span></summary>
            <p>{{line}}</p>
            <div class="es-codigos">{{#codes}}<div class="es-codigo"><span>{{{qr}}}</span>{{#many}}<b>{{name}}</b>{{/many}}</div>{{/codes}}</div>
        </details>
        {{/computer}}
    </div>
    {{/hasjoins}}
    {{#back}}<a class="boton secundario" href="{{url}}">{{{icon}}}{{label}}</a>{{/back}}
</section>
{{/done}}
{{^done}}
<section class="pared corta" aria-labelledby="titulo">
    <div class="saludo-arriba"><p class="antetitulo">{{ante}}</p><h1 class="titular" id="titulo">{{title}}</h1></div>
</section>
<section class="es-elegir">
    {{#none}}
    <form method="post" action="{{action}}" class="es-carta">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="escribir">
        <input type="hidden" name="idioma" value="{{lang}}">
        {{#nowpill}}<p class="es-ahora">{{{icon}}}{{text}}</p>{{/nowpill}}
        {{#events}}
        <div class="es-paradas">
            <button type="submit" name="soloeventos" value="1" class="es-parada es-primera"><span class="es-cas-ico">{{{eventsicon}}}</span><span><b>{{label}}</b>{{#small}}<small>{{small}}</small>{{/small}}</span>{{{go}}}</button>
            <button type="submit" name="nada" value="1" class="es-parada"><span class="es-cas-ico">{{{noneicon}}}</span><span><b>{{button}}</b><small>{{means}}</small></span>{{{go}}}</button>
        </div>
        {{/events}}
        {{^events}}
        <p>{{means}}</p>
        <button type="submit" name="nada" value="1" class="boton principal">{{{icon}}}{{button}}</button>
        {{/events}}
    </form>
    <div class="es-otras">
        <p>{{other}}</p>
        <div class="es-otras-fila"><a class="boton secundario" href="{{pickurl}}">{{pick}}</a></div>
    </div>
    {{/none}}
    {{#choosing}}
    <form method="post" action="{{action}}" class="es-carta">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="escribir">
        <input type="hidden" name="idioma" value="{{lang}}">
        {{#nowpill}}<p class="es-ahora">{{{icon}}}{{text}}</p>{{/nowpill}}
        {{#only}}<input type="hidden" name="por[]" value="{{value}}">{{#address}}<p class="es-direccion" dir="ltr">{{address}}</p>{{/address}}{{/only}}
        {{^only}}
        <p>{{means}}</p>
        <fieldset class="es-casillas">
            <legend class="oculto">{{legend}}</legend>
            {{#boxes}}<label class="es-casilla{{#checked}} es-on{{/checked}}{{#pressed}} es-pulsada{{/pressed}}"><input type="checkbox" name="por[]" value="{{value}}"{{#checked}} checked{{/checked}}><span class="es-cas-ico">{{{icon}}}</span><span class="es-cas-t"><b>{{label}}{{#tag}}<span class="es-cambia">{{tag}}</span>{{/tag}}</b><small>{{line}}</small></span><span class="es-caja" aria-hidden="true">{{{check}}}</span></label>{{/boxes}}
        </fieldset>
        {{/only}}
        <input type="hidden" name="evt" value="1">
        <label class="es-eventos"><input type="checkbox" name="noinvites" value="1"{{#noinvites}} checked{{/noinvites}}><span>{{noinvitestext}}</span></label>
        <button type="submit" class="boton principal" data-guardar="{{save}}" data-ninguno="{{nobox}}">{{{icon}}}<span>{{button}}</span></button>
        {{#next}}<p class="es-pequeno">{{next}}</p>{{/next}}
    </form>
    {{/choosing}}
    {{#nonebutton}}
    <form method="post" action="{{action}}" class="es-otras">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="escribir">
        <input type="hidden" name="idioma" value="{{lang}}">
        <p>{{ask}}</p>
        <div class="es-otras-fila"><button type="submit" name="nada" value="1" class="boton secundario">{{{icon}}}{{label}}</button></div>
        <p class="es-pequeno">{{small}}</p>
    </form>
    {{/nonebutton}}
</section>
{{/done}}
