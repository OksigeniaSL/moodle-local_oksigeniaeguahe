{{!
    @template local_oksigeniaeguahe/public_brief_field

    A field of the form of Eguahe (public_brief_form): its name, always at the same height, and what is written or chosen
    under it; what is wrong takes the place of its name.

    Example context (json):
    {"id": "b0", "name": "a0first", "label": "Tu nombre", "value": "", "error": "", "type": "text", "autocomplete": "name",
        "inputmode": "", "ltr": false, "select": false, "last": false, "need": "nombre", "mark": false, "peg": false, "area": false, "wide": false}
}}
<p class="fb-campo{{#last}} fb-ancho{{/last}}{{#wide}} fb-entero{{/wide}}{{#select}} fb-lista{{/select}}">
    {{#select}}<select id="{{id}}" name="{{name}}"{{#need}} data-hace-falta="{{need}}"{{/need}}{{#error}} aria-invalid="true"{{/error}}><option value="0">{{none}}</option>{{#groups}}<optgroup label="{{label}}">{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/options}}</optgroup>{{/groups}}{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/options}}</select>{{/select}}
    {{^select}}{{#area}}<textarea id="{{id}}" name="{{name}}" rows="1" maxlength="2000" placeholder=" " data-crece>{{value}}</textarea>{{/area}}{{^area}}<input id="{{id}}" name="{{name}}" type="{{type}}" value="{{value}}" placeholder=" " autocomplete="{{autocomplete}}"{{#inputmode}} inputmode="{{inputmode}}"{{/inputmode}}{{#ltr}} dir="ltr"{{/ltr}}{{#need}} data-hace-falta="{{need}}"{{/need}}{{#mark}} data-marca{{/mark}}{{#peg}} data-child="0"{{/peg}}{{#error}} aria-invalid="true"{{/error}}>{{/area}}{{/select}}
    {{#error}}<label for="{{id}}" class="fb-mal" data-nombre="{{label}}"><span class="fb-oculto">{{label}}: </span>{{error}}</label>{{/error}}{{^error}}<label for="{{id}}">{{label}}</label>{{/error}}
    <svg class="fb-listo" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11"/><path d="M7 12.5l3.4 3.4L17 9"/></svg>
</p>
