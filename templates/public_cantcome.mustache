{{!
    @template local_oksigeniaeguahe/public_cantcome

    «We cannot come», pressed in a mail: one question, with the visit in sight, and its two answers.

    Example context (json):
    {"title": "¿No vienen el sábado 5 de diciembre?", "name": "Jornada de puertas abiertas", "when": "Sábado 5 de diciembre · De 10:00 a 13:00",
        "place": "Entrada principal", "action": "#", "sesskey": "abc", "eventid": 3, "no": "No podemos ir", "yes": "Sí vamos", "back": "#"}
}}
<section class="pared corta">
    <div class="mensaje">
        <h1>{{title}}</h1>
        <p class="entradilla"><b dir="auto">{{name}}</b><br>{{when}}{{#place}}<br><span dir="auto">{{place}}</span>{{/place}}</p>
        <form class="acciones" method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="cantcome"><input type="hidden" name="acto" value="{{eventid}}">
            <button class="boton principal" type="submit">{{no}}</button>
            <a class="boton secundario" href="{{back}}">{{yes}}</a>
        </form>
    </div>
</section>
