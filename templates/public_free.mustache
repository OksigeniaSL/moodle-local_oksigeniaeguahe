{{!
    @template local_oksigeniaeguahe/public_free

    An act anybody may come to without signing up: what it is, when and where.

    Example context (json):
    {
        "longname": false, "kicker": "Charla", "headline": "Respirar y atender", "when": "miércoles 2 de diciembre", "hours": "De 15:00 a 16:00", "where": "Biblioteca",
        "act": {"word": "Charla", "any": true, "about": "Cómo acompañar a los niños.", "poster": false, "speakers": [], "hasspeakers": false,
            "speakerstitle": "Con", "audience": "", "free": true, "freetext": "Entrada libre. No hace falta inscribirse."}
    }
}}
<section class="pared pared-libre" aria-labelledby="titulo">
    <div class="saludo-arriba{{#act}}{{#poster}} con-cartel{{#wide}} con-apaisado{{/wide}}{{/poster}}{{/act}}"{{#act}}{{#poster}} style="--cartel-alto: {{tall}}px; --cartel-razon: {{ratio}}"{{/poster}}{{/act}}>
        {{#kicker}}<p class="antetitulo">{{kicker}}</p>{{/kicker}}
        <h1 class="titular{{#longname}} largo{{/longname}}" id="titulo">{{headline}}</h1>
        <p class="acto-cuando">{{when}}<span>{{hours}}{{#where}} · <span dir="auto">{{where}}</span>{{/where}}</span></p>
        {{#act}}{{> local_oksigeniaeguahe/public_act }}{{/act}}
    </div>
    <div class="riel" aria-hidden="true"></div>
</section>
