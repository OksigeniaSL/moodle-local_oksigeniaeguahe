{{!
    @template local_oksigeniaeguahe/pick_centre

    For someone who works for several centres: which one.

    Example context (json):
    {"hascentres": true, "centres": [{"name": "Colegio de ejemplo", "url": "#", "waiting": 3}], "manageurl": "#"}
}}
<div class="eguahe">
    <h2>{{#str}}pick_centre, local_oksigeniaeguahe{{/str}}</h2>
    {{#hascentres}}
    <ul class="eguahe-centres">
        {{#centres}}<li><a href="{{url}}">{{name}}</a> <span class="eguahe-quiet">{{#str}}inbox_waiting, local_oksigeniaeguahe, {{waiting}}{{/str}}</span></li>{{/centres}}
    </ul>
    {{/hascentres}}
    {{^hascentres}}<p>{{#str}}no_centres, local_oksigeniaeguahe{{/str}}</p>{{/hascentres}}
    {{#manageurl}}<p><a class="btn btn-primary" href="{{manageurl}}">{{#str}}centres, local_oksigeniaeguahe{{/str}}</a></p>{{/manageurl}}
</div>
