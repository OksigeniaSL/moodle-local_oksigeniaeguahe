{{!
    @template local_oksigeniaeguahe/panel_entries

    The entries of a centre: by how many doors families arrive (the h1) and how many arrivals each brought, as bars on
    one scale and in one colour, never ranked by a judgement; the forms of the centre and the bridges with what it
    already uses, each with its state in words, when the last family came and where it is shared from; the kinds not
    used yet, with what each one is; and a new entry. The rows are links: the whole row opens the entry.

    New in this round: groups[] (key, title, sub, rows[]) in place of forms and bridges; in each row v (its share of the
    largest, 0 to 1), n, broughttext, hasn, kindname, icon, statetext, open; notused[], hasnotused, def. Kept: head,
    canact, action, sesskey, kinds (with icon). With no entry yet, firsttime (text, button {url, name} or false).

    Example context (json):
    {
        "i": {"atras": "", "der": "", "mas1": ""},
        "head": {"title": "Las familias llegan por 6 entradas", "sub": "La que más ha traído, «Pidan información».", "back": false, "ante": "", "action": false},
        "groups": [{"key": "formularios", "title": "Los formularios del centro", "sub": "Hechos en Eguahe.",
            "rows": [{"url": "#", "name": "Pidan información", "kindname": "Formulario", "icon": "", "open": true, "statetext": "Abierta",
                "n": 41, "broughttext": "41 familias", "hasn": true, "last": "la última, ayer a las 21:14", "sites": ["Instagram"], "hassites": true, "missing": "", "v": 1}]}],
        "firsttime": false, "hasnotused": false, "notused": [], "def": "Una llegada es una familia que entra por esa entrada.",
        "canact": true, "action": "#", "sesskey": "abc",
        "kinds": [{"value": "form", "name": "Formulario", "help": "Hecho en Eguahe.", "icon": "", "checked": true}],
        "templates": [{"value": "howitwent", "name": "Cómo fue la jornada", "help": "La encuesta de después."}]
    }
}}
<div class="pagina pagina-entradas">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    {{#firsttime}}
    <section class="primera-vez">
        <p>{{text}}</p>
        {{#button}}<a class="boton principal" href="{{url}}">{{{i.mas1}}}{{name}}</a>{{/button}}
    </section>
    {{/firsttime}}
    <div class="entradas">
        {{#groups}}
        <section class="grupo-entradas" aria-labelledby="g-{{key}}">
            <header class="cab-grupo"><h2 id="g-{{key}}">{{title}}</h2><p class="secundario">{{sub}}</p></header>
            <ul class="filas-entradas">{{#rows}}<li>{{> local_oksigeniaeguahe/panel_entry_row }}</li>{{/rows}}</ul>
        </section>
        {{/groups}}
        {{#hasnotused}}
        <section class="grupo-entradas sin-usar" aria-labelledby="g-sin">
            <header class="cab-grupo"><h2 id="g-sin">{{#str}}panel_entries_not_used, local_oksigeniaeguahe{{/str}}</h2></header>
            {{#notused}}<a class="sin-usar-fila" href="{{url}}">{{{icon}}}<span class="que"><b>{{name}}</b><span class="secundario">{{help}}</span></span><span class="enlace">{{#str}}panel_start_it, local_oksigeniaeguahe{{/str}}</span></a>{{/notused}}
        </section>
        {{/hasnotused}}
        <p class="def">{{def}}</p>
        {{#canact}}
        <details class="apartado nueva-entrada" id="nueva">
            <summary><h2>{{#str}}panel_new_entry, local_oksigeniaeguahe{{/str}}</h2></summary>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <fieldset class="opciones opciones-tipos"><legend class="oculto">{{#str}}panel_entry_kind, local_oksigeniaeguahe{{/str}}</legend>
                    {{#kinds}}<label class="opcion"><input type="radio" name="kind" value="{{value}}"{{#checked}} checked{{/checked}}>{{{icon}}}<span><b>{{name}}</b><span class="secundario">{{help}}</span></span></label>{{/kinds}}
                </fieldset>
                <div class="campo"><label for="entry-name">{{#str}}panel_entry_name, local_oksigeniaeguahe{{/str}}</label><input id="entry-name" name="name" autocomplete="off" aria-describedby="entry-name-a"><span class="ayuda" id="entry-name-a">{{#str}}panel_entry_name_help, local_oksigeniaeguahe{{/str}}</span></div>
                <div class="acciones"><button class="boton principal" type="submit">{{{i.mas1}}}{{#str}}panel_create_entry, local_oksigeniaeguahe{{/str}}</button></div>
            </form>
        </details>
        <section class="apartado hechas" aria-labelledby="g-hechas">
            <header class="cab-grupo"><h2 id="g-hechas">{{#str}}panel_start_made, local_oksigeniaeguahe{{/str}}</h2><p class="secundario">{{#str}}panel_start_made_sub, local_oksigeniaeguahe{{/str}}</p></header>
            <form class="hechas-lista" method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#templates}}<button class="sin-usar-fila" type="submit" name="template" value="{{value}}">{{{i.mas1}}}<span class="que"><b>{{name}}</b><span class="secundario">{{help}}</span></span><span class="enlace">{{#str}}panel_start_it, local_oksigeniaeguahe{{/str}}</span></button>{{/templates}}
            </form>
        </section>
        {{/canact}}
    </div>
</div>
