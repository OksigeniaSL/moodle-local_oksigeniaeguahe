{{!
    @template local_oksigeniaeguahe/panel_replies

    What the families invited to an act said, by name: who comes, who does not this time, who opened it and said nothing,
    and who has not opened it.

    Example context (json):
    {
        "groups": [{"key": "yes", "name": "Vienen", "n": 1, "open": true,
            "rows": [{"name": "Ana Ruiz", "when": "hoy a las 12:10", "url": "#"}] }]
    }
}}
<div class="respuestas-acto">
    <h3>{{#str}}panel_replies, local_oksigeniaeguahe{{/str}}</h3>
    {{#groups}}
    <details class="respuestas-{{key}}"{{#open}} open{{/open}}>
        <summary>{{name}} <b>{{n}}</b></summary>
        <ul>{{#rows}}<li><a href="{{url}}">{{name}}</a>{{#when}} <span class="secundario">{{when}}</span>{{/when}}</li>{{/rows}}</ul>
    </details>
    {{/groups}}
    <p class="secundario">{{#str}}panel_replies_help, local_oksigeniaeguahe{{/str}}</p>
</div>
