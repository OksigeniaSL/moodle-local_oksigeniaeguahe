{{!
    @template local_oksigeniaeguahe/panel_frame

    What goes around every page of the panel of the team: the bar with the mark of Eguahe, the centre (and the others
    the person works for), the sections with how many families wait, and the person; the notices; the page, where
    «main» is; at the foot, who makes Eguahe; and on a phone, the bar at the bottom, except at the door of an event.

    Example context (json):
    {
        "i": {"chev": "", "fuera": "", "mas": "", "salir": ""}, "homeurl": "#", "centre": "Colegio de ejemplo",
        "initials": "C", "logo": "", "hascentres": true, "centres": [{"name": "Academia de ejemplo", "url": "#"}],
        "sections": [{"key": "inbox", "name": "Bandeja", "url": "#", "icon": "", "current": true, "count": 5},
            {"key": "events", "name": "Jornadas y visitas", "url": "#", "icon": "", "current": false, "count": 0}],
        "phone": [{"key": "inbox", "name": "Bandeja", "url": "#", "icon": "", "current": true, "count": 5}],
        "more": [{"key": "entries", "name": "Entradas", "url": "#", "icon": "", "current": false, "count": 0}],
        "morecurrent": false, "door": false,
        "me": {"name": "Andrés Rivas", "first": "Andrés", "picture": "", "initials": "AR"},
        "moodleurl": "#", "logouturl": "#", "hasnotices": true,
        "notices": [{"text": "Guardado.", "error": false}], "credit": "Eguahe, de <a href=\"#\">Oksigenia</a>"
    }
}}
<header class="barra">
    <a class="marca" href="{{homeurl}}" aria-label="{{#str}}panel_home, local_oksigeniaeguahe{{/str}}">{{> local_oksigeniaeguahe/panel_mark }}{{> local_oksigeniaeguahe/panel_word }}</a>
    <span class="separa" aria-hidden="true"></span>
    {{#hascentres}}
    <details class="menu-barra centros">
        <summary class="centro-sel" aria-label="{{#str}}panel_centre_change, local_oksigeniaeguahe, {{centre}}{{/str}}">
            {{#logo}}<img class="emblema" src="{{logo}}" alt="" width="30" height="30">{{/logo}}{{^logo}}<span class="emblema monograma" aria-hidden="true">{{initials}}</span>{{/logo}}
            <span class="nombre">{{centre}}</span>{{{i.chev}}}
        </summary>
        <div class="menu">{{#centres}}<a href="{{url}}">{{name}}</a>{{/centres}}</div>
    </details>
    {{/hascentres}}
    {{^hascentres}}
    <a class="centro-sel" href="{{homeurl}}">
        {{#logo}}<img class="emblema" src="{{logo}}" alt="" width="30" height="30">{{/logo}}{{^logo}}<span class="emblema monograma" aria-hidden="true">{{initials}}</span>{{/logo}}
        <span class="nombre">{{centre}}</span>
    </a>
    {{/hascentres}}
    <nav class="secciones" aria-label="{{#str}}panel_sections, local_oksigeniaeguahe{{/str}}">
        {{#sections}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{name}}{{#count}} <span class="cuenta">{{count}}</span>{{/count}}</a>{{/sections}}
    </nav>
    <details class="menu-barra derecha yo">
        <summary aria-label="{{me.name}}">
            {{#me.picture}}<img class="avatar" src="{{me.picture}}" alt="" width="36" height="36">{{/me.picture}}{{^me.picture}}<span class="avatar" aria-hidden="true">{{me.initials}}</span>{{/me.picture}}
            <span class="nombre">{{me.first}}</span>
        </summary>
        <div class="menu">
            <a href="{{moodleurl}}">{{{i.fuera}}}{{#str}}panel_to_moodle, local_oksigeniaeguahe{{/str}}</a>
            <a href="{{logouturl}}">{{{i.salir}}}{{#str}}logout{{/str}}</a>
        </div>
    </details>
</header>
{{#hasnotices}}
<div class="avisos" role="status">
    {{#notices}}<p class="aviso-suave{{#error}} error{{/error}}">{{{text}}}</p>{{/notices}}
</div>
{{/hasnotices}}
<main id="main">
<!-- main -->
</main>
{{#credit}}
<footer class="pie-producto">
    <span class="firma">{{> local_oksigeniaeguahe/panel_mark }}<span>{{{credit}}}</span></span>
</footer>
{{/credit}}
{{^door}}
<nav class="abajo" aria-label="{{#str}}panel_sections, local_oksigeniaeguahe{{/str}}">
    {{#phone}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}<span>{{short}}</span>{{#count}}<span class="cuenta">{{count}}</span>{{/count}}</a>{{/phone}}
    <details class="mas">
        <summary{{#morecurrent}} aria-current="page"{{/morecurrent}}>{{{i.mas}}}<span>{{#str}}panel_more, local_oksigeniaeguahe{{/str}}</span></summary>
        <nav class="hoja-mas" aria-label="{{#str}}panel_more_sections, local_oksigeniaeguahe{{/str}}">
            {{#more}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{name}}</a>{{/more}}
            <a href="{{moodleurl}}">{{{i.fuera}}}{{#str}}panel_back_moodle, local_oksigeniaeguahe{{/str}}</a>
        </nav>
    </details>
</nav>
{{/door}}
