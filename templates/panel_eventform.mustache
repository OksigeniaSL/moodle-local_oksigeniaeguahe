{{!
    @template local_oksigeniaeguahe/panel_eventform

    Creating or changing an event (events.php), in the order a person thinks it: what it is, when and where, its turns
    on a strip of the day, how many fit, who receives the families (with their faces) and the questions it asks. The form is
    its poster: what a family will read is written where it will be read, and the rest, folded, says how it is in one line. When a change reaches families already signed up (the
    hour, the place, who receives), the server answers the POST with this same page and «notice»: what changes, and the
    message each family would get, before anything is saved or sent. Works without JavaScript: «Add a turn» posts and
    comes back with one more row.

    New in this round (the whole template; it replaces event_form in the panel).

    Example context (json):
    {
        "volunteers": false,
        "i": {"atras": "", "mas1": "", "check": "", "borrar": "", "actos": "", "lapiz": "", "enviado": "", "info": "", "imagen": "", "persona": "", "chev": ""},
        "head": {"title": "Un acto nuevo", "sub": "Las familias lo verán en su página.", "back": {"url": "#", "name": "Jornadas y visitas"}, "action": false, "ante": ""},
        "action": "#", "sesskey": "abc", "id": 0, "isnew": true,
        "kinds": [{"value": "openday", "name": "Jornada de puertas abiertas", "help": "Muchas familias a la vez.", "suggested": "Jornada de puertas abiertas", "checked": true, "id": "tipo-openday"}],
        "word": "", "about": "", "aboutmost": 600, "poster": false, "posteralt": "", "speakers": [], "emptyspeaker": {"i": 0, "n": 1},
        "hascourses": true, "courses": [{"n": 0, "value": "Infantil 3 años", "name": "Infantil 3 años", "checked": false}], "free": false, "freeasks": false, "topic": "", "topicmost": 200,
        "sums": {"turns": "", "fit": "", "hosts": "", "asks": "", "after": ""}, "sumtexts": "{}", "faceicon": "",
        "name": {"value": "", "error": ""}, "tailored": false, "day": "", "start": "", "end": "", "daytext": "",
        "daydate": {"id": "acto-dia", "first": "acto-diad", "form": false, "child": false, "invalid": false, "labelled": true,
            "arialabel": false, "describedby": false, "mirror": {"vivo": "dia"}, "value": "",
            "parts": [{"key": "d", "id": "acto-diad", "name": "dayd", "label": "Día", "value": "", "size": 2, "months": false}]},
        "place": {"value": "", "error": ""}, "parkingon": true, "parkingimg": "#", "parking": false, "placehelp": "Tal como lo leerán.", "capacity": "", "open": false, "load": null,
        "hasslots": false, "slots": [], "emptyslot": {"i": 0, "n": 1, "start": "", "minutes": 45, "capacity": ""},
        "strip": {"from": "10:00", "to": "13:00", "ticks": [{"left": 0, "text": "10:00"}]},
        "hashosts": true, "nohosts": "", "hosts": [{"id": 2, "name": "Lucía Medina", "first": "Lucía", "picture": "", "initials": "LM", "role": "Tutora", "checked": false}],
        "forms": [{"value": 0, "name": "Ninguno", "selected": true}], "hasformquestions": false, "formquestions": [], "formurl": "#",
        "surveys": [{"value": 0, "name": "Solo la pregunta abierta", "selected": true}], "surveyurl": "",
        "preview": {"kind": "Jornada", "name": "Su nombre", "when": "El día y la hora", "place": "Dónde", "faces": [], "hosts": ""},
        "whenerror": "", "notice": null
    }
}}
<div class="pagina pagina-acto-form">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    <form class="acto-form" method="post" action="{{action}}" enctype="multipart/form-data" data-acto-form>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="id" value="{{id}}">
        {{#notice}}
        <section class="apartado aviso-cambio" aria-labelledby="aviso-t" tabindex="-1" data-aviso-cambio>
            <header><h2 id="aviso-t">{{title}}</h2></header>
            <dl class="cambios">{{#changes}}<div><dt>{{what}}</dt><dd><s>{{from}}</s> <span aria-hidden="true">→</span><span class="oculto">{{#str}}panel_changes_to, local_oksigeniaeguahe{{/str}}</span> <b>{{to}}</b></dd></div>{{/changes}}</dl>
            {{#hasfamilies}}
            <p class="secundario">{{who}}</p>
            <figure class="carta-aviso">
                <blockquote><p><b>{{greeting}}</b> {{message}}</p><p class="firma-carta">{{sign}}</p></blockquote>
                <figcaption class="def">{{example}}</figcaption>
            </figure>
            {{/hasfamilies}}
            {{#letters}}<label class="casilla"><input type="checkbox" name="letters" value="1" checked> <span>{{letters}}</span></label>{{/letters}}
            <div class="acciones">
                <button class="boton principal" type="submit" name="notify" value="1">{{{i.enviado}}}{{tell}}</button>
                <button class="boton secundario" type="submit" name="notify" value="0">{{#str}}panel_save_quiet, local_oksigeniaeguahe{{/str}}</button>
                <a class="boton terciario pequeno" href="#acto-que">{{{i.lapiz}}}{{#str}}panel_keep_changing, local_oksigeniaeguahe{{/str}}</a>
            </div>
        </section>
        {{/notice}}
        <div class="acto-hoja">
            <fieldset class="acto-tipos" id="acto-que">
                <legend class="oculto">{{#str}}event_kind, local_oksigeniaeguahe{{/str}}</legend>
                <div class="acto-tipos-fichas">{{#kinds}}<span class="tipo-acto"><input class="oculto" type="radio" id="{{id}}" name="kind" value="{{value}}"{{#checked}} checked{{/checked}} data-vivo-tipo="{{name}}" data-sugerido="{{suggested}}" data-ayuda="{{help}}"><label class="pastilla-r" for="{{id}}">{{name}}</label></span>{{/kinds}}</div>
                <p class="def" data-ayuda-tipo>{{#kinds}}{{#checked}}{{help}}{{/checked}}{{/kinds}}</p>
                <label class="casilla solo-visita"><input type="checkbox" name="tailored" value="1"{{#tailored}} checked{{/tailored}}><span>{{#str}}event_tailored, local_oksigeniaeguahe{{/str}} <span class="secundario">{{#str}}panel_only_visits, local_oksigeniaeguahe{{/str}}</span></span></label>
            </fieldset>
            <p class="rotulo-muestra" id="muestra-t">{{#str}}panel_families_see, local_oksigeniaeguahe{{/str}}</p>
            <div class="banda acto-banda">
                <div class="acto-banda-texto">
                    <span class="etiqueta-b" data-muestra="tipo">{{preview.kind}}</span>
                    <div class="campo solo-otra"><label for="acto-palabra">{{#str}}event_word, local_oksigeniaeguahe{{/str}}</label><input id="acto-palabra" name="word" value="{{word}}" maxlength="40"></div>
                    <div class="campo acto-banda-nombre"><label class="oculto" for="acto-nombre">{{#str}}event_name, local_oksigeniaeguahe{{/str}}</label><textarea id="acto-nombre" name="name" rows="1" required data-crece data-una-linea placeholder="{{#str}}event_name_here, local_oksigeniaeguahe{{/str}}" data-vivo="nombre"{{#isnew}} data-propuesto="{{name.value}}"{{/isnew}}{{#name.error}} aria-invalid="true" aria-describedby="acto-nombre-e"{{/name.error}}>{{name.value}}</textarea>{{#name.error}}<span class="error" id="acto-nombre-e">{{.}}</span>{{/name.error}}</div>
                    <div class="acto-banda-cuando">
                        <div class="campo"><label id="acto-dia-l" for="{{daydate.first}}">{{#str}}panel_day, local_oksigeniaeguahe{{/str}}</label>{{#daydate}}{{> local_oksigeniaeguahe/public_date }}{{/daydate}}</div>
                        <div class="campo"><label for="acto-empieza">{{#str}}event_start, local_oksigeniaeguahe{{/str}}</label><input id="acto-empieza" type="{{#h24}}text{{/h24}}{{^h24}}time{{/h24}}"{{#h24}} inputmode="numeric" maxlength="5" placeholder="hh:mm" autocomplete="off"{{/h24}}{{^h24}} step="900"{{/h24}} data-hora name="start" value="{{start}}" required data-vivo="empieza"></div>
                        <div class="campo"><label for="acto-termina">{{#str}}event_end, local_oksigeniaeguahe{{/str}}</label><input id="acto-termina" type="{{#h24}}text{{/h24}}{{^h24}}time{{/h24}}"{{#h24}} inputmode="numeric" maxlength="5" placeholder="hh:mm" autocomplete="off"{{/h24}}{{^h24}} step="900"{{/h24}} data-hora name="end" value="{{end}}" required data-vivo="termina"></div>
                    </div>
                    {{#whenerror}}<p class="error" id="acto-cuando-e">{{.}}</p>{{/whenerror}}
                    <div class="campo acto-banda-donde"><label for="acto-donde">{{#str}}event_place, local_oksigeniaeguahe{{/str}}</label><input id="acto-donde" name="place" value="{{place.value}}" data-vivo="donde" aria-describedby="acto-donde-a"><span class="ayuda" id="acto-donde-a">{{placehelp}}</span></div>
                </div>
                <div class="acto-cartel-hueco{{#poster}} puesto{{/poster}}" data-cartel>
                    <label class="acto-cartel-boton" for="acto-cartel">{{#poster}}<img src="{{url}}" alt="{{alt}}" data-cartel-imagen>{{/poster}}<span class="acto-cartel-di">{{{i.imagen}}}<b>{{#str}}event_picture, local_oksigeniaeguahe{{/str}}</b><span>{{#str}}event_picture_put, local_oksigeniaeguahe{{/str}}</span></span></label>
                    <input class="acto-cartel-fichero" id="acto-cartel" type="file" name="poster" accept="image/jpeg,image/png,image/webp" aria-describedby="acto-cartel-a">
                    {{#poster}}<label class="casilla" data-cartel-quitar><input type="checkbox" name="posterdrop" value="1"><span>{{#str}}event_picture_drop, local_oksigeniaeguahe{{/str}}</span></label>{{/poster}}
                    <button class="enlace" type="button" data-cartel-nada hidden>{{#str}}event_picture_drop, local_oksigeniaeguahe{{/str}}</button>
                    <span class="ayuda" id="acto-cartel-a">{{#str}}event_picture_help, local_oksigeniaeguahe{{/str}}</span>
                    <div class="campo" data-cartel-alt><label for="acto-cartel-alt">{{#str}}event_picture_alt, local_oksigeniaeguahe{{/str}}</label><input id="acto-cartel-alt" name="posteralt" value="{{posteralt}}" maxlength="255"></div>
                </div>
            </div>
            <div class="acto-cuenta-hoja">
                <div class="campo acto-va-campo acto-tema-campo"><label for="acto-tema">{{#str}}event_topic, local_oksigeniaeguahe{{/str}}</label><input id="acto-tema" name="topic" value="{{topic}}" maxlength="{{topicmost}}" placeholder="{{#str}}event_topic_example, local_oksigeniaeguahe{{/str}}"></div>
                <div class="campo acto-va-campo"><label for="acto-va">{{#str}}event_about, local_oksigeniaeguahe{{/str}}</label><textarea id="acto-va" name="about" rows="3" maxlength="{{aboutmost}}" data-crece>{{about}}</textarea></div>
                <fieldset class="acto-quienes">
                    <legend>{{#str}}event_speakers, local_oksigeniaeguahe{{/str}}</legend>
                    <div class="acto-solapas" data-solapas>
                        {{#speakers}}<div class="solapa" data-solapa><input type="hidden" name="speakerkey[{{i}}]" value="{{key}}"><span class="solapa-cara"><label for="pon-f-{{i}}">{{#photo}}<img src="{{photo}}" alt="" data-cara>{{/photo}}<span class="solapa-ini" aria-hidden="true">{{{faceicon}}}</span><span class="oculto">{{#str}}event_speaker_photo, local_oksigeniaeguahe{{/str}}</span></label><input class="oculto" id="pon-f-{{i}}" type="file" name="speakerphoto[{{i}}]" accept="image/jpeg,image/png,image/webp"></span><div class="solapa-campos"><label class="oculto" for="pon-n-{{i}}">{{#str}}event_speaker_name, local_oksigeniaeguahe{{/str}}</label><input id="pon-n-{{i}}" name="speakername[{{i}}]" value="{{name}}" maxlength="80" placeholder="{{#str}}event_speaker_name, local_oksigeniaeguahe{{/str}}"><label class="oculto" for="pon-q-{{i}}">{{#str}}event_speaker_role, local_oksigeniaeguahe{{/str}}</label><input id="pon-q-{{i}}" name="speakerrole[{{i}}]" value="{{role}}" maxlength="120" placeholder="{{#str}}event_speaker_role, local_oksigeniaeguahe{{/str}}"></div><button class="enlace solapa-quita" type="button" data-solapa-quita hidden>{{#str}}event_speaker_remove, local_oksigeniaeguahe{{/str}}</button></div>{{/speakers}}
                        {{#emptyspeaker}}<div class="solapa nueva" data-solapa data-solapa-nueva="{{i}}"><input type="hidden" name="speakerkey[{{i}}]" value=""><span class="solapa-cara"><label for="pon-f-{{i}}"><span class="solapa-ini" aria-hidden="true">{{{faceicon}}}</span><span class="oculto">{{#str}}event_speaker_photo, local_oksigeniaeguahe{{/str}}</span></label><input class="oculto" id="pon-f-{{i}}" type="file" name="speakerphoto[{{i}}]" accept="image/jpeg,image/png,image/webp"></span><div class="solapa-campos"><label class="oculto" for="pon-n-{{i}}">{{#str}}event_speaker_name, local_oksigeniaeguahe{{/str}}</label><input id="pon-n-{{i}}" name="speakername[{{i}}]" value="" maxlength="80" placeholder="{{#str}}event_speaker_name, local_oksigeniaeguahe{{/str}}"><label class="oculto" for="pon-q-{{i}}">{{#str}}event_speaker_role, local_oksigeniaeguahe{{/str}}</label><input id="pon-q-{{i}}" name="speakerrole[{{i}}]" value="" maxlength="120" placeholder="{{#str}}event_speaker_role, local_oksigeniaeguahe{{/str}}"></div><button class="enlace solapa-quita" type="button" data-solapa-quita hidden>{{#str}}event_speaker_remove, local_oksigeniaeguahe{{/str}}</button></div>{{/emptyspeaker}}
                    </div>
                    <button class="boton terciario pequeno" type="button" data-solapa-mas hidden>{{{i.mas1}}}{{#str}}event_speaker_add, local_oksigeniaeguahe{{/str}}</button>
                </fieldset>
                {{#hascourses}}
                <fieldset class="acto-cursos-campo">
                    <legend>{{#str}}event_audience, local_oksigeniaeguahe{{/str}} <span class="secundario">{{#str}}event_audience_help, local_oksigeniaeguahe{{/str}}</span></legend>
                    <div class="acto-cursos">{{#courses}}<span class="tipo-acto"><input class="oculto" type="checkbox" id="curso-acto-{{n}}" name="audience[]" value="{{value}}"{{#checked}} checked{{/checked}}><label class="pastilla-r" for="curso-acto-{{n}}">{{name}}</label></span>{{/courses}}</div>
                </fieldset>
                {{/hascourses}}
                <fieldset class="acto-entrada">
                    <legend>{{#str}}event_entry, local_oksigeniaeguahe{{/str}}</legend>
                    <div class="acto-cursos"><span class="tipo-acto"><input class="oculto" type="radio" id="entrada-si" name="free" value="0"{{^free}}{{^freeasks}} checked{{/freeasks}}{{/free}}><label class="pastilla-r" for="entrada-si">{{#str}}event_entry_sign, local_oksigeniaeguahe{{/str}}</label></span><span class="tipo-acto"><input class="oculto" type="radio" id="entrada-libre" name="free" value="1"{{#free}} checked{{/free}}><label class="pastilla-r" for="entrada-libre">{{#str}}event_free, local_oksigeniaeguahe{{/str}}</label></span><span class="tipo-acto"><input class="oculto" type="radio" id="entrada-avisa" name="free" value="2"{{#freeasks}} checked{{/freeasks}}><label class="pastilla-r" for="entrada-avisa">{{#str}}event_free_asks, local_oksigeniaeguahe{{/str}}</label></span></div>
                </fieldset>
            </div>
        </div>
        <section class="acto-resto" aria-labelledby="acto-resto-t" data-sumas="{{sumtexts}}">
            <div class="acto-resto-cab"><h2 id="acto-resto-t">{{#str}}event_rest, local_oksigeniaeguahe{{/str}}</h2><p class="def">{{#str}}event_rest_help, local_oksigeniaeguahe{{/str}}</p></div>
            <details class="acto-plegado" data-plegado="turns"{{#whenerror}} open{{/whenerror}}>
                <summary><h3>{{#str}}panel_event_turns, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{sums.turns}}</span>{{{i.chev}}}</summary>
                <fieldset class="turnos-campo" data-turnos>
                    <legend class="oculto">{{#str}}panel_event_turns, local_oksigeniaeguahe{{/str}}</legend>
                    <p class="def">{{#str}}panel_event_turns_help, local_oksigeniaeguahe{{/str}}</p>
                    {{#hasslots}}
                    <div class="tira-turnos" aria-hidden="true" data-tira>
                        <div class="tira-dia">{{#slots}}<span class="tira-turno" style="inset-inline-start: {{left}}%; width: {{width}}%" data-tira-turno="{{i}}"><b>{{n}}</b></span>{{/slots}}</div>
                        <div class="tira-horas">{{#strip.ticks}}<span style="inset-inline-start: {{left}}%">{{text}}</span>{{/strip.ticks}}</div>
                    </div>
                    {{/hasslots}}
                    <ol class="turnos-lista" data-turnos-lista>
                        {{#slots}}
                        <li class="turno-fila" data-turno-fila="{{i}}">
                            <input type="hidden" name="slotid[{{i}}]" value="{{id}}">
                            <span class="num-paso" aria-hidden="true">{{n}}</span>
                            <div class="campo"><label for="t-hora-{{i}}">{{#str}}panel_turn_hour, local_oksigeniaeguahe, {{n}}{{/str}}</label><input id="t-hora-{{i}}" type="{{#h24}}text{{/h24}}{{^h24}}time{{/h24}}"{{#h24}} inputmode="numeric" maxlength="5" placeholder="hh:mm" autocomplete="off"{{/h24}}{{^h24}} step="900"{{/h24}} data-hora name="slotstart[{{i}}]" value="{{start}}"></div>
                            <div class="campo"><label for="t-min-{{i}}">{{#str}}event_slot_minutes, local_oksigeniaeguahe{{/str}}</label><input id="t-min-{{i}}" type="number" min="5" step="5" name="slotminutes[{{i}}]" value="{{minutes}}" inputmode="numeric"></div>
                            <div class="campo"><label for="t-cap-{{i}}">{{#str}}panel_turn_capacity, local_oksigeniaeguahe{{/str}}</label><input id="t-cap-{{i}}" type="number" min="0" name="slotcapacity[{{i}}]" value="{{capacity}}" inputmode="numeric"></div>
                            <span class="turno-apuntados">{{signed}}</span>
                            {{#canremove}}<button class="boton terciario pequeno" type="submit" name="removeslot" value="{{i}}">{{{i.borrar}}}<span>{{#str}}panel_turn_remove, local_oksigeniaeguahe{{/str}}</span></button>{{/canremove}}
                            {{^canremove}}<span class="def turno-guarda">{{keepwhy}}</span>{{/canremove}}
                        </li>
                        {{/slots}}
                        {{^hasslots}}<li class="sin-turnos secundario">{{#str}}panel_turns_none, local_oksigeniaeguahe{{/str}}</li>{{/hasslots}}
                    </ol>
                    {{#emptyslot}}
                    <template data-turno-molde>
                        <li class="turno-fila nueva" data-turno-fila="__i__">
                            <input type="hidden" name="slotid[__i__]" value="0">
                            <span class="num-paso" aria-hidden="true">__n__</span>
                            <div class="campo"><label for="t-hora-__i__">{{#str}}panel_turn_hour, local_oksigeniaeguahe, __n__{{/str}}</label><input id="t-hora-__i__" type="{{#h24}}text{{/h24}}{{^h24}}time{{/h24}}"{{#h24}} inputmode="numeric" maxlength="5" placeholder="hh:mm" autocomplete="off"{{/h24}}{{^h24}} step="900"{{/h24}} data-hora name="slotstart[__i__]" value=""></div>
                            <div class="campo"><label for="t-min-__i__">{{#str}}event_slot_minutes, local_oksigeniaeguahe{{/str}}</label><input id="t-min-__i__" type="number" min="5" step="5" name="slotminutes[__i__]" value="{{minutes}}" inputmode="numeric"></div>
                            <div class="campo"><label for="t-cap-__i__">{{#str}}panel_turn_capacity, local_oksigeniaeguahe{{/str}}</label><input id="t-cap-__i__" type="number" min="0" name="slotcapacity[__i__]" value="" inputmode="numeric"></div>
                            <span class="turno-apuntados">{{#str}}panel_turn_new, local_oksigeniaeguahe{{/str}}</span>
                        </li>
                    </template>
                    {{/emptyslot}}
                    <div class="acciones">
                        <button class="boton secundario pequeno" type="submit" name="addslot" value="1" data-otro-turno>{{{i.mas1}}}{{#str}}panel_turn_add, local_oksigeniaeguahe{{/str}}</button>
                    </div>
                </fieldset>
            </details>
            <details class="acto-plegado" data-plegado="fit">
                <summary><h3>{{#str}}panel_event_fit, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{sums.fit}}</span>{{{i.chev}}}</summary>
                <div class="rejilla-2">
                    <div class="campo"><label for="acto-aforo">{{#str}}event_capacity, local_oksigeniaeguahe{{/str}}</label><input id="acto-aforo" type="number" min="0" name="capacity" value="{{capacity}}" inputmode="numeric" aria-describedby="acto-aforo-a"><span class="ayuda" id="acto-aforo-a">{{#str}}panel_capacity_help, local_oksigeniaeguahe{{/str}}</span></div>
                    {{#load}}<div class="carga"><span class="secundario">{{#str}}panel_now, local_oksigeniaeguahe{{/str}}</span><b>{{text}}</b><span class="barra-aforo" aria-hidden="true"><i style="width: {{percent}}%"></i></span></div>{{/load}}
                </div>
                <label class="casilla"><input type="checkbox" name="open" value="1"{{#open}} checked{{/open}}><span>{{#str}}event_open, local_oksigeniaeguahe{{/str}}</span></label>
            </details>
            <details class="acto-plegado" data-plegado="hosts">
                <summary><h3>{{#str}}event_hosts, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{sums.hosts}}</span>{{{i.chev}}}</summary>
                <p class="def">{{#str}}panel_hosts_help, local_oksigeniaeguahe{{/str}}</p>
                {{^hashosts}}<p class="secundario">{{nohosts}}</p>{{/hashosts}}
                {{#volunteers}}<p class="voluntarias">{{text}} <a class="enlace" href="{{url}}">{{#str}}panel_volunteers_see, local_oksigeniaeguahe{{/str}}</a></p>{{/volunteers}}
                <div class="anfitriones">
                    {{#hosts}}<label class="anfitrion"><input type="checkbox" name="hosts[]" value="{{id}}"{{#checked}} checked{{/checked}} data-vivo-anfitrion="{{first}}"><span class="anfitrion-cara">{{> local_oksigeniaeguahe/panel_face }}</span><span><b>{{name}}</b><span class="secundario">{{role}}</span></span></label>{{/hosts}}
                </div>
            </details>
            {{#parkingon}}<details class="acto-plegado" data-plegado="parking">
                <summary><h3>{{#str}}event_parking_title, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{#parking}}{{#str}}event_parking_on, local_oksigeniaeguahe{{/str}}{{/parking}}{{^parking}}{{#str}}event_parking_off, local_oksigeniaeguahe{{/str}}{{/parking}}</span>{{{i.chev}}}</summary>
                <div class="acto-aparcar"><label class="casilla"><input type="checkbox" name="parking" value="1"{{#parking}} checked{{/parking}}><span>{{#str}}event_parking, local_oksigeniaeguahe{{/str}}</span></label><img src="{{parkingimg}}" alt="{{#str}}panel_event_parking_img, local_oksigeniaeguahe{{/str}}" height="64" loading="lazy"></div>
            </details>{{/parkingon}}
            <details class="acto-plegado" data-plegado="asks">
                <summary><h3>{{#str}}panel_event_questions, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{sums.asks}}</span>{{{i.chev}}}</summary>
                <div class="campo"><label for="acto-form">{{#str}}event_form, local_oksigeniaeguahe{{/str}}</label><select id="acto-form" name="formid">{{#forms}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/forms}}</select><span class="ayuda">{{#str}}panel_event_form_help, local_oksigeniaeguahe{{/str}}</span></div>
                {{#hasformquestions}}<ol class="preguntas-acto">{{#formquestions}}<li>{{q}}</li>{{/formquestions}}</ol><a class="enlace" href="{{formurl}}">{{{i.lapiz}}}{{#str}}panel_event_form_change, local_oksigeniaeguahe{{/str}}</a>{{/hasformquestions}}
            </details>
            <details class="acto-plegado" data-plegado="after">
                <summary><h3>{{#str}}panel_event_after, local_oksigeniaeguahe{{/str}}</h3><span class="acto-suma" data-suma>{{sums.after}}</span>{{{i.chev}}}</summary>
                <div class="campo"><label for="acto-encuesta">{{#str}}event_survey, local_oksigeniaeguahe{{/str}}</label><select id="acto-encuesta" name="survey">{{#surveys}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/surveys}}</select><span class="ayuda">{{#str}}panel_event_survey_help, local_oksigeniaeguahe{{/str}}</span></div>
                {{#surveyurl}}<a class="enlace" href="{{surveyurl}}">{{{i.lapiz}}}{{#str}}panel_event_survey_change, local_oksigeniaeguahe{{/str}}</a>{{/surveyurl}}
            </details>
        </section>
        {{^notice}}
        <div class="guardar-pie">
            <div class="acciones">
                <button class="boton principal" type="submit" name="save" value="1">{{{i.check}}}{{#isnew}}{{#str}}panel_event_create, local_oksigeniaeguahe{{/str}}{{/isnew}}{{^isnew}}{{#str}}savechanges{{/str}}{{/isnew}}</button>
                <a class="boton terciario" href="{{head.back.url}}">{{#str}}cancel{{/str}}</a>
            </div>
        </div>
        {{/notice}}
    </form>
</div>
