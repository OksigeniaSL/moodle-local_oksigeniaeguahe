{{!
    @template local_oksigeniaeguahe/panel_agenda_undo

    What was just said of one or several appointments, and how to take it back.

    Example context (json):
    {"undo": "a1b2", "markurl": "#", "sesskey": "abc"}
}}
<form class="agenda-hecho" method="post" action="{{markurl}}" data-hecho{{^undo}} hidden{{/undo}}>
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="undo"><input type="hidden" name="key" value="{{undo}}">
    <span role="status" data-hecho-texto>{{undotext}}</span>
    <button class="boton terciario pequeno" type="submit">{{#str}}agenda_undo, local_oksigeniaeguahe{{/str}}</button>
</form>
