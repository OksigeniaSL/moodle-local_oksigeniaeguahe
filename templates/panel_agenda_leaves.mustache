{{!
    @template local_oksigeniaeguahe/panel_agenda_leaves

    The two leaves of open days and visits: the week, with the appointments, and the acts.

    Example context (json):
    {"weekurl": "#", "actsurl": "#", "isweek": true}
}}
<nav class="agenda-hojas" aria-label="{{#str}}tab_events, local_oksigeniaeguahe{{/str}}"><a href="{{weekurl}}"{{#isweek}} aria-current="page"{{/isweek}}>{{#str}}agenda_week, local_oksigeniaeguahe{{/str}}</a><a href="{{actsurl}}"{{^isweek}} aria-current="page"{{/isweek}}>{{#str}}agenda_acts, local_oksigeniaeguahe{{/str}}</a></nav>
