{{!
    @template local_oksigeniaeguahe/panel_appts

    The appointments of a family, on its file: two that may be one, to be said by a person; those to come and those past, each
    with what is known; and giving it another.

    Example context (json):
    {
        "giveurl": "#", "sesskey": "abc", "markurl": "#", "hasappointments": true, "appointments": [{"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}],
        "hastwins": true, "canact": true, "twins": [{"daystext": "2 días entre una y otra", "action": "#", "sesskey": "abc", "a": {"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}, "b": {"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}, "keepa": "s4,n9", "keepb": "n9,s4", "apart": "s4,n9"}]
    }
}}
<section class="apartado sus-citas" aria-labelledby="sus-citas-t" data-agenda>
    <header><h2 id="sus-citas-t">{{#str}}agenda_yours, local_oksigeniaeguahe{{/str}}</h2>{{#giveurl}}<a class="boton secundario pequeno" href="{{giveurl}}">{{{i.mas1}}}{{#str}}give_title, local_oksigeniaeguahe{{/str}}</a>{{/giveurl}}</header>
    {{#twins}}
    <div class="citas-gemelas" role="group" aria-label="{{#str}}agenda_twin, local_oksigeniaeguahe{{/str}}">
        <p><b>{{#str}}agenda_twin, local_oksigeniaeguahe{{/str}}</b> <span class="secundario">{{daystext}}</span></p>
        <div class="gemelas">
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="keep"><input type="hidden" name="pair" value="{{keepa}}">{{#a}}<span class="gemela"><b>{{day}}</b><span class="secundario">{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}} · {{#sourcename}}{{sourcename}}{{/sourcename}}{{^sourcename}}{{#str}}agenda_given, local_oksigeniaeguahe{{/str}}{{/sourcename}}</span></span>{{/a}}<button class="boton secundario pequeno" type="submit">{{#str}}agenda_this, local_oksigeniaeguahe{{/str}}</button></form>
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="keep"><input type="hidden" name="pair" value="{{keepb}}">{{#b}}<span class="gemela"><b>{{day}}</b><span class="secundario">{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}} · {{#sourcename}}{{sourcename}}{{/sourcename}}{{^sourcename}}{{#str}}agenda_given, local_oksigeniaeguahe{{/str}}{{/sourcename}}</span></span>{{/b}}<button class="boton secundario pequeno" type="submit">{{#str}}agenda_this, local_oksigeniaeguahe{{/str}}</button></form>
        </div>
        <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="apart"><input type="hidden" name="pair" value="{{apart}}"><button class="enlace" type="submit">{{#str}}agenda_two, local_oksigeniaeguahe{{/str}}</button></form>
    </div>
    {{/twins}}
    {{#appointments}}
    <div class="su-cita su-cita-{{state}}" data-cita="{{id}}">
        <span class="su-cita-dia"{{#isasked}} aria-hidden="true"{{/isasked}}>{{#isasked}}<b>?</b>{{/isasked}}{{^isasked}}<small>{{wday}}</small><b>{{dnum}}</b><small>{{mon}}</small>{{/isasked}}</span>
        <span class="su-cita-que"><b>{{#isasked}}{{#str}}agenda_asked_one, local_oksigeniaeguahe{{/str}}{{/isasked}}{{^isasked}}{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}}{{#acttitle}} · {{acttitle}}{{/acttitle}}{{/isasked}}</b><span class="secundario">{{place}}{{#guide}}{{#place}} · {{/place}}{{first}}{{/guide}}{{#sourcename}} {{sourcename}}{{/sourcename}}</span>{{^isasked}}<span class="su-cita-estado">{{statename}}</span>{{/isasked}}
        {{#canact}}{{#isunknown}}<form class="cita-marcas" method="post" action="{{markurl}}" data-marca><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="mark"><input type="hidden" name="ids[]" value="{{id}}"><button type="submit" name="state" value="came">{{{i.check}}}<span>{{#str}}agenda_came, local_oksigeniaeguahe{{/str}}</span></button><button type="submit" name="state" value="notcame"><span>{{#str}}agenda_notcame, local_oksigeniaeguahe{{/str}}</span></button></form>{{/isunknown}}{{/canact}}</span>
        <span class="su-cita-mandos">{{#moveurl}}{{#isasked}}<a class="boton secundario pequeno" href="{{moveurl}}">{{#str}}agenda_giveday, local_oksigeniaeguahe{{/str}}</a>{{/isasked}}{{^isasked}}<a class="enlace" href="{{moveurl}}">{{#str}}agenda_change, local_oksigeniaeguahe{{/str}}</a>{{/isasked}}{{/moveurl}}</span>
    </div>
    {{/appointments}}
    {{^hasappointments}}<p class="secundario">{{#str}}agenda_nocitas, local_oksigeniaeguahe{{/str}}</p>{{/hasappointments}}
</section>
