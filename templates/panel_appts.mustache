{{!
    @template local_oksigeniaeguahe/panel_appts

    The appointments of a family, on its file: two that may be one, to be said by a person; those to come and those past, each
    with what is known; and giving it another.

    Example context (json):
    {
        "hasmoved": false, "moved": [], "giveurl": "#", "sesskey": "abc", "markurl": "#", "hasappointments": true, "appointments": [{"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}],
        "hasolder": false, "older": [], "hastwins": true, "canact": true, "twins": [{"daystext": "2 días entre una y otra", "action": "#", "sesskey": "abc", "a": {"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}, "b": {"id": "s4", "hour": "10:00", "hourend": "10:45", "dayonly": false, "adults": "Ana Ruiz", "children": [{"tag": "Leo", "course": "Infantil 3 años"}], "kind": "visit", "title": "", "place": "Secretaría", "guide": {"first": "Lucía", "picture": "", "initials": "LM"}, "state": "unknown", "statename": "Sin anotar si vinieron", "unknown": true, "came": false, "notcame": false, "isact": false, "source": "eguahe", "sourcename": "", "people": 2, "url": "#", "moveurl": "#", "offurl": "#", "twin": false}, "keepa": "s4,n9", "keepb": "n9,s4", "apart": "s4,n9"}]
    }
}}
<section class="apartado sus-citas" aria-labelledby="sus-citas-t" data-agenda>
    <header><h2 id="sus-citas-t">{{#str}}agenda_yours, local_oksigeniaeguahe{{/str}}</h2>{{#giveurl}}<a class="boton secundario pequeno" href="{{giveurl}}">{{{i.mas1}}}{{#str}}give_title, local_oksigeniaeguahe{{/str}}</a>{{/giveurl}}</header>
    {{#hasmoved}}{{> local_oksigeniaeguahe/panel_calsync }}{{/hasmoved}}
    {{#twins}}
    <div class="citas-gemelas" role="group" aria-label="{{#str}}agenda_twin, local_oksigeniaeguahe{{/str}}">
        <p><b>{{#str}}agenda_twin, local_oksigeniaeguahe{{/str}}</b> <span class="secundario">{{daystext}}</span></p>
        <div class="gemelas">
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="keep"><input type="hidden" name="pair" value="{{keepa}}">{{#a}}<span class="gemela"><b>{{day}}</b><span class="secundario">{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}} · {{#sourcename}}{{sourcename}}{{/sourcename}}{{^sourcename}}{{#str}}agenda_given, local_oksigeniaeguahe{{/str}}{{/sourcename}}</span></span>{{/a}}<button class="boton secundario pequeno" type="submit">{{#str}}agenda_this, local_oksigeniaeguahe{{/str}}</button></form>
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="keep"><input type="hidden" name="pair" value="{{keepb}}">{{#b}}<span class="gemela"><b>{{day}}</b><span class="secundario">{{#dayonly}}{{#str}}agenda_nohour, local_oksigeniaeguahe{{/str}}{{/dayonly}}{{^dayonly}}{{hour}}{{/dayonly}} · {{#sourcename}}{{sourcename}}{{/sourcename}}{{^sourcename}}{{#str}}agenda_given, local_oksigeniaeguahe{{/str}}{{/sourcename}}</span></span>{{/b}}<button class="boton secundario pequeno" type="submit">{{#str}}agenda_this, local_oksigeniaeguahe{{/str}}</button></form>
        </div>
        <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="apart"><input type="hidden" name="pair" value="{{apart}}"><button class="enlace" type="submit">{{#str}}agenda_two, local_oksigeniaeguahe{{/str}}</button></form>
    </div>
    {{/twins}}
    {{#appointments}}{{> local_oksigeniaeguahe/panel_appt }}{{/appointments}}
    {{#hasolder}}<details class="avisos-antes citas-antes"><summary>{{#str}}agenda_yours_before, local_oksigeniaeguahe{{/str}}{{{i.chev}}}</summary>{{#older}}{{> local_oksigeniaeguahe/panel_appt }}{{/older}}</details>{{/hasolder}}
    {{^hasappointments}}<p class="secundario">{{#str}}agenda_nocitas, local_oksigeniaeguahe{{/str}}</p>{{/hasappointments}}
</section>
