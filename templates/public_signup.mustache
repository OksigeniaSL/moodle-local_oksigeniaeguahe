        "pub_submit": "Apuntarnos", "pub_sending": "Apuntándolos…", "pub_no_place": "Apuntarse no es pedir plaza."
    }
}}
<section class="pared" aria-labelledby="titulo">
    <div class="saludo-arriba">
        {{#kicker}}<p class="antetitulo">{{kicker}}</p>{{/kicker}}
        <h1 class="titular" id="titulo">{{headline}}</h1>
    </div>
    <div class="riel" aria-hidden="true"></div>
    <div class="heroe-ancho">
        {{#pegs}}{{> local_oksigeniaeguahe/public_pegs }}{{/pegs}}
        <div class="bajo-riel">
            {{#children}}
            <div class="dos nino" data-i="{{index}}"{{#hidden}} hidden{{/hidden}}>
                <div class="campo{{#nameerror}} mal{{/nameerror}}">
                    <label for="c{{index}}name">{{namelabel}}</label>
                    <input id="c{{index}}name" name="c{{index}}name" form="eg-form" value="{{name}}" autocomplete="off" data-child="{{index}}"{{#nameerror}} aria-invalid="true" aria-describedby="c{{index}}name-error"{{/nameerror}}>
                    {{#nameerror}}<p class="error" id="c{{index}}name-error">{{{i.alert}}}{{nameerror}}</p>{{/nameerror}}
                </div>
                <div class="campo">
                    <label for="c{{index}}tag">{{pub_tagname}} <span class="opc">{{pub_if_you_wish}}</span></label>
                    <input id="c{{index}}tag" name="c{{index}}tag" form="eg-form" value="{{tag}}" placeholder="{{tagplaceholder}}" autocomplete="off" data-child="{{index}}" aria-describedby="c{{index}}tag-help">
                    <p class="ayuda-campo" id="c{{index}}tag-help">{{pub_tagname_hint}}</p>
                </div>
            </div>
            {{/children}}
            {{#canaddchild}}<button type="button" class="anadir-nino" data-add="nino">{{{i.plus}}}{{pub_add_child}}</button>{{/canaddchild}}
        </div>
    </div>
</section>

<div class="inscripcion">
    <aside class="resumen-acto">
        {{#isform}}
        <p class="cuando"><span>{{formside}}</span></p>
        <p class="entradilla">{{formlead}}</p>
        {{/isform}}
        {{^isform}}
        {{#tailored}}
        <p class="cuando"><span>{{pub_tailored_title}}</span></p>
        <p class="entradilla">{{pub_tailored_lead}}</p>
        {{/tailored}}
        {{^tailored}}
        <p class="cuando"><span>{{weekday}}</span>{{daymonth}}</p>
        <p class="entradilla">{{hours}}{{#place}} · {{place}}{{/place}}{{#address}}, {{address}}{{/address}}.</p>
        {{/tailored}}
        {{/isform}}
        {{#welcome}}<p class="muted">{{welcome}}</p>{{/welcome}}
        {{#hashosts}}
        <div class="caras-mini">
            <span class="pila">{{#hosts}}{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="ini" aria-hidden="true">{{initials}}</span>{{/photo}}{{/hosts}}</span>
            <span>{{willreceive}}</span>
        </div>
        {{/hashosts}}
    </aside>

    <form id="eg-form" method="post" action="{{action}}" novalidate>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#haserrors}}
        <div class="resumen" role="alert" tabindex="-1" id="resumen">
            <b>{{errortitle}}</b>
            <ul>{{#errorlist}}<li><a href="#{{field}}">{{message}}</a></li>{{/errorlist}}</ul>
        </div>
        {{/haserrors}}

        {{#hasoffers}}
        <fieldset class="cursos">
            <legend data-one="{{courselegend}}" data-many="{{courselegendmany}}">{{#singlechild}}{{courselegend}}{{/singlechild}}{{^singlechild}}{{courselegendmany}}{{/singlechild}}</legend>
            {{#children}}
            <div class="campo curso{{#offererror}} mal{{/offererror}}" data-i="{{index}}"{{#hidden}} hidden{{/hidden}}>
                <label for="c{{index}}offer"{{#singlechild}} class="oculto"{{/singlechild}} data-course-label="{{index}}" data-with="{{coursewith}}" data-without="{{coursewithout}}">{{courselabel}}</label>
                <select id="c{{index}}offer" name="c{{index}}offer"{{#offererror}} aria-invalid="true" aria-describedby="c{{index}}offer-error"{{/offererror}}>
                    <option value="0">{{pub_offer_unknown}}</option>
                    {{#offers}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/offers}}
                </select>
                {{#offererror}}<p class="error" id="c{{index}}offer-error">{{{i.alert}}}{{offererror}}</p>{{/offererror}}
            </div>
            {{/children}}
        </fieldset>
        {{/hasoffers}}

        <fieldset>
            <legend>{{pub_you}}</legend>
            <p class="ayuda">{{pub_you_hint}}</p>
            {{#adults}}
            <div class="adulto" data-i="{{index}}"{{#hidden}} hidden{{/hidden}}>
                <div class="dos">
                    {{#fields}}
                    <div class="campo{{#invalid}} mal{{/invalid}}">
                        <label for="{{name}}">{{label}}</label>
                        <input id="{{name}}" name="{{name}}" type="{{type}}" value="{{value}}"{{#autocomplete}} autocomplete="{{autocomplete}}"{{/autocomplete}}{{#inputmode}} inputmode="{{inputmode}}"{{/inputmode}}{{#invalid}} aria-invalid="true" aria-describedby="{{name}}-error"{{/invalid}}>
                        {{#error}}<p class="error" id="{{name}}-error">{{{i.alert}}}{{error}}</p>{{/error}}
                    </div>
                    {{/fields}}
                </div>
            </div>
            {{/adults}}
            {{#canaddadult}}<button type="button" class="anadir" data-add="adulto">{{{i.plus}}}{{pub_another_adult}}</button>{{/canaddadult}}
        </fieldset>

        {{#hasfields}}
        <fieldset class="preguntas">
            {{> local_oksigeniaeguahe/public_questions }}
        </fieldset>
        {{/hasfields}}

        {{#tailored}}
        <fieldset id="when">
            <legend>{{pub_when_suits}}</legend>
            <p class="ayuda">{{pub_when_suits_hint}}</p>
            <div class="fichas">
                {{#days}}<label class="ficha"><input type="checkbox" name="day[{{value}}]" value="1"{{#checked}} checked{{/checked}}><span class="marca">{{{i.check}}}</span>{{name}}</label>{{/days}}
            </div>
            <div class="fichas">
                {{#periods}}<label class="ficha"><input type="checkbox" name="period[{{value}}]" value="1"{{#checked}} checked{{/checked}}><span class="marca">{{{i.check}}}</span>{{name}}</label>{{/periods}}
            </div>
        </fieldset>
        {{/tailored}}

        {{#hasslots}}
        <fieldset id="slot"{{#sloterror}} class="mal" aria-describedby="slot-error"{{/sloterror}}>
            <legend>{{pub_slot}}</legend>
            <div class="turnos">
                {{#slots}}
                <label class="turno{{#disabled}} completo{{/disabled}}">
                    <input type="radio" name="slot" value="{{id}}"{{#checked}} checked{{/checked}}{{#disabled}} disabled{{/disabled}}>
                    <span class="punto"></span>
                    <b>{{when}}</b>
                    <span class="quedan">{{left}}</span>
                </label>
                {{/slots}}
            </div>
            {{#sloterror}}<p class="error" id="slot-error">{{{i.alert}}}{{sloterror}}</p>{{/sloterror}}
        </fieldset>
        {{/hasslots}}

        {{#isother}}
        <fieldset>
            <legend>{{pub_incentre}}</legend>
            <div class="fichas">
                <label class="ficha"><input type="radio" name="incentre" value="yes"{{#incentreyes}} checked{{/incentreyes}}><span class="marca">{{{i.check}}}</span>{{pub_incentre_yes}}</label>
                <label class="ficha"><input type="radio" name="incentre" value="no"{{#incentreno}} checked{{/incentreno}}><span class="marca">{{{i.check}}}</span>{{pub_incentre_no}}</label>
            </div>
        </fieldset>
        {{/isother}}

        {{#hasmore}}
        <fieldset>
            <legend>{{pub_more}} <span class="opc">{{pub_if_you_wish}}</span></legend>
            {{#askpeople}}
            <div class="campo{{#peopleerror}} mal{{/peopleerror}}">
                <label for="people">{{pub_people}}</label>
                <div class="paso">
                    <button type="button" data-step="-1" aria-label="−" hidden>−</button>
                    <input id="people" name="people" type="number" inputmode="numeric" min="1" max="20" value="{{people}}"{{#peopleerror}} aria-invalid="true" aria-describedby="people-error"{{/peopleerror}}>
                    <button type="button" data-step="1" aria-label="+" hidden>+</button>
                </div>
                {{#peopleerror}}<p class="error" id="people-error">{{{i.alert}}}{{peopleerror}}</p>{{/peopleerror}}
            </div>
            {{/askpeople}}
            <div class="dos">
                {{#askplace}}
                <div class="campo">
                    <label for="municipality">{{pub_where}}</label>
                    <select id="municipality" name="municipality">
                        <option value="">{{pub_where_choose}}</option>
                        {{#places}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/places}}
                        <option value="other"{{#otherselected}} selected{{/otherselected}}>{{pub_where_other}}</option>
                        <option value="moving"{{#movingselected}} selected{{/movingselected}}>{{pub_where_moving}}</option>
                    </select>
                </div>
                {{/askplace}}
                {{#askheard}}
                <div class="campo">
                    <label for="heardfrom">{{pub_heardfrom}}</label>
                    <select id="heardfrom" name="heardfrom">
                        <option value="">{{pub_where_choose}}</option>
                        {{#heard}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/heard}}
                    </select>
                </div>
                {{/askheard}}
            </div>
            {{#askplace}}
            <div class="campo lejos"{{#lejoshidden}} hidden{{/lejoshidden}}>
                <label for="municipalityother" data-other="{{lejosother}}" data-moving="{{lejosmoving}}">{{lejoslabel}}</label>
                <input id="municipalityother" name="municipalityother" type="text" autocomplete="address-level2" value="{{municipalityother}}">
            </div>
            {{/askplace}}
            {{#asksiblings}}
            <fieldset class="hermanos-luego">
                <legend>{{siblingstitle}} <span class="opc">{{pub_if_you_wish}}</span></legend>
                <p class="ayuda-campo">{{siblingshelp}}</p>
                {{#siblings}}
                <div class="dos hermano"{{#hidden}} hidden{{/hidden}}>
                    <div class="campo"><label for="s{{index}}name">{{siblingname}}</label><input id="s{{index}}name" name="s{{index}}name" value="{{name}}" autocomplete="off"></div>
                    <div class="campo"><label for="s{{index}}year">{{siblingyear}}</label><select id="s{{index}}year" name="s{{index}}year"><option value="0">—</option>{{#years}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>{{/years}}</select></div>
                </div>
                {{/siblings}}
                <button type="button" class="anadir" data-add="hermano">{{{i.plus}}}{{siblingadd}}</button>
            </fieldset>
            {{/asksiblings}}
            {{#askmessage}}
            <div class="campo">
                <label for="message">{{pub_message}}</label>
                <textarea id="message" name="message" aria-describedby="message-hint">{{message}}</textarea>
                <p class="ayuda-campo" id="message-hint">{{pub_message_hint}}</p>
            </div>
            {{/askmessage}}
        </fieldset>
        {{/hasmore}}

        <fieldset id="channels"{{#channelerror}} class="mal" aria-describedby="channels-error"{{/channelerror}}>
            <legend>{{pub_channels}}</legend>
            <p class="ayuda">{{pub_channels_hint}}</p>
            <div class="fichas">
                {{#channels}}<label class="ficha"><input type="checkbox" name="{{name}}" value="1"{{#checked}} checked{{/checked}}><span class="marca">{{{i.check}}}</span>{{label}}</label>{{/channels}}
            </div>
            {{#channelerror}}<p class="error" id="channels-error">{{{i.alert}}}{{channelerror}}</p>{{/channelerror}}
        </fieldset>

        <div class="capa">
            <b>{{pub_privacy_link}}</b>
            <dl>{{#info}}<div><dt>{{label}}</dt><dd>{{text}}</dd></div>{{/info}}</dl>
            <a href="{{privacyurl}}">{{pub_info_more}}</a>
        </div>

        <div class="enviar">
            <div class="robot" id="altcha">
                <altcha-widget challenge="{{altchaurl}}" language="{{altchalang}}" configuration="{{altchaconfig}}"></altcha-widget>
            </div>
            {{#altchaerror}}<p class="error">{{{i.alert}}}{{altchaerror}}</p>{{/altchaerror}}
            {{#formerror}}<p class="error" role="alert">{{{i.alert}}}{{formerror}}</p>{{/formerror}}
            {{#preview}}<p class="error" role="note">{{previewnote}}</p>{{/preview}}
            <button class="boton principal ancho" type="submit" data-sending="{{pub_sending}}"{{#preview}} disabled{{/preview}}>{{pub_submit}}</button>
            <p class="nota-plaza">{{pub_no_place}}</p>
        </div>
    </form>
</div>
<script type="module" src="{{base}}altcha/altcha.min.js?v={{version}}"></script>
{{#altchai18n}}<script type="module" src="{{base}}altcha/i18n-{{altchai18n}}.js?v={{version}}"></script>{{/altchai18n}}
