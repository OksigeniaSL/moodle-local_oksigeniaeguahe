        "courselegendmany": "Quién vendría", "pub_offer_unknown": "Aún no lo sabemos",
        "pub_you": "¿Y ustedes?", "pub_you_hint": "Basta con un móvil o un correo.",
        "adults": [{"index": 0, "hidden": false, "fields": [{"name": "a0first", "label": "Nombre", "value": "",
            "type": "text", "autocomplete": "given-name", "inputmode": "", "error": "", "invalid": false}]}],
        "canaddadult": true, "pub_another_adult": "Añadir a otro adulto",
        "isform": false, "kicker": "Jornada de puertas abiertas", "headline": "Vengan a conocernos", "formlead": "",
        "formside": "", "fields": [], "hasfields": false, "askplace": true, "askheard": true, "askmessage": true,
        "askincentre": false, "askpeople": true, "hasmore": true, "preview": false, "previewnote": "",
        "tailored": false, "days": [], "periods": [], "pub_when_suits": "¿Cuándo les viene bien?", "pub_when_suits_hint": "",
        "pub_tailored_title": "Cuando les venga bien", "pub_tailored_lead": "",
        "hasslots": true, "pub_slot": "Elijan su turno", "sloterror": "",
        "slots": [{"id": 3, "when": "10:00–11:00", "left": "quedan 8 sitios", "disabled": false, "checked": false}],
        "isother": false, "pub_incentre": "¿Ya tienen a alguien en el centro?", "pub_incentre_yes": "Sí",
        "pub_incentre_no": "Todavía no", "incentreyes": false, "incentreno": false,
        "pub_more": "Unas cosas más", "pub_people": "Personas que vendrán", "people": 2, "peopleerror": "",
        "pub_where": "¿Dónde viven?", "pub_where_choose": "Elijan", "hasplaces": true,
        "places": [{"value": "28065", "name": "Getafe", "selected": false}], "pub_where_other": "Otro sitio",
        "pub_where_moving": "Nos mudamos a la zona", "otherselected": false, "movingselected": false,
