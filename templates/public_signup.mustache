        "weekday": "Sábado", "daymonth": "21 de noviembre", "hours": "De 10:00 a 13:00", "place": "Entrada principal",
        "address": "Calle de ejemplo 1", "welcome": "Les enseñamos el centro.", "hashosts": true,
        "hosts": [{"photo": "", "initials": "LM"}], "willreceive": "Los recibirá Lucía",
