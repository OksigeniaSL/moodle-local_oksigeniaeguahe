{{!
    @template local_oksigeniaeguahe/public_field

    One field of a public form: its label, the field, and its error under it, tied together for screen readers.

    Example context (json):
    {"name": "a0phone", "label": "Teléfono", "value": "", "type": "tel", "autocomplete": "tel", "required": false,
     "error": "Ese teléfono no parece completo.", "invalid": true}
}}
<div class="eg-field">
    <label for="{{name}}">{{label}}</label>
    <input id="{{name}}" name="{{name}}" type="{{type}}" value="{{value}}"{{#autocomplete}} autocomplete="{{autocomplete}}"{{/autocomplete}}{{#required}} required{{/required}}{{#invalid}} aria-invalid="true" aria-describedby="{{name}}-error"{{/invalid}} spellcheck="false">
    {{#error}}<p class="eg-error" id="{{name}}-error">{{error}}</p>{{/error}}
</div>
