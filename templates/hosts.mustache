{{!
    @template local_oksigeniaeguahe/hosts

    The people of the team and whether the families see them, with their photo, what they do and their line.

    Example context (json):
    {"tabs": [], "haspeople": true, "settingsurl": "#",
     "people": [{"name": "Lucía Medina", "shown": true, "role": "Tutora de Infantil 3 años",
        "says": "Les enseño la clase.", "photo": "", "initials": "LM", "editurl": "#"}]}
}}
<div class="eguahe eguahe-hosts">
    {{> local_oksigeniaeguahe/tabs }}
    <p class="eguahe-quiet">{{#str}}hosts_intro, local_oksigeniaeguahe{{/str}}</p>
    {{#haspeople}}
    <ul class="eguahe-host-list">
        {{#people}}
        <li class="eguahe-host{{^shown}} is-hidden{{/shown}}">
            {{#photo}}<img src="{{photo}}" alt="" class="eguahe-host-photo">{{/photo}}
            {{^photo}}<span class="eguahe-host-photo" aria-hidden="true">{{initials}}</span>{{/photo}}
            <span class="eguahe-host-text">
                <strong>{{name}}</strong>
                {{#shown}}{{#role}}<span>{{role}}</span>{{/role}}{{#says}}<span class="eguahe-quiet">«{{says}}»</span>{{/says}}{{/shown}}
                {{^shown}}<span class="eguahe-quiet">{{#str}}hosts_notshown, local_oksigeniaeguahe{{/str}}</span>{{/shown}}
            </span>
            <a class="btn btn-secondary" href="{{editurl}}">{{#str}}edit{{/str}}</a>
        </li>
        {{/people}}
    </ul>
    {{/haspeople}}
    {{^haspeople}}<p>{{#str}}hosts_noteam, local_oksigeniaeguahe, {{settingsurl}}{{/str}}</p>{{/haspeople}}
</div>
