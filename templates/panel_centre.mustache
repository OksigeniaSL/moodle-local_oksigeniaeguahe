                <summary><h2 id="aj-aspecto-t">{{#str}}panel_how_families_see, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura"><span class="aj-banda-mini" style="{{lightvars}}">{{#logo}}<img src="{{logo}}" alt="" width="22" height="22">{{/logo}}<span>{{name}}</span></span></span></summary>
                <div class="aj-cuerpo">
                    <div class="muestra-color">
                        <div class="muestra-tema muestra-dia" style="{{lightvars}}" data-muestra-tema="claro">
                            <span class="rotulo-p">{{#str}}panel_light, local_oksigeniaeguahe{{/str}}</span>
                            <div class="banda banda-muestra"><span class="etiqueta-b">{{#str}}panel_open_day_word, local_oksigeniaeguahe{{/str}}</span><label class="oculto" for="c-nombre">{{#str}}centre_name, local_oksigeniaeguahe{{/str}}</label><input class="aj-banda-nombre" id="c-nombre" name="name" value="{{name}}" data-vivo-centro autocomplete="off"></div>
                            <div class="pared-muestra"><span class="riel"></span>{{#hanging}}{{> local_oksigeniaeguahe/panel_hanging }}{{/hanging}}<span class="etq">{{hanging.name}}</span><a href="#aj-aspecto" tabindex="-1">{{#str}}panel_a_link, local_oksigeniaeguahe{{/str}}</a></div>
                        </div>
                        <div class="muestra-tema muestra-noche" style="{{darkvars}}" data-muestra-tema="oscuro">
                            <span class="rotulo-p">{{#str}}panel_dark, local_oksigeniaeguahe{{/str}}</span>
                            <div class="banda banda-muestra"><span class="etiqueta-b">{{#str}}panel_open_day_word, local_oksigeniaeguahe{{/str}}</span><p class="acto-n" data-muestra-centro>{{name}}</p></div>
                            <div class="pared-muestra"><span class="riel"></span>{{#hanging}}{{> local_oksigeniaeguahe/panel_hanging }}{{/hanging}}<span class="etq">{{hanging.name}}</span><a href="#aj-aspecto" tabindex="-1">{{#str}}panel_a_link, local_oksigeniaeguahe{{/str}}</a></div>
                        </div>
                    </div>
                    <div class="aj-utiles">
                        <div class="aj-util">
                            <label class="aj-bote" for="c-color"><input id="c-color" type="color" name="colour" value="{{colour}}" data-color-centro><span class="oculto">{{#str}}centre_colour, local_oksigeniaeguahe{{/str}}</span></label>
                            <span class="aj-util-texto"><b>{{#str}}centre_colour, local_oksigeniaeguahe{{/str}}</b><input class="aj-hueco aj-hex" name="colourhex" value="{{colour}}" size="8" aria-label="{{#str}}panel_colour_code, local_oksigeniaeguahe{{/str}}" data-color-hex dir="ltr" spellcheck="false"></span>
                        </div>
                        <div class="aj-util">
                            <input class="archivo-oculto" id="c-logo" type="file" name="logo" accept="image/png,image/svg+xml,image/webp,image/jpeg" required data-envio-solo>
                            <label class="aj-placa-logo" for="c-logo">{{#logo}}<img src="{{logo}}" alt="" width="48" height="48">{{/logo}}{{^logo}}<span aria-hidden="true">{{initial}}</span>{{/logo}}</label>
                            <span class="aj-util-texto"><b>{{#str}}centre_logo, local_oksigeniaeguahe{{/str}}</b><label class="enlace" for="c-logo">{{#logo}}{{#str}}panel_logo_other, local_oksigeniaeguahe{{/str}}{{/logo}}{{^logo}}{{#str}}panel_logo_choose, local_oksigeniaeguahe{{/str}}{{/logo}}</label></span>
                            <button class="boton principal pequeno aj-foto-guardar" type="submit" name="guardar" value="1" formaction="{{action}}#aj-aspecto">{{{i.check}}}{{#str}}panel_photo_save, local_oksigeniaeguahe{{/str}}</button>
                        </div>
                        <div class="aj-util">
                            <input type="hidden" name="logoplate" value="{{#logoplate}}1{{/logoplate}}{{^logoplate}}0{{/logoplate}}">
                            <button class="interruptor" type="submit" name="logoplate" value="{{#logoplate}}0{{/logoplate}}{{^logoplate}}1{{/logoplate}}" formaction="{{action}}#aj-aspecto" aria-pressed="{{#logoplate}}true{{/logoplate}}{{^logoplate}}false{{/logoplate}}" aria-describedby="c-placa-a"><span class="lampara" aria-hidden="true"></span><span>{{#str}}panel_logoplate_short, local_oksigeniaeguahe{{/str}}</span></button>
                            <span class="ayuda" id="c-placa-a">{{#str}}centre_logoplate_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                    </div>
                    <p class="linea-dato frase-color" data-frase-color aria-live="polite">{{colourguard}}</p>
                    <div class="aj-frase con-ayuda">
                        <label for="c-bienvenida">{{#str}}centre_welcome, local_oksigeniaeguahe{{/str}}</label>
                        <span class="aj-cita"><input class="aj-hueco" id="c-bienvenida" name="welcome" value="{{welcome}}" aria-describedby="c-bienvenida-a"></span>
                        <span class="ayuda" id="c-bienvenida-a">{{#str}}centre_welcome_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    {{#hastales}}
                    <div class="aj-frase con-ayuda">
                        <label for="c-cuentos">{{#str}}panel_tales, local_oksigeniaeguahe{{/str}}</label>
                        <select class="aj-hueco" id="c-cuentos" name="library" aria-describedby="c-cuentos-a" data-envio-solo>{{#libraries}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/libraries}}</select>
                        <span class="ayuda" id="c-cuentos-a">{{#str}}panel_tales_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    {{/hastales}}
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-aspecto" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== Address and contact: a visiting card ===== }}
            <details class="apartado aj-plegado" id="aj-contacto">
                <summary><h2 id="aj-contacto-t">{{#str}}panel_contact_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#address}}<span>{{address}}</span>{{/address}}{{#phone}}<span dir="ltr">{{phone}}</span>{{/phone}}{{#email}}<span dir="ltr">{{email}}</span>{{/email}}<span>{{replyread}}</span></span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-visita">
                        <div class="aj-visita-fila"><span class="aj-visita-ic" aria-hidden="true">{{{i.plano}}}</span><label class="oculto" for="c-dir">{{#str}}centre_address, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-dir" name="address" value="{{address}}" placeholder="{{#str}}centre_address, local_oksigeniaeguahe{{/str}}" autocomplete="off"></div>
                        <div class="aj-visita-fila aj-visita-dos">
                            <span class="aj-visita-par"><span class="aj-visita-ic" aria-hidden="true">{{{i.telefono}}}</span><label class="oculto" for="c-tel">{{#str}}centre_phone, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-tel" type="tel" name="phone" value="{{phone}}" placeholder="{{#str}}centre_phone, local_oksigeniaeguahe{{/str}}" size="16" dir="ltr"></span>
                            <span class="aj-visita-par"><span class="aj-visita-ic" aria-hidden="true">{{{i.correo}}}</span><label class="oculto" for="c-correo">{{#str}}centre_email, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-correo" type="email" name="email" value="{{email}}" placeholder="{{#str}}centre_email, local_oksigeniaeguahe{{/str}}" size="26" dir="ltr"></span>
                        </div>
                        <div class="aj-visita-llegar con-ayuda">
                            <label for="c-llegar">{{#str}}panel_how_to_arrive, local_oksigeniaeguahe{{/str}}</label>
                            <textarea class="aj-cuaderno" id="c-llegar" name="arrive" rows="2" aria-describedby="c-llegar-a">{{arrive}}</textarea>
                            <span class="ayuda" id="c-llegar-a">{{#str}}panel_how_to_arrive_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                    </div>
                    <div class="aj-elige-fila">
                        <span class="aj-elige-t" id="c-contestamos">{{#str}}panel_replydays, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige" role="group" aria-labelledby="c-contestamos">{{#replydays}}<button class="aj-chapa" type="submit" name="replydays" value="{{value}}" formaction="{{action}}#aj-contacto" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>{{/replydays}}</span>
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-contacto" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== The country, the language and the system: four plates ===== }}
            <details class="apartado aj-plegado" id="aj-pais">
                <summary><h2 id="aj-pais-t">{{#str}}panel_country_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#lang}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/lang}}{{#countries}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/countries}}{{#currencies}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/currencies}}{{#systems}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/systems}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-placas">
                        <div class="aj-placa"><label for="c-idioma">{{#str}}centre_lang, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-idioma" name="lang" data-envio-solo>{{#lang}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/lang}}</select></div>
                        <div class="aj-placa con-ayuda"><label for="c-pais">{{#str}}centre_country, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-pais" name="country" aria-describedby="c-pais-a" data-envio-solo>{{#countries}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/countries}}</select><span class="ayuda" id="c-pais-a">{{#str}}centre_country_help, local_oksigeniaeguahe{{/str}}</span></div>
                        <div class="aj-placa"><label for="c-moneda">{{#str}}centre_currency, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-moneda" name="currency" data-envio-solo>{{#currencies}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/currencies}}</select></div>
                        <div class="aj-placa con-ayuda"><label for="c-sistema">{{#str}}centre_system, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-sistema" name="system" aria-describedby="c-sistema-a" data-envio-solo>{{#systems}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/systems}}</select><span class="ayuda" id="c-sistema-a">{{#str}}centre_system_help, local_oksigeniaeguahe{{/str}}</span></div>
                    </div>
                    <div class="aj-guardar aj-sin-js"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-pais" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== How a family asks for a place: the two days on their leaves, how, and where ===== }}
            {{#apply}}
            <details class="apartado aj-plegado" id="aj-pedir">
                <summary><h2 id="aj-pedir-t">{{#str}}panel_apply_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#fromleaf}}<span>{{#str}}panel_read_apply_from, local_oksigeniaeguahe{{/str}} {{day}} {{month}}</span>{{/fromleaf}}{{#untilleaf}}<span>{{#str}}panel_read_apply_until, local_oksigeniaeguahe{{/str}} {{day}} {{month}}</span>{{/untilleaf}}{{^written}}<span>{{#str}}panel_read_apply_none, local_oksigeniaeguahe{{/str}}</span>{{/written}}</span></summary>
                <div class="aj-cuerpo">
                    <p class="ayuda aj-pedir-ayuda" id="c-pedir-a">{{#str}}panel_apply_help, local_oksigeniaeguahe{{/str}}</p>
                    <div class="aj-dos aj-pedir-dias">
                        <div class="aj-primer">
                            <span class="hoja-cal aj-primer-hoja{{^fromleaf}} aj-primer-sin{{/fromleaf}}" aria-hidden="true">{{#fromleaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/fromleaf}}{{^fromleaf}}<b>?</b>{{/fromleaf}}</span>
                            <div class="aj-primer-texto"><label id="c-desde-l" for="{{fromdate.first}}">{{#str}}panel_apply_from, local_oksigeniaeguahe{{/str}}</label>{{#fromdate}}{{> local_oksigeniaeguahe/public_date }}{{/fromdate}}</div>
                        </div>
                        <div class="aj-primer">
                            <span class="hoja-cal aj-primer-hoja{{^untilleaf}} aj-primer-sin{{/untilleaf}}" aria-hidden="true">{{#untilleaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/untilleaf}}{{^untilleaf}}<b>?</b>{{/untilleaf}}</span>
                            <div class="aj-primer-texto"><label id="c-hasta-l" for="{{untildate.first}}">{{#str}}panel_apply_until, local_oksigeniaeguahe{{/str}}</label>{{#untildate}}{{> local_oksigeniaeguahe/public_date }}{{/untildate}}</div>
                        </div>
                    </div>
                    <div class="aj-frase">
                        <label for="c-pedir">{{#str}}panel_apply_how, local_oksigeniaeguahe{{/str}}</label>
                        <textarea class="aj-cuaderno" id="c-pedir" name="applyhow" rows="3" placeholder="{{#str}}panel_apply_how_example, local_oksigeniaeguahe{{/str}}">{{how}}</textarea>
                    </div>
                    <div class="aj-frase">
                        <label for="c-pedir-web">{{#str}}panel_apply_url, local_oksigeniaeguahe{{/str}}</label>
                        <input class="aj-hueco aj-hueco-web" id="c-pedir-web" name="applyurl" type="url" value="{{url}}" placeholder="https://" size="40" dir="ltr" autocomplete="off">
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-pedir" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>
            {{/apply}}

            {{! ===== After enrolling: who carries them, the first day, the name in a sentence, the siblings ===== }}
            <details class="apartado aj-plegado" id="aj-despues">
                <summary><h2 id="aj-despues-t">{{#str}}panel_after_enrolment, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#handover}}{{#selected}}<span>{{#value}}{{name}}{{/value}}{{^value}}{{#handoverplace}}{{handoverplace}}{{/handoverplace}}{{^handoverplace}}{{name}}{{/handoverplace}}{{/value}}</span>{{/selected}}{{/handover}}{{#firstdayleaf}}<span>{{#str}}panel_read_firstday, local_oksigeniaeguahe{{/str}} {{day}} {{month}}</span>{{/firstdayleaf}}{{#siblingages}}{{#selected}}{{#value}}<span>{{#str}}panel_read_siblings, local_oksigeniaeguahe, {{value}}{{/str}}</span>{{/value}}{{/selected}}{{/siblingages}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-elige-fila aj-elige-caras">
                        <input type="hidden" name="handover" value="{{#handover}}{{#selected}}{{value}}{{/selected}}{{/handover}}">
                        <span class="aj-elige-t" id="c-lleva">{{#str}}panel_handover, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige" role="group" aria-labelledby="c-lleva" aria-describedby="c-lleva-a">{{#handover}}<button class="aj-chapa" type="submit" name="handover" value="{{value}}" formaction="{{action}}#aj-despues" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>{{/handover}}</span>
                        <span class="ayuda" id="c-lleva-a">{{#str}}panel_handover_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    {{#handover}}{{#selected}}{{^value}}
                    <div class="aj-frase">
                        <label for="c-sitio">{{#str}}panel_handover_place, local_oksigeniaeguahe{{/str}}</label>
                        <input class="aj-hueco" id="c-sitio" name="handoverplace" value="{{handoverplace}}" placeholder="{{#str}}panel_handover_place_example, local_oksigeniaeguahe{{/str}}" size="30">
                    </div>
                    {{/value}}{{/selected}}{{/handover}}
                    {{#handover}}{{#selected}}{{#value}}<input type="hidden" name="handoverplace" value="{{handoverplace}}">{{/value}}{{/selected}}{{/handover}}
                    <div class="aj-frase">
                        <label for="c-como">{{#str}}panel_handover_how, local_oksigeniaeguahe{{/str}}</label>
                        <textarea class="aj-cuaderno" id="c-como" name="handoverhow" rows="2" placeholder="{{#str}}panel_handover_how_example, local_oksigeniaeguahe{{/str}}">{{handoverhow}}</textarea>
                    </div>
                    <div class="aj-dos">
                        <div class="aj-primer con-ayuda">
                            <span class="hoja-cal aj-primer-hoja{{^firstdayleaf}} aj-primer-sin{{/firstdayleaf}}" aria-hidden="true">{{#firstdayleaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/firstdayleaf}}{{^firstdayleaf}}<b>?</b>{{/firstdayleaf}}</span>
                            <div class="aj-primer-texto"><label id="c-primer-l" for="{{firstdaydate.first}}">{{#str}}panel_firstday_date, local_oksigeniaeguahe{{/str}}</label>{{#firstdaydate}}{{> local_oksigeniaeguahe/public_date }}{{/firstdaydate}}</div>
                            <span class="ayuda" id="c-primer-a">{{#str}}panel_firstday_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                        <div class="aj-frase aj-hoy con-ayuda">
                            <label for="c-frase">{{#str}}panel_namephrase, local_oksigeniaeguahe{{/str}}</label>
                            <span class="aj-hoy-frase mano"><span aria-hidden="true">{{#str}}panel_namephrase_lead, local_oksigeniaeguahe{{/str}}</span> <input class="aj-hueco" id="c-frase" name="namephrase" value="{{namephrase}}" placeholder="{{namephraseexample}}" size="22" aria-describedby="c-frase-a"></span>
                            <span class="ayuda" id="c-frase-a">{{#str}}panel_namephrase_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                    </div>
                    <div class="aj-elige-fila">
                        <span class="aj-elige-t" id="c-hermanos">{{#str}}panel_siblingage, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige aj-regla" role="group" aria-labelledby="c-hermanos" aria-describedby="c-hermanos-a">{{#siblingages}}<button class="aj-chapa" type="submit" name="siblingage" value="{{value}}" formaction="{{action}}#aj-despues" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{#value}}{{value}}{{/value}}{{^value}}{{#str}}no{{/str}}{{/value}}<span class="oculto"> · {{name}}</span></button>{{/siblingages}}</span>
                        <span class="ayuda" id="c-hermanos-a">{{#str}}panel_siblingage_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    <div>
                        <input type="hidden" name="invitegone" value="{{#invitegone}}1{{/invitegone}}{{^invitegone}}0{{/invitegone}}">
                        <button class="interruptor" type="submit" name="invitegone" value="{{#invitegone}}0{{/invitegone}}{{^invitegone}}1{{/invitegone}}" formaction="{{action}}#aj-despues" aria-pressed="{{#invitegone}}true{{/invitegone}}{{^invitegone}}false{{/invitegone}}"><span class="lampara" aria-hidden="true"></span><span>{{#str}}panel_invitegone, local_oksigeniaeguahe{{/str}}</span></button>
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-despues" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== The data of the families: the sheet they read, with its blanks ===== }}
            <details class="apartado aj-plegado" id="aj-datos">
                <summary><h2 id="aj-datos-t">{{#str}}centre_data, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#controller}}<span>{{controller}}</span>{{/controller}}{{^controller}}<span>{{#str}}panel_read_nocontroller, local_oksigeniaeguahe{{/str}}</span>{{/controller}}{{#retentions}}{{#selected}}<span>{{#str}}panel_read_retention, local_oksigeniaeguahe, {{name}}{{/str}}</span>{{/selected}}{{/retentions}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-hoja">
                        <div class="aj-hoja-fila con-ayuda"><label for="c-resp">{{#str}}centre_controller, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-resp" name="controller" value="{{controller}}" aria-describedby="c-resp-a"><span class="ayuda" id="c-resp-a">{{#str}}centre_controller_help, local_oksigeniaeguahe{{/str}}</span></div>
                        <div class="aj-hoja-fila"><label for="c-derechos">{{#str}}centre_rightscontact, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-derechos" name="rightscontact" value="{{rights}}"></div>
                        <div class="aj-hoja-fila"><label for="c-dpd">{{#str}}centre_dpocontact, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-dpd" name="dpocontact" value="{{dpo}}"></div>
                    </div>
                    <div class="aj-elige-fila">
                        <span class="aj-elige-t" id="c-meses">{{#str}}centre_retention, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige" role="group" aria-labelledby="c-meses" aria-describedby="c-meses-a">{{#retentions}}<button class="aj-chapa" type="submit" name="retention" value="{{value}}" formaction="{{action}}#aj-datos" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>{{/retentions}}</span>
                        <span class="ayuda" id="c-meses-a">{{#str}}centre_retention_help, local_oksigeniaeguahe{{/str}}</span>
                        <input type="hidden" name="retention" value="{{#retentions}}{{#selected}}{{value}}{{/selected}}{{/retentions}}">
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-datos" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== The area and the networks: a list on lined paper ===== }}
            <details class="apartado aj-plegado" id="aj-zona">
                <summary><h2 id="aj-zona-t">{{#str}}panel_the_area, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura aj-lectura-lista">{{#areaplaces}}<span class="aj-sitio">{{.}}</span>{{/areaplaces}}{{^areaplaces}}<span>{{#str}}panel_read_noplaces, local_oksigeniaeguahe{{/str}}</span>{{/areaplaces}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-frase con-ayuda">
                        <label for="c-zona">{{#str}}panel_places_of_area, local_oksigeniaeguahe{{/str}}</label>
                        <textarea class="aj-cuaderno" id="c-zona" name="municipalities" rows="6" aria-describedby="c-zona-a">{{municipalities}}</textarea>
                        <span class="ayuda" id="c-zona-a">{{#str}}panel_places_of_area_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-zona" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>
            <details class="apartado aj-plegado" id="aj-redes">
                <summary><h2 id="aj-redes-t">{{#str}}panel_networks, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura aj-lectura-lista">{{#networklist}}<span class="aj-sitio">{{.}}</span>{{/networklist}}{{^networklist}}<span>{{#str}}panel_read_nonetworks, local_oksigeniaeguahe{{/str}}</span>{{/networklist}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-frase con-ayuda">
                        <label for="c-redes">{{#str}}panel_networks_list, local_oksigeniaeguahe{{/str}}</label>
                        <textarea class="aj-cuaderno" id="c-redes" name="networks" rows="6" aria-describedby="c-redes-a">{{networks}}</textarea>
                        <span class="ayuda" id="c-redes-a">{{#str}}panel_networks_help, local_oksigeniaeguahe{{/str}}</span>
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-redes" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== The skin of the panel: each one its picture, touched to choose it ===== }}
            <details class="apartado aj-plegado" id="aj-panel">
                <summary><h2 id="aj-panel-t">{{#str}}centre_skin, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#skins}}{{#checked}}<span>{{name}}</span>{{/checked}}{{/skins}}</span></summary>
                <div class="aj-cuerpo">
                    <p class="linea-dato">{{skinproposal}}</p>
                    <input type="hidden" name="skin" value="{{#skins}}{{#checked}}{{value}}{{/checked}}{{/skins}}">
                    <div class="pieles" role="group" aria-labelledby="aj-panel-t">
                        {{#skins}}
                        <button class="piel-opcion{{#auto}} auto{{/auto}}" type="submit" name="skin" value="{{value}}" formaction="{{action}}#aj-panel" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}"{{#soon}} disabled{{/soon}}>
                            {{#img}}<span class="piel-muestra"><img class="dia" src="{{img}}" alt="" width="480" height="300" loading="lazy">{{#imgdark}}<img class="noche" src="{{imgdark}}" alt="" width="480" height="300" loading="lazy">{{/imgdark}}</span>{{/img}}
                            <span class="lampara" aria-hidden="true"></span>
                            <span class="piel-texto"><b>{{name}}</b><span class="secundario">{{help}}</span></span>
                        </button>
                        {{/skins}}
                    </div>
                    <p class="def">{{#str}}panel_skin_help, local_oksigeniaeguahe{{/str}}</p>
                </div>
            </details>

            {{! ===== What families share ===== }}
            <details class="apartado aj-plegado" id="aj-compartir">
                <summary><h2 id="aj-compartir-t">{{#str}}centre_share, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#share}}{{#on}}<span>{{#str}}panel_read_share_on, local_oksigeniaeguahe{{/str}}</span>{{#hasforms}}{{#forms}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/forms}}{{/hasforms}}{{/on}}{{^on}}<span>{{#str}}panel_read_share_off, local_oksigeniaeguahe{{/str}}</span>{{/on}}{{/share}}</span></summary>
                <div class="aj-cuerpo">
                    {{#share}}
                    <div>
                        <input type="hidden" name="shareinvite" value="{{#on}}1{{/on}}{{^on}}0{{/on}}">
                        <button class="interruptor" type="submit" name="shareinvite" value="{{#on}}0{{/on}}{{^on}}1{{/on}}" formaction="{{action}}#aj-compartir" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}"><span class="lampara" aria-hidden="true"></span><span>{{#str}}centre_shareinvite, local_oksigeniaeguahe{{/str}}</span></button>
                    </div>
                    <input type="hidden" name="shareentry" value="{{#forms}}{{#selected}}{{value}}{{/selected}}{{/forms}}">
                    {{#on}}{{#hasforms}}
                    <div class="aj-elige-fila">
                        <span class="aj-elige-t" id="c-compartir">{{#str}}centre_shareentry, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige" role="group" aria-labelledby="c-compartir">{{#forms}}<button class="aj-chapa" type="submit" name="shareentry" value="{{value}}" formaction="{{action}}#aj-compartir" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>{{/forms}}</span>
                    </div>
                    {{/hasforms}}{{/on}}
                    <p class="def">{{#str}}centre_share_help, local_oksigeniaeguahe{{/str}}</p>
                    {{/share}}
                </div>
            </details>

            {{! ===== The AI ===== }}
            <details class="apartado aj-plegado" id="aj-ia">
                <summary><h2 id="aj-ia-t">{{#str}}centre_ai, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#ai}}{{#on}}<span>{{#str}}panel_read_on, local_oksigeniaeguahe{{/str}}</span>{{#several}}{{#providers}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/providers}}{{/several}}{{/on}}{{^on}}<span>{{#str}}panel_read_off, local_oksigeniaeguahe{{/str}}</span>{{/on}}{{/ai}}</span></summary>
                <div class="aj-cuerpo">
                    {{#ai}}
                    <div>
                        <input type="hidden" name="aion" value="{{#on}}1{{/on}}{{^on}}0{{/on}}">
                        <button class="interruptor" type="submit" name="aion" value="{{#on}}0{{/on}}{{^on}}1{{/on}}" formaction="{{action}}#aj-ia" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}"{{#locked}} disabled{{/locked}}><span class="lampara" aria-hidden="true"></span><span>{{#str}}centre_ai_on, local_oksigeniaeguahe{{/str}}</span></button>
                    </div>
                    <input type="hidden" name="aiprovider" value="{{#providers}}{{#selected}}{{value}}{{/selected}}{{/providers}}">
                    {{#several}}
                    <div class="aj-elige-fila">
                        <span class="aj-elige-t" id="c-ia">{{#str}}centre_aiprovider, local_oksigeniaeguahe{{/str}}</span>
                        <span class="aj-elige" role="group" aria-labelledby="c-ia">{{#providers}}<button class="aj-chapa" type="submit" name="aiprovider" value="{{value}}" formaction="{{action}}#aj-ia" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"{{#locked}} disabled{{/locked}}>{{name}}</button>{{/providers}}</span>
                    </div>
                    {{/several}}
                    <p class="def">{{note}}{{#locked}} {{lockednote}}{{/locked}}</p>
                    {{/ai}}
                </div>
            </details>

            </div>
        </div>
    </form>
    {{! The families already at the centre: their own forms, so after the form of the settings, in the same column. }}
    {{#roster}}
    <div class="ajustes ajustes-padron">
        <span class="indice-hueco" aria-hidden="true"></span>
        <div class="ajustes-hojas">{{> local_oksigeniaeguahe/panel_roster }}</div>
    </div>
    {{/roster}}
</div>
