<div class="pagina pagina-ajustes">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    <form class="ajustes" method="post" action="{{action}}" enctype="multipart/form-data" novalidate data-ajustes>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <nav class="indice-ajustes" aria-label="{{#str}}panel_settings_index, local_oksigeniaeguahe{{/str}}">
            <p class="indice-t">{{#str}}panel_settings_daily, local_oksigeniaeguahe{{/str}}</p>
            <ol>
                <li><a href="#aj-oferta">{{#str}}panel_offer_places, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-reciben">{{#str}}panel_who_receives, local_oksigeniaeguahe{{/str}}</a></li>
                {{#hasmessaging}}<li><a href="#aj-canal">{{#str}}centre_messaging, local_oksigeniaeguahe{{/str}}</a></li>{{/hasmessaging}}
            </ol>
            <p class="indice-t">{{#str}}panel_settings_once, local_oksigeniaeguahe{{/str}}</p>
            <ol>
                <li><a href="#aj-aspecto">{{#str}}panel_how_families_see, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-contacto">{{#str}}panel_contact_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-pais">{{#str}}panel_country_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-despues">{{#str}}panel_after_enrolment, local_oksigeniaeguahe{{/str}}</a></li>
                {{#roster}}<li><a href="#padron">{{#str}}panel_roster, local_oksigeniaeguahe{{/str}}</a></li>{{/roster}}
                <li><a href="#aj-datos">{{#str}}centre_data, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-zona">{{#str}}panel_the_area, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-redes">{{#str}}panel_networks, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-panel">{{#str}}centre_skin, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-compartir">{{#str}}centre_share, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-ia">{{#str}}centre_ai, local_oksigeniaeguahe{{/str}}</a></li>
            </ol>
        </nav>
        <div class="ajustes-hojas">
            <p class="aj-tramo-t">{{#str}}panel_settings_daily, local_oksigeniaeguahe{{/str}}</p>

            {{! ===== The offer: shelves and cards ===== }}
            <section class="apartado oferta-ap" id="aj-oferta" aria-labelledby="aj-oferta-t">
                <header><h2 id="aj-oferta-t">{{#str}}panel_offer_places, local_oksigeniaeguahe{{/str}}</h2><span class="secundario">{{#str}}panel_offer_help, local_oksigeniaeguahe{{/str}}</span></header>
                {{#oferta}}
                <input type="hidden" name="offerview" value="{{year}}">
                <div class="of-anos" role="group" aria-label="{{#str}}offer_year, local_oksigeniaeguahe{{/str}}">
                    {{#years}}<a class="hoja-cal of-ano" href="{{url}}"{{#current}} aria-current="page"{{/current}}><small>{{#str}}offer_year, local_oksigeniaeguahe{{/str}}</small><b>{{name}}</b><span>{{courses}}</span></a>{{/years}}
                    {{#copy}}<button class="hoja-cal of-ano of-ano-nuevo" type="submit" name="offercopy" value="{{to}}"><small>{{label}}</small><b>{{to}}</b><span>{{#str}}panel_offer_copy_hint, local_oksigeniaeguahe{{/str}}</span></button>{{/copy}}
                </div>
                <div class="of-escalera">
                    {{#stages}}
                    <section class="of-etapa{{^on}} of-etapa-no{{/on}}" aria-labelledby="of-e-{{key}}">
                        <div class="of-etapa-cabeza">
                            <h3 id="of-e-{{key}}">{{name}} <span class="of-edades">{{ages}}</span></h3>
                            {{#on}}<span class="of-resumen">{{summary}}</span>{{/on}}
                            <button class="interruptor" type="submit" name="offerstage" value="{{key}}:{{#on}}off{{/on}}{{^on}}on{{/on}}" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}"><span class="lampara" aria-hidden="true"></span><span>{{#on}}{{#str}}panel_offer_stage_on, local_oksigeniaeguahe{{/str}}{{/on}}{{^on}}{{#str}}panel_offer_stage_off, local_oksigeniaeguahe{{/str}}{{/on}}</span></button>
                        </div>
                        {{#on}}
                        <ul class="of-balda">{{#cards}}<li class="of-curso{{^active}} of-curso-apagado{{/active}}{{#new}} of-curso-nuevo{{/new}}" id="of-c-{{id}}">{{> local_oksigeniaeguahe/panel_offer_card }}</li>{{/cards}}</ul>
                        {{#same}}<button class="of-igualar" type="submit" name="offerstageplaces" value="{{key}}">{{label}}</button>{{/same}}
                        {{/on}}
                    </section>
                    {{/stages}}
                    <section class="of-etapa of-otros" id="of-e-otros" aria-labelledby="of-e-otros-t">
                        <div class="of-etapa-cabeza"><h3 id="of-e-otros-t">{{#str}}panel_offer_others, local_oksigeniaeguahe{{/str}}</h3></div>
                        <ul class="of-balda">{{#others}}<li class="of-curso{{^active}} of-curso-apagado{{/active}}{{#new}} of-curso-nuevo{{/new}}" id="of-c-{{id}}">{{> local_oksigeniaeguahe/panel_offer_card }}</li>{{/others}}{{#newcard}}<li class="of-curso{{^active}} of-curso-apagado{{/active}}{{#new}} of-curso-nuevo{{/new}}" id="of-c-{{id}}">{{> local_oksigeniaeguahe/panel_offer_card }}</li>{{/newcard}}</ul>
                    </section>
                </div>
                {{/oferta}}
                {{^oferta}}<p class="secundario anadir-etapa-sin">{{#str}}panel_offer_stage_nosystem, local_oksigeniaeguahe{{/str}}</p>{{/oferta}}
            </section>

            {{! ===== The people: who hangs from the rail is who the families see ===== }}
            <section class="apartado" id="aj-reciben" aria-labelledby="aj-reciben-t">
                <header><h2 id="aj-reciben-t">{{#str}}panel_who_receives, local_oksigeniaeguahe{{/str}}</h2><span class="secundario">{{#str}}panel_people_help, local_oksigeniaeguahe{{/str}}</span></header>
                <ul class="aj-pared">
                    {{#hosts}}
                    <li class="aj-persona{{^shown}} aj-persona-fuera{{/shown}}" id="rc-{{id}}">
                        <input type="hidden" name="shown[{{id}}]" value="{{#shown}}1{{/shown}}{{^shown}}0{{/shown}}">
                        <input class="archivo-oculto" id="foto-{{id}}" type="file" name="photo[{{id}}]" accept="image/png,image/jpeg,image/webp" required data-envio-solo>
                        <label class="aj-cara" for="foto-{{id}}">
                            {{#picture}}<img src="{{picture}}" alt="" width="84" height="84">{{/picture}}{{^picture}}<span class="aj-iniciales" aria-hidden="true">{{initials}}</span>{{/picture}}
                            <span class="aj-cara-foto">{{{i.subir}}}<span class="oculto">{{#picture}}{{#str}}panel_photo_change, local_oksigeniaeguahe{{/str}}{{/picture}}{{^picture}}{{#str}}panel_photo_add, local_oksigeniaeguahe{{/str}}{{/picture}}: {{name}}</span></span>
                        </label>
                        <b class="aj-persona-n">{{name}}</b>
                        {{#role}}<span class="aj-persona-papel" dir="auto">{{role}}</span>{{/role}}
                        {{#phrase}}<q class="aj-persona-frase mano" dir="auto">{{phrase}}</q>{{/phrase}}
                        <button class="boton principal pequeno aj-foto-guardar" type="submit" name="guardar" value="1" formaction="{{action}}#rc-{{id}}">{{{i.check}}}{{#str}}panel_photo_save, local_oksigeniaeguahe{{/str}}</button>
                        <button class="interruptor aj-persona-sale" type="submit" name="shown[{{id}}]" value="{{#shown}}0{{/shown}}{{^shown}}1{{/shown}}" formaction="{{action}}#rc-{{id}}" aria-pressed="{{#shown}}true{{/shown}}{{^shown}}false{{/shown}}"><span class="lampara" aria-hidden="true"></span><span>{{#shown}}{{#str}}panel_shown_families, local_oksigeniaeguahe{{/str}}{{/shown}}{{^shown}}{{#str}}panel_shown_not, local_oksigeniaeguahe{{/str}}{{/shown}}</span></button>
                        <details class="of-mas aj-persona-mas">
                            <summary><span>{{#phrase}}{{#str}}panel_person_has_phrase, local_oksigeniaeguahe{{/str}}{{/phrase}}{{^phrase}}{{#str}}panel_person_no_phrase, local_oksigeniaeguahe{{/str}}{{/phrase}}</span><span class="of-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span></summary>
                            <div class="of-dorso">
                                <div class="campo"><label for="cargo-{{id}}">{{#str}}panel_their_role, local_oksigeniaeguahe, {{first}}{{/str}}</label><input id="cargo-{{id}}" name="role[{{id}}]" value="{{role}}" placeholder="{{#str}}panel_role_example, local_oksigeniaeguahe{{/str}}" size="18"></div>
                                <div class="campo"><label for="frase-{{id}}">{{#str}}panel_their_sentence, local_oksigeniaeguahe, {{first}}{{/str}}</label><textarea id="frase-{{id}}" name="phrase[{{id}}]" rows="3" placeholder="{{#str}}panel_their_sentence_example, local_oksigeniaeguahe{{/str}}">{{phrase}}</textarea></div>
                                <div class="aj-dorso-pie">
                                    <button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#rc-{{id}}" data-guardar>{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button>
                                    {{^me}}
                                    <details class="aj-quitar">
                                        <summary>{{#str}}panel_member_remove, local_oksigeniaeguahe{{/str}}</summary>
                                        <button class="boton peligro pequeno" type="submit" name="removemember[{{userid}}]" value="1" formaction="{{action}}#aj-reciben">{{#str}}panel_member_remove_confirm, local_oksigeniaeguahe, {{first}}{{/str}}</button>
                                    </details>
                                    {{/me}}
                                </div>
                            </div>
                        </details>
                    </li>
                    {{/hosts}}
                    <li class="aj-persona aj-persona-nueva" id="aj-equipo">
                        <details class="of-mas">
                            <summary><b>{{#str}}panel_person_new, local_oksigeniaeguahe{{/str}}</b></summary>
                            <div class="of-dorso">
                                <div class="campo"><label for="c-equipo">{{#str}}panel_add_person_help, local_oksigeniaeguahe{{/str}}</label><input id="c-equipo" name="addmember" autocomplete="off" size="18"></div>
                                <span class="ayuda">{{#str}}panel_team_help, local_oksigeniaeguahe{{/str}}</span>
                                <button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-reciben">{{#str}}panel_offer_add, local_oksigeniaeguahe{{/str}}</button>
                            </div>
                        </details>
                    </li>
                </ul>
            </section>

            {{! ===== Telegram and WhatsApp: three choices, and the channel ===== }}
            {{#hasmessaging}}
            <section class="apartado" id="aj-canal" aria-labelledby="aj-canal-t">
                <header><h2 id="aj-canal-t">{{#str}}centre_messaging, local_oksigeniaeguahe{{/str}}</h2></header>
                <div class="aj-modos" id="aj-mensajes" role="group" aria-labelledby="aj-canal-t">
                    {{#messaging}}<button class="aj-modo" type="submit" name="messaging" value="{{value}}" formaction="{{action}}#aj-canal" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}"><span class="lampara" aria-hidden="true"></span><b>{{name}}</b><span>{{help}}</span></button>{{/messaging}}
                </div>
                {{#channel}}
                <h3 class="aj-sub">{{#str}}centre_channel, local_oksigeniaeguahe{{/str}}</h3>
                {{#ready}}
                <div class="canal-ficha">
                    <span class="canal-sello" aria-hidden="true">{{{i.enviado}}}</span>
                    <p><span class="secundario">{{#str}}panel_channel_in, local_oksigeniaeguahe{{/str}}</span> {{#url}}<a href="{{url}}" target="_blank" rel="noopener"><b>{{title}}</b></a>{{/url}}{{^url}}<b>{{title}}</b>{{/url}}<span class="secundario">{{members}}</span></p>
                    {{#marandu}}<a class="enlace" href="{{marandu}}">{{#str}}panel_channel_marandu, local_oksigeniaeguahe{{/str}}</a>{{/marandu}}
                </div>
                <input type="hidden" name="channelshown" value="1">
                <p class="aj-linea-t" id="aj-canal-solo">{{#str}}panel_channel_auto, local_oksigeniaeguahe{{/str}}</p>
                <ol class="aj-linea" aria-labelledby="aj-canal-solo">
                    {{#moments}}
                    <li class="aj-parada{{#checked}} aj-parada-sale{{/checked}}">
                        <input type="hidden" name="channelauto[{{value}}]" value="{{#checked}}{{value}}{{/checked}}">
                        <span class="aj-parada-cuando">{{help}}</span>
                        <button class="interruptor" type="submit" name="channelauto[{{value}}]" value="{{^checked}}{{value}}{{/checked}}" formaction="{{action}}#aj-canal" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}"><span class="lampara" aria-hidden="true"></span><span>{{name}}</span></button>
                    </li>
                    {{/moments}}
                </ol>
                <p class="def">{{#str}}panel_channel_auto_help, local_oksigeniaeguahe{{/str}}</p>
                {{#hascoming}}
                <p class="aj-linea-t">{{#str}}panel_channel_coming, local_oksigeniaeguahe{{/str}}</p>
                <ol class="lista-canal">{{#coming}}<li><span class="lista-canal-cuando">{{when}}</span><span class="lista-canal-que"><a href="{{url}}">{{act}}</a> <span class="lista-canal-momento">{{moment}}</span>{{#review}} <span class="lista-canal-revision">{{{i.reloj}}}{{#str}}panel_channel_waits_review, local_oksigeniaeguahe{{/str}}</span>{{/review}}</span></li>{{/coming}}</ol>
                {{/hascoming}}
                {{/ready}}
                {{^ready}}<div class="canal-ficha canal-ficha-nada"><span class="canal-sello" aria-hidden="true">{{{i.enviado}}}</span><p>{{#str}}panel_channel_none, local_oksigeniaeguahe{{/str}}</p>{{#marandu}}<a class="enlace" href="{{marandu}}">{{#str}}panel_channel_marandu, local_oksigeniaeguahe{{/str}}</a>{{/marandu}}</div>{{/ready}}
                {{/channel}}
                <p class="def canal-whatsapp"><span aria-hidden="true">{{{i.whatsapp}}}</span><span>{{#str}}panel_channel_whatsapp, local_oksigeniaeguahe{{/str}}</span></p>
            </section>
