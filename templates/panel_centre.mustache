            {{! ===== The calendar of the team: the visits and acts in the calendar it already shares ===== }}
            {{#calendar}}
            <details class="apartado aj-plegado" id="aj-calendario">
                <summary><h2 id="aj-calendario-t">{{#str}}panel_cal_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#heard}}<span>{{state}}</span>{{/heard}}{{^heard}}<span>{{#str}}panel_cal_read_none, local_oksigeniaeguahe{{/str}}</span>{{/heard}}</span></summary>
                <div class="aj-cuerpo">
                    <p>{{#str}}panel_cal_lead, local_oksigeniaeguahe{{/str}}</p>
                    <p class="cal-estado{{#late}} cal-estado-tarde{{/late}}{{^heard}} cal-estado-espera{{/heard}}"><span class="cal-luz" aria-hidden="true"></span><b>{{state}}</b></p>
                    {{#emptied}}<p class="aviso-suave"><span>{{emptied}} <button class="enlace" type="submit" name="calrefill" value="1" formaction="{{action}}#aj-calendario">{{#str}}calsync_refill, local_oksigeniaeguahe{{/str}}</button></span></p>{{/emptied}}
                    {{#hascalendars}}
                    <div class="cal-cuales">
                        <h3 class="rotulo-p" id="cal-cuales-t">{{#str}}calsync_list, local_oksigeniaeguahe{{/str}}</h3>
                        <ul class="cal-lista" aria-labelledby="cal-cuales-t">
                            {{#calendars}}
                            <li class="cal-uno{{#main}} cal-uno-citas{{/main}}{{#behind}} cal-uno-fondo fondo-{{color}}{{/behind}}">
                                <b>{{name}}</b>
                                {{#main}}<span class="cal-uno-aqui">{{{i.check}}}{{#str}}calsync_here, local_oksigeniaeguahe{{/str}}</span>{{/main}}
                                {{^main}}
                                <button class="interruptor" type="submit" name="calbehind" value="{{id}}" formaction="{{action}}#aj-calendario" aria-pressed="{{#behind}}true{{/behind}}{{^behind}}false{{/behind}}"><span class="lampara" aria-hidden="true"></span><span>{{#str}}calsync_seen, local_oksigeniaeguahe{{/str}}<span class="oculto">: {{name}}</span></span></button>
                                <button class="{{#chosen}}enlace{{/chosen}}{{^chosen}}boton secundario pequeno{{/chosen}}" type="submit" name="calmain" value="{{id}}" formaction="{{action}}#aj-calendario">{{#str}}calsync_use, local_oksigeniaeguahe{{/str}}<span class="oculto">: {{name}}</span></button>
                                {{/main}}
                            </li>
                            {{/calendars}}
                        </ul>
                        <p class="ayuda">{{#str}}calsync_behind_help, local_oksigeniaeguahe{{/str}}</p>
                    </div>
                    {{/hascalendars}}
                    <details class="cal-montar"{{^heard}} open{{/heard}}>
                        <summary>{{{i.codigo}}}<span>{{#str}}panel_cal_setup, local_oksigeniaeguahe{{/str}}</span></summary>
                        <ol class="cal-pasos">
                            <li><span>{{#str}}panel_cal_step_copy, local_oksigeniaeguahe{{/str}}</span>
                                <button class="boton secundario pequeno" type="button" data-copiar="{{script}}" hidden>{{{i.copiar}}}{{#str}}panel_copy_code, local_oksigeniaeguahe{{/str}}</button>
                                <details class="cal-codigo"><summary>{{#str}}panel_cal_code, local_oksigeniaeguahe{{/str}}</summary>
                                    <textarea id="cal-guion" aria-label="{{#str}}panel_cal_setup, local_oksigeniaeguahe{{/str}}" readonly rows="8" spellcheck="false" dir="ltr">{{script}}</textarea></details></li>
                            <li><span>{{#str}}panel_cal_step_paste, local_oksigeniaeguahe{{/str}}</span>
                                <a class="boton secundario pequeno" href="https://script.google.com/home/projects/create" target="_blank" rel="noopener noreferrer">{{#str}}panel_cal_open, local_oksigeniaeguahe{{/str}}</a></li>
                            <li><span>{{#str}}panel_cal_step_choose, local_oksigeniaeguahe{{/str}}</span></li>
                        </ol>
                        <p class="ayuda">{{#str}}panel_cal_every, local_oksigeniaeguahe{{/str}}</p>
                    </details>
                    <details class="cal-montar">
                        <summary>{{{i.enlace}}}<span>{{#str}}panel_cal_link, local_oksigeniaeguahe{{/str}}</span></summary>
                        <div class="codigo-web">
                            <textarea id="cal-enlace" aria-label="{{#str}}panel_cal_link, local_oksigeniaeguahe{{/str}}" readonly rows="2" spellcheck="false" dir="ltr">{{ics}}</textarea>
                            <button class="boton secundario pequeno" type="button" data-copiar="{{ics}}" hidden>{{{i.copiar}}}{{#str}}panel_copy_link, local_oksigeniaeguahe{{/str}}</button>
                            <span class="ayuda">{{#str}}panel_cal_link_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                    </details>
                    <p class="cal-nuevo"><button class="boton secundario pequeno" type="submit" name="calrenew" value="1" formaction="{{action}}#aj-calendario">{{#str}}panel_cal_renew, local_oksigeniaeguahe{{/str}}</button> <span class="secundario">{{#str}}panel_cal_renew_help, local_oksigeniaeguahe{{/str}}</span></p>
                </div>
            </details>
            {{/calendar}}

            {{! ===== How the letters to the families go out: the mail of the site, or a service of its own ===== }}
            {{#mailer}}
            <details class="apartado aj-plegado" id="aj-cartas">
                <summary><h2 id="aj-cartas-t">{{#str}}mailer_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura"><span>{{reading}}</span></span></summary>
                <div class="aj-cuerpo">
                    <p>{{#str}}mailer_lead, local_oksigeniaeguahe{{/str}}</p>
                    <div class="segmentos" role="group" aria-label="{{#str}}mailer_card, local_oksigeniaeguahe{{/str}}">{{#kinds}}<button type="submit" name="mailerkind" value="{{key}}" formaction="{{action}}#aj-cartas" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{name}}</button>{{/kinds}}</div>
                    {{#service}}
                    <div class="cartas-servicio">
                        <label for="c-cartas-de">{{#str}}mailer_from, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-de" type="email" name="mailerfrom" value="{{from}}" size="30" dir="ltr" autocomplete="off">
                        <label for="c-cartas-nombre">{{#str}}mailer_fromname, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-nombre" type="text" name="mailerfromname" value="{{fromname}}" size="30" autocomplete="off" aria-describedby="c-cartas-nombre-a"><span class="ayuda" id="c-cartas-nombre-a">{{#str}}mailer_fromname_help, local_oksigeniaeguahe{{/str}}</span>
                        {{#smtp}}
                        <label for="c-cartas-host">{{#str}}mailer_host, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-host" type="text" name="mailerhost" value="{{host}}" size="30" dir="ltr" autocomplete="off">
                        <label for="c-cartas-puerto">{{#str}}mailer_port, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-puerto" type="number" name="mailerport" value="{{port}}" min="1" max="65535" dir="ltr">
                        <label for="c-cartas-seguro">{{#str}}mailer_secure, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-cartas-seguro" name="mailersecure">{{#secures}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/secures}}</select>
                        <label for="c-cartas-usuario">{{#str}}mailer_user, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-usuario" type="text" name="maileruser" value="{{user}}" size="30" dir="ltr" autocomplete="off">
                        <label for="c-cartas-clave">{{#str}}mailer_pass, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-clave" type="password" name="mailerpass" value="" size="30" dir="ltr" autocomplete="new-password"{{#haspass}} placeholder="{{#str}}mailer_kept, local_oksigeniaeguahe{{/str}}"{{/haspass}}>
                        {{/smtp}}
                        {{#mailjet}}
                        <label for="c-cartas-api">{{#str}}mailer_key, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-api" type="text" name="mailerkey" value="{{key}}" size="34" dir="ltr" autocomplete="off">
                        <label for="c-cartas-secreto">{{#str}}mailer_secret, local_oksigeniaeguahe{{/str}}</label><input class="aj-hueco" id="c-cartas-secreto" type="password" name="mailersecret" value="" size="34" dir="ltr" autocomplete="new-password"{{#hassecret}} placeholder="{{#str}}mailer_kept, local_oksigeniaeguahe{{/str}}"{{/hassecret}}>
                        {{#hook}}
                        <div class="codigo-web cartas-gancho">
                            <label for="c-cartas-gancho">{{#str}}mailer_hook, local_oksigeniaeguahe{{/str}}</label>
                            <textarea id="c-cartas-gancho" readonly rows="2" spellcheck="false" dir="ltr">{{hook}}</textarea>
                            <button class="boton secundario pequeno" type="button" data-copiar="{{hook}}" hidden>{{{i.copiar}}}{{#str}}panel_copy_link, local_oksigeniaeguahe{{/str}}</button>
                            <span class="ayuda">{{#str}}mailer_hook_help, local_oksigeniaeguahe{{/str}}</span>
                        </div>
                        {{/hook}}
                        {{/mailjet}}
                    </div>
                    <p class="ayuda">{{#str}}mailer_trial_help, local_oksigeniaeguahe{{/str}}</p>
                    <p><button class="boton principal pequeno" type="submit" name="mailersave" value="1" formaction="{{action}}#aj-cartas">{{{i.check}}}{{#str}}mailer_save, local_oksigeniaeguahe{{/str}}</button></p>
                    {{#error}}<p class="aviso-suave con-error" role="alert">{{{i.info}}}<span>{{error}}</span></p>{{/error}}
                    {{#tested}}<p class="aviso-suave" role="status">{{{i.check}}}<span>{{tested}}</span></p>{{/tested}}
                    {{/service}}
                </div>
            </details>
            {{/mailer}}

            {{! ===== The miniature of the centre: the way in, drawn ===== }}
            <details class="apartado aj-plegado" id="aj-miniatura">
                <summary><h2 id="aj-miniatura-t">{{#str}}panel_miniature_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura"><span>{{#hasminiature}}{{#str}}panel_miniature_has, local_oksigeniaeguahe{{/str}}{{/hasminiature}}{{^hasminiature}}{{#str}}panel_miniature_none, local_oksigeniaeguahe{{/str}}{{/hasminiature}}</span>{{#guide.on}}<span>{{#str}}panel_guide_on, local_oksigeniaeguahe{{/str}}</span>{{/guide.on}}</span></summary>
                <div class="aj-cuerpo">
                    <p class="ayuda">{{#str}}panel_miniature_lead, local_oksigeniaeguahe{{/str}}</p>
                    <ul class="aj-miniaturas">
                        {{#miniatures}}
                        <li class="aj-miniatura">
                            <input class="archivo-oculto" id="c-{{area}}" type="file" name="{{area}}" accept="image/png,image/svg+xml,image/webp,image/jpeg" required data-envio-solo>
                            <label class="aj-miniatura-marco" for="c-{{area}}">{{#url}}<img src="{{url}}" alt="" loading="lazy">{{/url}}{{^url}}<span class="aj-miniatura-vacia">{{{i.plano}}}</span>{{/url}}</label>
                            <b>{{title}}</b>
                            <span class="ayuda">{{help}}</span>
                            <span class="aj-miniatura-acciones"><label class="enlace" for="c-{{area}}">{{#url}}{{#str}}panel_miniature_change, local_oksigeniaeguahe{{/str}}{{/url}}{{^url}}{{#str}}panel_miniature_choose, local_oksigeniaeguahe{{/str}}{{/url}}</label>{{#url}}<button class="enlace" type="submit" name="miniaturedrop" value="{{area}}" formaction="{{action}}#aj-miniatura">{{#str}}panel_miniature_drop, local_oksigeniaeguahe{{/str}}</button>{{/url}}</span>
                            <button class="boton principal pequeno aj-foto-guardar" type="submit" name="guardar" value="1" formaction="{{action}}#aj-miniatura">{{{i.check}}}{{#str}}panel_photo_save, local_oksigeniaeguahe{{/str}}</button>
                        </li>
                        {{/miniatures}}
                    </ul>
                    {{#guide}}
                    <div class="aj-guia">
                        <img class="aj-guia-perro" src="{{picture.src}}" srcset="{{picture.srcset}}" alt="" width="112" height="112">
                        <div class="aj-guia-cuerpo">
                            <div class="aj-guia-cabeza">
                                <b>{{#str}}panel_guidedog, local_oksigeniaeguahe{{/str}}</b>
                                <input type="hidden" name="guide" value="{{#on}}perro{{/on}}{{^on}}no{{/on}}">
                                <button class="interruptor" type="submit" name="guide" value="{{#on}}no{{/on}}{{^on}}perro{{/on}}" formaction="{{action}}#aj-miniatura" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}" aria-describedby="c-guia-a"><span class="lampara" aria-hidden="true"></span><span>{{#str}}panel_guide_on, local_oksigeniaeguahe{{/str}}</span></button>
                            </div>
                            <span class="ayuda" id="c-guia-a">{{#str}}panel_guide_help, local_oksigeniaeguahe{{/str}}</span>
                            {{#on}}
                            <div class="aj-guia-dice">
                                <label for="c-guia-donde">{{#str}}panel_guide_where, local_oksigeniaeguahe{{/str}}</label>
                                <input class="aj-hueco" id="c-guia-donde" name="guidewhere" value="{{where}}" maxlength="255" aria-describedby="c-guia-donde-a">
                                <span class="ayuda" id="c-guia-donde-a">{{#str}}panel_guide_where_help, local_oksigeniaeguahe{{/str}}</span>
                                <label for="c-guia-hola">{{#str}}panel_guide_hello, local_oksigeniaeguahe{{/str}}</label>
                                <input class="aj-hueco" id="c-guia-hola" name="guidehello" value="{{hello}}" placeholder="{{hellodefault}}" maxlength="255" aria-describedby="c-guia-hola-a">
                                <span class="ayuda" id="c-guia-hola-a">{{#str}}panel_guide_hello_help, local_oksigeniaeguahe{{/str}}</span>
                            </div>
                            <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-miniatura" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                            {{/on}}
                        </div>
                    </div>
                    {{/guide}}
                </div>
            </details>

            {{! ===== The country, the language and the system: four plates ===== }}
            <details class="apartado aj-plegado" id="aj-pais">
                <summary><h2 id="aj-pais-t">{{#str}}panel_country_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#lang}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/lang}}{{#countries}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/countries}}{{#currencies}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/currencies}}{{#systems}}{{#selected}}<span>{{name}}</span>{{/selected}}{{/systems}}</span></summary>
                <div class="aj-cuerpo">
                    <div class="aj-placas">
                        <div class="aj-placa"><label for="c-idioma">{{#str}}centre_lang, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-idioma" name="lang" data-envio-solo>{{#lang}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/lang}}</select></div>
                        <div class="aj-placa con-ayuda"><label for="c-pais">{{#str}}centre_country, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-pais" name="country" aria-describedby="c-pais-a" data-envio-solo>{{#countries}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/countries}}</select><span class="ayuda" id="c-pais-a">{{#str}}centre_country_help, local_oksigeniaeguahe{{/str}}</span></div>
                        <div class="aj-placa"><label for="c-moneda">{{#str}}centre_currency, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-moneda" name="currency" data-envio-solo>{{#currencies}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/currencies}}</select></div>
                        <div class="aj-placa con-ayuda"><label for="c-sistema">{{#str}}centre_system, local_oksigeniaeguahe{{/str}}</label><select class="aj-hueco" id="c-sistema" name="system" aria-describedby="c-sistema-a" data-envio-solo>{{#systems}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/systems}}</select><span class="ayuda" id="c-sistema-a">{{#str}}centre_system_help, local_oksigeniaeguahe{{/str}}</span></div>
                    </div>
                    <div class="aj-guardar aj-sin-js"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-pais" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>

            {{! ===== How a family asks for a place: the two days on their leaves, how, and where ===== }}
            {{#apply}}
            <details class="apartado aj-plegado" id="aj-pedir">
                <summary><h2 id="aj-pedir-t">{{#str}}panel_apply_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura">{{#fromleaf}}<span>{{#str}}panel_read_apply_from, local_oksigeniaeguahe{{/str}} {{day}} {{month}}</span>{{/fromleaf}}{{#untilleaf}}<span>{{#str}}panel_read_apply_until, local_oksigeniaeguahe{{/str}} {{day}} {{month}}</span>{{/untilleaf}}{{^written}}<span>{{#str}}panel_read_apply_none, local_oksigeniaeguahe{{/str}}</span>{{/written}}{{#written}}{{^after}}<span>{{#str}}panel_read_apply_sent, local_oksigeniaeguahe{{/str}}</span>{{/after}}{{/written}}</span></summary>
                <div class="aj-cuerpo">
                    <p class="ayuda aj-pedir-ayuda" id="c-pedir-a">{{#str}}panel_apply_help, local_oksigeniaeguahe{{/str}}</p>
                    <div class="aj-dos aj-pedir-dias">
                        <div class="aj-primer">
                            <span class="hoja-cal aj-primer-hoja{{^fromleaf}} aj-primer-sin{{/fromleaf}}" aria-hidden="true">{{#fromleaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/fromleaf}}{{^fromleaf}}<b>?</b>{{/fromleaf}}</span>
                            <div class="aj-primer-texto"><label id="c-desde-l" for="{{fromdate.first}}">{{#str}}panel_apply_from, local_oksigeniaeguahe{{/str}}</label>{{#fromdate}}{{> local_oksigeniaeguahe/public_date }}{{/fromdate}}</div>
                        </div>
                        <div class="aj-primer">
                            <span class="hoja-cal aj-primer-hoja{{^untilleaf}} aj-primer-sin{{/untilleaf}}" aria-hidden="true">{{#untilleaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/untilleaf}}{{^untilleaf}}<b>?</b>{{/untilleaf}}</span>
                            <div class="aj-primer-texto"><label id="c-hasta-l" for="{{untildate.first}}">{{#str}}panel_apply_until, local_oksigeniaeguahe{{/str}}</label>{{#untildate}}{{> local_oksigeniaeguahe/public_date }}{{/untildate}}</div>
                        </div>
                    </div>
                    <div class="aj-frase">
                        <label for="c-pedir">{{#str}}panel_apply_how, local_oksigeniaeguahe{{/str}}</label>
                        <textarea class="aj-cuaderno" id="c-pedir" name="applyhow" rows="3" placeholder="{{#str}}panel_apply_how_example, local_oksigeniaeguahe{{/str}}">{{how}}</textarea>
                    </div>
                    <div class="aj-frase">
                        <label for="c-pedir-web">{{#str}}panel_apply_url, local_oksigeniaeguahe{{/str}}</label>
                        <input class="aj-hueco aj-hueco-web" id="c-pedir-web" name="applyurl" type="url" value="{{url}}" placeholder="https://" size="40" dir="ltr" autocomplete="off">
                    </div>
                    {{! When the families see it: after the visit (and when sent), or only when someone sends it from their file.
                        Two choices with their lamps, like «Cuándo lo ven las familias» of «Lo que cuesta». }}
                    <div class="aj-frase aj-pedir-cuando">
                        <p class="aj-pedir-cuando-t" id="c-pedir-cuando-t">{{#str}}panel_apply_when, local_oksigeniaeguahe{{/str}}</p>
                        <div class="aj-modos" role="group" aria-labelledby="c-pedir-cuando-t" aria-describedby="c-pedir-cuando-a">
                            <button class="aj-modo" type="submit" name="applyafter" value="1" formaction="{{action}}#aj-pedir" aria-pressed="{{#after}}true{{/after}}{{^after}}false{{/after}}"><span class="lampara" aria-hidden="true"></span><b>{{#str}}panel_apply_when_after, local_oksigeniaeguahe{{/str}}</b><span>{{#str}}panel_apply_when_after_text, local_oksigeniaeguahe{{/str}}</span></button>
                            <button class="aj-modo" type="submit" name="applyafter" value="0" formaction="{{action}}#aj-pedir" aria-pressed="{{^after}}true{{/after}}{{#after}}false{{/after}}"><span class="lampara" aria-hidden="true"></span><b>{{#str}}panel_apply_when_sent, local_oksigeniaeguahe{{/str}}</b><span>{{#str}}panel_apply_when_sent_text, local_oksigeniaeguahe{{/str}}</span></button>
                        </div>
                        <p class="ayuda" id="c-pedir-cuando-a">{{#str}}panel_apply_when_help, local_oksigeniaeguahe{{/str}}</p>
                    </div>
                    <div class="aj-guardar"><button class="boton principal pequeno" type="submit" name="guardar" value="1" formaction="{{action}}#aj-pedir" data-guardar>{{{i.check}}}{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button></div>
                </div>
            </details>
            {{/apply}}

            {{! ===== Who signs up: a family for its children, the student for themselves, or either ===== }}
            <details class="apartado aj-plegado" id="aj-quien">
                <summary><h2 id="aj-quien-t">{{#str}}panel_whoapplies_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura"><span>{{whoapplies.read}}</span></span></summary>
                <div class="aj-cuerpo">
                    <p class="ayuda">{{#str}}panel_whoapplies_help, local_oksigeniaeguahe{{/str}}</p>
                    <div class="aj-modos" role="group" aria-labelledby="aj-quien-t">
                        {{#whoapplies.modes}}<button class="aj-modo" type="submit" name="whoapplies" value="{{value}}" formaction="{{action}}#aj-quien" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"><span class="lampara" aria-hidden="true"></span><b>{{name}}</b></button>{{/whoapplies.modes}}
                    </div>
                </div>
            </details>

            {{! ===== Who hears of each family that comes on its own ===== }}
            {{#notify}}
            <details class="apartado aj-plegado" id="aj-avisos">
                <summary><h2 id="aj-avisos-t">{{#str}}panel_notify_card, local_oksigeniaeguahe{{/str}}</h2><span class="aj-cambiar">{{#str}}panel_offer_change, local_oksigeniaeguahe{{/str}}</span><span class="aj-cerrar">{{#str}}closebuttontitle, core{{/str}}</span>
                    <span class="aj-lectura"><span>{{read}}</span></span></summary>
                <div class="aj-cuerpo">
                    <p class="ayuda">{{#str}}panel_notify_help, local_oksigeniaeguahe{{/str}}</p>
