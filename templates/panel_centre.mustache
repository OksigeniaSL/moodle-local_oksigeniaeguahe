<div class="pagina pagina-ajustes">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    {{#missing}}
    <section class="abrir-admisiones aj-falta" aria-labelledby="aj-falta-t">
        <header class="abrir-cab"><h2 id="aj-falta-t">{{#str}}panel_missing_title, local_oksigeniaeguahe{{/str}}</h2><span class="abrir-cuenta">{{n}}</span></header>
        <p class="aj-falta-lead">{{#str}}panel_missing_lead, local_oksigeniaeguahe{{/str}}</p>
        <ul class="abrir-pasos">
            {{#items}}
            <li class="abrir-paso{{#first}} siguiente{{/first}}">
                <span class="abrir-n" aria-hidden="true">{{{icon}}}</span>
                <span class="abrir-que"><b>{{name}}</b><span>{{what}}</span></span>
                <a class="{{#first}}boton principal pequeno{{/first}}{{^first}}enlace{{/first}}" href="{{url}}">{{go}}<span class="oculto"> · {{name}}</span></a>
            </li>
            {{/items}}
        </ul>
    </section>
    {{/missing}}
    <form class="ajustes" method="post" action="{{action}}" enctype="multipart/form-data" novalidate data-ajustes>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{! Enter in a field presses the first button of the form: this one, which only saves, and never a gesture after it. }}
        <button class="oculto" type="submit" name="guardar" value="1" tabindex="-1" aria-hidden="true">{{#str}}panel_offer_save, local_oksigeniaeguahe{{/str}}</button>
        <nav class="indice-ajustes" aria-label="{{#str}}panel_settings_index, local_oksigeniaeguahe{{/str}}">
            <p class="indice-t">{{#str}}panel_settings_daily, local_oksigeniaeguahe{{/str}}</p>
            <ol>
                <li><a href="#aj-oferta">{{#str}}panel_offer_places, local_oksigeniaeguahe{{/str}}{{#lacks.oferta}}<span class="indice-falta">{{#str}}panel_missing_mark, local_oksigeniaeguahe{{/str}}</span>{{/lacks.oferta}}</a></li>
                <li><a href="#aj-reciben">{{#str}}panel_who_receives, local_oksigeniaeguahe{{/str}}{{#lacks.reciben}}<span class="indice-falta">{{#str}}panel_missing_mark, local_oksigeniaeguahe{{/str}}</span>{{/lacks.reciben}}</a></li>
                {{#hasmessaging}}<li><a href="#aj-canal">{{#str}}centre_messaging, local_oksigeniaeguahe{{/str}}</a></li>{{/hasmessaging}}
            </ol>
            <p class="indice-t">{{#str}}panel_settings_once, local_oksigeniaeguahe{{/str}}</p>
            <ol>
                <li><a href="#aj-aspecto">{{#str}}panel_how_families_see_index, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-contacto">{{#str}}panel_contact_card, local_oksigeniaeguahe{{/str}}{{#lacks.contacto}}<span class="indice-falta">{{#str}}panel_missing_mark, local_oksigeniaeguahe{{/str}}</span>{{/lacks.contacto}}</a></li>
                {{#calendar}}<li><a href="#aj-calendario">{{#str}}panel_cal_card, local_oksigeniaeguahe{{/str}}</a></li>{{/calendar}}
                {{#mailer}}<li><a href="#aj-cartas">{{#str}}mailer_card, local_oksigeniaeguahe{{/str}}</a></li>{{/mailer}}
                <li><a href="#aj-miniatura">{{#str}}panel_miniature_card, local_oksigeniaeguahe{{/str}}{{#lacks.miniatura}}<span class="indice-falta">{{#str}}panel_missing_mark, local_oksigeniaeguahe{{/str}}</span>{{/lacks.miniatura}}</a></li>
                <li><a href="#aj-pais">{{#str}}panel_country_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-pedir">{{#str}}panel_apply_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-quien">{{#str}}panel_whoapplies_card, local_oksigeniaeguahe{{/str}}</a></li>
                {{#notify}}<li><a href="#aj-avisos">{{#str}}panel_notify_card, local_oksigeniaeguahe{{/str}}</a></li>{{/notify}}
                <li><a href="#aj-cifras">{{#str}}panel_metricsfor_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-cuesta">{{#str}}panel_costs_card, local_oksigeniaeguahe{{/str}}</a></li>
                <li><a href="#aj-despues">{{#str}}panel_after_enrolment, local_oksigeniaeguahe{{/str}}{{#lacks.despues}}<span class="indice-falta">{{#str}}panel_missing_mark, local_oksigeniaeguahe{{/str}}</span>{{/lacks.despues}}</a></li>
