{{!
    @template local_oksigeniaeguahe/panel_event_row

    An event in a list: its leaf of the calendar, its name with the kind, the hours, the place and the turns, who
    receives, and how full it is with one bar of one colour; after it, how many came.

    Example context (json):
    {"url": "#", "weekday": "sáb", "day": "21", "month": "nov", "name": "Jornada", "kind": "Jornada de puertas abiertas",
        "hours": "10:00 a 13:00", "place": "Entrada", "slots": "", "receive": [{"name": "Lucía Medina", "photo": "", "initials": "LM"}],
        "load": "31 familias", "percent": 0, "hasbar": false, "closed": false}
}}
<a class="acto" href="{{url}}">
    <span class="hoja-cal"><small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span></span>
    <span class="que"><b>{{name}}</b><span class="secundario">{{kind}} · {{hours}}{{#place}} · {{place}}{{/place}}{{#slots}} · {{slots}}{{/slots}}{{#closed}} · {{#str}}panel_closed_signup, local_oksigeniaeguahe{{/str}}{{/closed}}</span></span>
    <span class="reciben"><span class="pila">{{#receive}}{{#photo}}<img class="cara" src="{{photo}}" alt="" width="32" height="32">{{/photo}}{{^photo}}<span class="cara" aria-hidden="true">{{initials}}</span>{{/photo}}{{/receive}}</span></span>
    <span class="aforo"><span class="cifra">{{load}}</span>{{#hasbar}}<span class="barra-aforo" aria-hidden="true"><i style="width:{{percent}}%"></i></span>{{/hasbar}}</span>
</a>
