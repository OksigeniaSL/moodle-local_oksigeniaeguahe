{{!
    @template local_oksigeniaeguahe/public_frame

    What goes around every page of a family: the centre (its logo and name, or its initials) on its wall with the menu of
    languages, and at the foot the centre, its address, how it treats the data and, small, who makes Eguahe. The page goes
    where «main» is. Under a piece a family shared, the line of who makes Eguahe is its seal: the mark of Eguahe and its
    name, always the same size and in the same place.

    Example context (json):
    {
        "i": {"globe": "", "chev": "", "check": ""}, "centre": "Colegio de ejemplo", "initials": "CE", "logo": "",
        "logoplate": false, "langlabel": "Idioma", "langname": "Español",
        "langs": [{"name": "Español", "url": "#", "current": true, "code": "es"}, {"name": "English", "url": "#",
            "current": false, "code": "en"}],
        "address": "Calle de ejemplo 1", "privacyurl": "#", "privacy": "Cómo tratamos sus datos",
        "credit": {"text": "Eguahe, de Oksigenia", "url": "https://eguahe.com/?de=dibujo", "seal": true}
    }
}}
<header class="cabecera">
    <span class="placa">
        {{#logo}}<span class="logo{{#logoplate}} plato-oscuro{{/logoplate}}"><img src="{{logo}}" alt="" height="40"></span>{{/logo}}
        {{^logo}}<span class="monograma" aria-hidden="true">{{initials}}</span>{{/logo}}
        <span class="nombre">{{centre}}</span>
    </span>
    <details class="idioma">
        <summary aria-label="{{langlabel}}: {{langname}}">{{{i.globe}}}<span>{{langname}}</span>{{{i.chev}}}</summary>
        <ul>
            {{#langs}}<li><a href="{{url}}" hreflang="{{code}}" lang="{{code}}" data-toca="language"{{#current}} aria-current="true"{{/current}}>{{name}}{{#current}}{{{i.check}}}{{/current}}</a></li>{{/langs}}
        </ul>
    </details>
</header>
<main id="main">
<!-- main -->
</main>
<footer class="pie">
    <span>{{centre}}{{#address}} · {{address}}{{/address}}</span>
    <a href="{{privacyurl}}">{{privacy}}</a>
    {{#credit}}<p class="firma{{#seal}} sello{{/seal}}"><a href="{{url}}" target="_blank" rel="noopener">{{#seal}}<svg class="sello-marca" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="14" fill="#36233A"/><g transform="translate(6.4 6.4) scale(0.8)"><path d="M28 15.5 L28 11 C28 8.8 29.8 7 32 7 C34.2 7 36 8.8 36 11 L36 15.5 L34.4 15.5 L34.4 11 C34.4 9.7 33.3 8.6 32 8.6 C30.7 8.6 29.6 9.7 29.6 11 L29.6 15.5 Z" fill="#6E5A6D"/><path d="M48 19 C55 23 56.4 40 54.6 62 L52.4 61.8 C54 41 52.6 25.4 46.6 21.6 Z" fill="#6E5A6D"/><path d="M13 30 C13 21 19.5 14 28.5 14 L35.5 14 C44.5 14 51 21 51 30 L51 55.5 C51 58 49 60 46.5 60 L17.5 60 C15 60 13 58 13 55.5 Z" fill="#6E5A6D"/><path d="M16 22 L16 28.5 C16 31.5 18.4 33.6 21.4 33.6 L42.6 33.6 C45.6 33.6 48 31.5 48 28.5 L48 22 L46.2 22 L46.2 28.5 C46.2 30.5 44.6 31.8 42.6 31.8 L21.4 31.8 C19.4 31.8 17.8 30.5 17.8 28.5 L17.8 22 Z" fill="#36233A"/><g transform="translate(32 47) rotate(-8) scale(0.68)"><path d="M-23 -12 Q-23 -16 -19 -16 L19 -16 Q23 -16 23 -12 L23 8 L15 16 L-19 16 Q-23 16 -23 12 Z" fill="#36233A" stroke="#36233A" stroke-width="3.53" stroke-linejoin="round"/><path d="M-23 -12 Q-23 -16 -19 -16 L19 -16 Q23 -16 23 -12 L23 8 L15 16 L-19 16 Q-23 16 -23 12 Z" fill="#F0947B"/><path d="M-20.6 -6.2 L20.6 -6.2 L20.6 7 L13.8 13.8 L-18.6 13.8 Q-20.6 13.8 -20.6 11.8 Z" fill="#F5ECE3"/><path d="M-15 6.2 L9 6.2 L9 7.9 L-15 7.9 Z" fill="#6F5E6E"/><path d="M23 8 L15 16 L15 8 Z" fill="#CDB8A2"/></g></g></svg>{{/seal}}<span>{{text}}</span></a></p>{{/credit}}
</footer>
