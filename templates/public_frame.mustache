{{!
    @template local_oksigeniaeguahe/public_frame

    What goes around every page of a family: the centre (its logo and name, or its initials) on its wall with the menu of
    languages, and at the foot the centre, its address, how it treats the data and, small, who makes Eguahe. The page goes
    where «main» is. Under a piece a family shared, the line of who makes Eguahe is its seal: the mark of Eguahe and its
    name, always the same size and in the same place.

    Example context (json):
    {
        "i": {"globe": "", "chev": "", "check": ""}, "centre": "Colegio de ejemplo", "initials": "CE", "logo": "",
        "brand": [{"light": "#1f5a4e", "dark": "#5fa08f"}, {"light": "#e8a33d", "dark": "#e8a33d"}], "namevisible": true,
        "langcode": "ES",
        "logodark": "", "logoplate": false, "logoheight": false, "logoheightphone": false, "langlabel": "Idioma", "langname": "Español",
        "langs": [{"name": "Español", "url": "#", "current": true, "code": "es"}, {"name": "English", "url": "#",
            "current": false, "code": "en"}],
        "address": "Calle de ejemplo 1", "privacyurl": "#", "privacy": "Cómo tratamos sus datos",
        "credit": {"text": "Eguahe, de Oksigenia", "url": "https://eguahe.com/?de=dibujo", "seal": true}
    }
}}
{{#brand.0}}<div class="franja-marca" aria-hidden="true">{{#brand}}<span style="--claro: {{light}}; --oscuro: {{dark}}"></span>{{/brand}}</div>{{/brand.0}}
<header class="cabecera">
    <span class="placa">
        {{#logo}}<span class="logo{{#logoplate}} plato-oscuro{{/logoplate}}{{#logodark}} con-oscuro{{/logodark}}"{{#logoheight}} style="--logo-alto: {{logoheight}}px; --logo-alto-movil: {{logoheightphone}}px"{{/logoheight}}><img class="logo-dia" src="{{logo}}" alt="" height="40">{{#logodark}}<img class="logo-noche" src="{{logodark}}" alt="" height="40">{{/logodark}}</span>{{/logo}}
        {{^logo}}<span class="monograma" aria-hidden="true">{{initials}}</span>{{/logo}}
        <span class="nombre{{^namevisible}} oculto{{/namevisible}}">{{centre}}</span>
    </span>
    <details class="idioma">
        <summary aria-label="{{langlabel}}: {{langname}}">{{{i.globe}}}<span class="idioma-largo">{{langname}}</span><span class="idioma-corto" aria-hidden="true">{{langcode}}</span>{{{i.chev}}}</summary>
        <ul>
            {{#langs}}<li><a href="{{url}}" hreflang="{{code}}" lang="{{code}}" data-toca="language"{{#current}} aria-current="true"{{/current}}>{{name}}{{#current}}{{{i.check}}}{{/current}}</a></li>{{/langs}}
        </ul>
    </details>
</header>
<main id="main">
<!-- main -->
</main>
<footer class="pie">
    <span>{{centre}}{{#address}} · {{address}}{{/address}}</span>
    {{#privacyurl}}<a href="{{privacyurl}}">{{privacy}}</a>{{/privacyurl}}
    {{#credit}}<p class="firma{{#seal}} sello{{/seal}}"><a href="{{url}}" target="_blank" rel="noopener">{{#seal}}{{> local_oksigeniaeguahe/public_seal }}{{/seal}}<span>{{text}}</span></a></p>{{/credit}}
</footer>
