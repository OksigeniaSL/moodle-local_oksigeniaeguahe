{{!
    @template local_oksigeniaeguahe/public_frame

    What goes around every page of a family: the centre (its logo and name, or its initials) on its wall with the menu of
    languages, and at the foot the centre, its address, how it treats the data and, small, who makes Eguahe. The page goes
    where «main» is.

    Example context (json):
    {
        "i": {"globe": "", "chev": "", "check": ""}, "centre": "Colegio de ejemplo", "initials": "CE", "logo": "",
        "logoplate": false, "langlabel": "Idioma", "langname": "Español",
        "langs": [{"name": "Español", "url": "#", "current": true, "code": "es"}, {"name": "English", "url": "#",
            "current": false, "code": "en"}],
        "address": "Calle de ejemplo 1", "privacyurl": "#", "privacy": "Cómo tratamos sus datos",
        "credit": {"text": "Eguahe, de Oksigenia", "url": "https://oksigenia.com/"}
    }
}}
<header class="cabecera">
    <span class="placa">
        {{#logo}}<span class="logo{{#logoplate}} plato-oscuro{{/logoplate}}"><img src="{{logo}}" alt="" height="40"></span>{{/logo}}
        {{^logo}}<span class="monograma" aria-hidden="true">{{initials}}</span>{{/logo}}
        <span class="nombre">{{centre}}</span>
    </span>
    <details class="idioma">
        <summary aria-label="{{langlabel}}: {{langname}}">{{{i.globe}}}<span>{{langname}}</span>{{{i.chev}}}</summary>
        <ul>
            {{#langs}}<li><a href="{{url}}" hreflang="{{code}}" lang="{{code}}"{{#current}} aria-current="true"{{/current}}>{{name}}{{#current}}{{{i.check}}}{{/current}}</a></li>{{/langs}}
        </ul>
    </details>
</header>
<main id="main">
<!-- main -->
</main>
<footer class="pie">
    <span>{{centre}}{{#address}} · {{address}}{{/address}}</span>
    <a href="{{privacyurl}}">{{privacy}}</a>
    {{#credit}}<p class="firma"><a href="{{url}}" target="_blank" rel="noopener">{{text}}</a></p>{{/credit}}
</footer>
