{{!
    @template local_oksigeniaeguahe/metrics

    The numbers of a centre, each with its definition: the first answer in Eguahe; a past campaign from the first
    contact to the enrolment, by channel (first and last contact), campaign, platform, month and course, with what it
    cost; who came and went in a school year; the students of the years before.

    Example context (json):
    {
        "tabs": [], "canact": true, "importurl": "#", "empty": false,
        "response": {"median": 3.5, "hasmedian": true, "answered": 12, "waiting": 2},
        "campaign": {"label": "2025-26", "options": [{"id": 1, "label": "2025-26", "selected": true}],
            "steps": [{"name": "Hogares", "value": 600, "width": 100}, {"name": "Matriculados", "value": 90, "width": 15}],
            "contacts": 831, "households": 600, "rate": "15,0", "visitrate": "40,0", "spend": "3.000,00", "cost": "33,33",
            "hascost": true, "sesskey": "abc", "action": "#",
            "channels": [{"key": "meta", "label": "Anuncios de Meta", "households": 450, "visited": 60, "enrolled": 50,
                "lastenrolled": 48, "rate": "11,1", "spendvalue": "3.000,00", "cost": "60,00"}],
            "sources": [], "platforms": [], "hasplatforms": false, "months": [], "grades": []},
        "year": {"schoolyear": "2026-27", "options": [{"value": "2026-27", "selected": true}], "startday": "1/09/2026",
            "totals": {"start": 1800, "joins": 20, "leaves": 25, "net": -5, "now": 1795},
            "bygrade": [{"grade": "1º de ESO", "start": 120, "joins": 3, "leaves": 2, "net": 1, "now": 121}],
            "bymonth": [{"month": "2026-10", "name": "octubre 2026", "joins": 4, "leaves": 3}], "hasmonths": true,
            "reasons": [{"reason": "Traslado de domicilio", "count": 7}], "hasreasons": true,
            "places": [{"code": "28065", "locality": "Getafe", "students": 900, "sharetext": "50,1"}]},
        "history": {"years": [{"year": "2024-25"}], "rows": [{"grade": "1º de ESO", "cells": [{"value": 120}]}],
            "totals": [{"value": 1800}]}
    }
}}
<div class="eguahe eguahe-metrics">
    {{> local_oksigeniaeguahe/tabs }}
    <div class="eguahe-head">
        <p class="eguahe-quiet">{{#str}}metrics_intro, local_oksigeniaeguahe{{/str}}</p>
        {{#canact}}<a class="btn btn-secondary" href="{{importurl}}">{{#str}}import, local_oksigeniaeguahe{{/str}}</a>{{/canact}}
    </div>

    <section class="eguahe-box">
        <h3>{{#str}}metrics_now, local_oksigeniaeguahe{{/str}}</h3>
        <p>
            {{#response.hasmedian}}{{#str}}metrics_median, local_oksigeniaeguahe, {{response.median}}{{/str}} · {{/response.hasmedian}}
            {{#str}}metrics_answered, local_oksigeniaeguahe, {{response.answered}}{{/str}} · {{#str}}metrics_waiting, local_oksigeniaeguahe, {{response.waiting}}{{/str}}
        </p>
        <p class="eguahe-quiet">{{#str}}metrics_now_def, local_oksigeniaeguahe{{/str}}</p>
    </section>

    {{#empty}}<div class="eguahe-empty"><p>{{#str}}metrics_empty, local_oksigeniaeguahe{{/str}}</p></div>{{/empty}}

    {{#campaign}}
    <section class="eguahe-box">
        <form class="eguahe-inline" method="get" action="{{action}}">
            <h3>{{#str}}metrics_campaign, local_oksigeniaeguahe{{/str}}</h3>
            <label class="visually-hidden" for="eguahe-campaign">{{#str}}metrics_campaign, local_oksigeniaeguahe{{/str}}</label>
            <select class="form-select custom-select" id="eguahe-campaign" name="campaign">
                {{#options}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
            </select>
            <button type="submit" class="btn btn-secondary">{{#str}}metrics_show, local_oksigeniaeguahe{{/str}}</button>
        </form>
        <ol class="eguahe-funnel">
            {{#steps}}<li><span class="eguahe-funnel-name">{{name}}</span><span class="eguahe-funnel-bar" style="width: {{width}}%"></span><span class="eguahe-num">{{value}}</span></li>{{/steps}}
        </ol>
        <p>{{#str}}metrics_rates, local_oksigeniaeguahe, { "rate": "{{rate}}", "visitrate": "{{visitrate}}", "contacts": {{contacts}}, "households": {{households}} }{{/str}}{{#hascost}} · {{#str}}metrics_cost_total, local_oksigeniaeguahe, { "spend": "{{spend}}", "cost": "{{cost}}" }{{/str}}{{/hascost}}</p>
        <p class="eguahe-quiet">{{#str}}metrics_funnel_def, local_oksigeniaeguahe{{/str}}</p>

        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <h4>{{#str}}metrics_bychannel, local_oksigeniaeguahe{{/str}}</h4>
            <table class="table eguahe-table">
                <thead><tr>
                    <th scope="col">{{#str}}channel, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_households, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_visited, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_enrolled_first, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_enrolled_last, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">%</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_spend, local_oksigeniaeguahe{{/str}}</th>
                    <th scope="col" class="eguahe-num">{{#str}}metrics_cost, local_oksigeniaeguahe{{/str}}</th>
                </tr></thead>
                <tbody>
                {{#channels}}
                    <tr>
                        <th scope="row">{{label}}</th>
                        <td class="eguahe-num">{{households}}</td>
                        <td class="eguahe-num">{{visited}}</td>
                        <td class="eguahe-num">{{enrolled}}</td>
                        <td class="eguahe-num">{{lastenrolled}}</td>
                        <td class="eguahe-num">{{rate}}</td>
                        <td class="eguahe-num">{{#canact}}<label class="visually-hidden" for="spend-{{key}}">{{#str}}metrics_spend, local_oksigeniaeguahe{{/str}} · {{label}}</label><input class="form-control eguahe-money" id="spend-{{key}}" type="text" inputmode="decimal" name="amount[{{key}}|]" value="{{spendvalue}}">{{/canact}}{{^canact}}{{spendvalue}}{{/canact}}</td>
                        <td class="eguahe-num">{{cost}}</td>
                    </tr>
                {{/channels}}
                </tbody>
            </table>
            {{#canact}}<p><button type="submit" class="btn btn-secondary">{{#str}}metrics_spend_save, local_oksigeniaeguahe{{/str}}</button></p>{{/canact}}
        </form>
        <p class="eguahe-quiet">{{#str}}metrics_channel_def, local_oksigeniaeguahe{{/str}}</p>

        <h4>{{#str}}metrics_bysource, local_oksigeniaeguahe{{/str}}</h4>
        <table class="table eguahe-table">
            <thead><tr>
                <th scope="col">{{#str}}metrics_source, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_households, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_visited, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_enrolled, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">%</th>
            </tr></thead>
            <tbody>{{#sources}}<tr><th scope="row">{{label}}</th><td class="eguahe-num">{{households}}</td><td class="eguahe-num">{{visited}}</td><td class="eguahe-num">{{enrolled}}</td><td class="eguahe-num">{{rate}}</td></tr>{{/sources}}</tbody>
        </table>

        {{#hasplatforms}}
        <h4>{{#str}}metrics_byplatform, local_oksigeniaeguahe{{/str}}</h4>
        <table class="table eguahe-table">
            <tbody>{{#platforms}}<tr><th scope="row">{{label}}</th><td class="eguahe-num">{{households}}</td><td class="eguahe-num">{{enrolled}}</td><td class="eguahe-num">{{rate}} %</td></tr>{{/platforms}}</tbody>
        </table>
        {{/hasplatforms}}

        <div class="eguahe-columns">
            <div>
                <h4>{{#str}}metrics_bymonth, local_oksigeniaeguahe{{/str}}</h4>
                <table class="table eguahe-table">
                    <tbody>{{#months}}<tr><th scope="row">{{label}}</th><td class="eguahe-num">{{households}}</td><td class="eguahe-num">{{enrolled}}</td></tr>{{/months}}</tbody>
                </table>
            </div>
            <div>
                <h4>{{#str}}metrics_bygrade, local_oksigeniaeguahe{{/str}}</h4>
                <table class="table eguahe-table">
                    <tbody>{{#grades}}<tr><th scope="row">{{label}}</th><td class="eguahe-num">{{households}}</td><td class="eguahe-num">{{enrolled}}</td></tr>{{/grades}}</tbody>
                </table>
            </div>
        </div>
    </section>
    {{/campaign}}

    {{#year}}
    <section class="eguahe-box">
        <form class="eguahe-inline" method="get">
            <h3>{{#str}}metrics_year, local_oksigeniaeguahe{{/str}}</h3>
            <label class="visually-hidden" for="eguahe-year">{{#str}}metrics_year, local_oksigeniaeguahe{{/str}}</label>
            <select class="form-select custom-select" id="eguahe-year" name="year">{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>{{/options}}</select>
            <button type="submit" class="btn btn-secondary">{{#str}}metrics_show, local_oksigeniaeguahe{{/str}}</button>
        </form>
        <p class="eguahe-balance">{{#str}}metrics_balance, local_oksigeniaeguahe, { "start": {{totals.start}}, "joins": {{totals.joins}}, "leaves": {{totals.leaves}}, "net": {{totals.net}}, "now": {{totals.now}} }{{/str}}</p>
        <p class="eguahe-quiet">{{#str}}metrics_balance_def, local_oksigeniaeguahe, {{startday}}{{/str}}</p>
        <table class="table eguahe-table">
            <thead><tr>
                <th scope="col">{{#str}}offer, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_start, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_joins, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_leaves, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_net, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}metrics_nowcol, local_oksigeniaeguahe{{/str}}</th>
            </tr></thead>
            <tbody>{{#bygrade}}<tr><th scope="row">{{grade}}</th><td class="eguahe-num">{{start}}</td><td class="eguahe-num">{{joins}}</td><td class="eguahe-num">{{leaves}}</td><td class="eguahe-num">{{net}}</td><td class="eguahe-num">{{now}}</td></tr>{{/bygrade}}</tbody>
        </table>
        <div class="eguahe-columns">
            <div>
                {{#hasreasons}}
                <h4>{{#str}}metrics_reasons, local_oksigeniaeguahe{{/str}}</h4>
                <table class="table eguahe-table"><tbody>{{#reasons}}<tr><th scope="row">{{reason}}</th><td class="eguahe-num">{{count}}</td></tr>{{/reasons}}</tbody></table>
                {{/hasreasons}}
                {{#hasmonths}}
                <h4>{{#str}}metrics_bymonth_moves, local_oksigeniaeguahe{{/str}}</h4>
                <table class="table eguahe-table">
                    <thead><tr><th scope="col"><span class="visually-hidden">{{#str}}month{{/str}}</span></th><th scope="col" class="eguahe-num">{{#str}}metrics_joins, local_oksigeniaeguahe{{/str}}</th><th scope="col" class="eguahe-num">{{#str}}metrics_leaves, local_oksigeniaeguahe{{/str}}</th></tr></thead>
                    <tbody>{{#bymonth}}<tr><th scope="row">{{name}}</th><td class="eguahe-num">{{joins}}</td><td class="eguahe-num">{{leaves}}</td></tr>{{/bymonth}}</tbody>
                </table>
                {{/hasmonths}}
            </div>
            <div>
                <h4>{{#str}}metrics_places, local_oksigeniaeguahe{{/str}}</h4>
                <table class="table eguahe-table"><tbody>{{#places}}<tr><th scope="row">{{locality}} <span class="eguahe-quiet">{{code}}</span></th><td class="eguahe-num">{{students}}</td><td class="eguahe-num">{{sharetext}} %</td></tr>{{/places}}</tbody></table>
            </div>
        </div>
    </section>
    {{/year}}

    {{#history}}
    <section class="eguahe-box">
        <h3>{{#str}}metrics_history, local_oksigeniaeguahe{{/str}}</h3>
        <div class="eguahe-scroll">
        <table class="table eguahe-table">
            <thead><tr><th scope="col">{{#str}}offer, local_oksigeniaeguahe{{/str}}</th>{{#years}}<th scope="col" class="eguahe-num">{{year}}</th>{{/years}}</tr></thead>
            <tbody>{{#rows}}<tr><th scope="row">{{grade}}</th>{{#cells}}<td class="eguahe-num">{{value}}</td>{{/cells}}</tr>{{/rows}}</tbody>
            <tfoot><tr><th scope="row">{{#str}}metrics_total, local_oksigeniaeguahe{{/str}}</th>{{#totals}}<td class="eguahe-num"><strong>{{value}}</strong></td>{{/totals}}</tr></tfoot>
        </table>
        </div>
        <p class="eguahe-quiet">{{#str}}metrics_history_def, local_oksigeniaeguahe{{/str}}</p>
    </section>
    {{/history}}
</div>
