{{!
    @template local_oksigeniaeguahe/public_probar

    Trying Eguahe without an account: what the visitor will find, one tick against robots, and in.

    Example context (json):
    {"heading": "Probar Eguahe", "lead": "Un centro de ejemplo para quien lo prueba.",
     "points": [{"text": "Familias inventadas."}, {"text": "No se manda nada."}], "error": "", "action": "#",
     "go": "Entrar en el centro de ejemplo", "altchaurl": "#", "altchaconfig": "{}", "altchalang": "es-es",
     "altchai18n": "es-es", "entryurl": "#", "entry": "Ya tengo cuenta", "dog": "#", "dog2x": "#", "hello": "¡Pasen!",
     "base": "/", "version": 1}
}}
<section class="pared corta entrar">
    <figure class="entrar-perro">
        <img src="{{dog}}" srcset="{{dog}} 1x, {{dog2x}} 2x" alt="" width="128" height="128">
        <figcaption class="mano">{{hello}}</figcaption>
    </figure>
    <div class="mensaje">
        <h1>{{heading}}</h1>
        <p class="entradilla">{{lead}}</p>
        <ul class="probar-puntos">
            {{#points}}<li>{{text}}</li>{{/points}}
        </ul>
        {{#error}}<p class="entrar-error" role="alert">{{error}}</p>{{/error}}
        <form class="entrar-form" method="post" action="{{action}}">
            <div class="robot" id="altcha">
                <altcha-widget challenge="{{altchaurl}}" language="{{altchalang}}" configuration="{{altchaconfig}}"></altcha-widget>
            </div>
            <div class="acciones">
                <button class="boton principal" type="submit">{{go}}</button>
                <a class="enlace" href="{{entryurl}}">{{entry}}</a>
            </div>
        </form>
    </div>
</section>
<script type="module" src="{{base}}altcha/altcha.min.js?v={{version}}"></script>
{{#altchai18n}}<script type="module" src="{{base}}altcha/i18n-{{altchai18n}}.js?v={{version}}"></script>{{/altchai18n}}
