{{!
    @template local_oksigeniaeguahe/panel_renewal

    Who goes on (renewal.php): the centre asks its families, for a school year, whether each child goes on. Before
    asking or once closed, the school years it can ask about, each a button; while it asks, since when and until when (a
    leaf of the calendar), writing once to whoever has not answered, and stopping. Then each course, with where its
    children go and how many go on, and its children: who does not go on first, then who does not know, who said
    nothing and who goes on, with the three answers for what a family told a person. And the families that were already
    at the centre, from its roll (the common family record): where the course of each student comes from, the school
    year they are in, what each cohort, group or value is, and bringing them. Without JavaScript, each touch is a form.

    Example context (json):
    {
        "i": {"check": "", "buscar": "", "chev": "", "atras": ""},
        "head": {"title": "Quién sigue", "ante": "Curso 2028-29", "sub": "Han contestado 3 de 5.",
            "back": {"url": "#", "name": "Bandeja"}, "action": false},
        "start": false,
        "open": {"since": "Se pregunta desde el jueves, 12 de noviembre de 2026.", "until": "Hasta el lunes, 15 de marzo de 2027.",
            "leaf": {"weekday": "lun", "day": "15", "month": "mar"}, "hasend": true,
            "date": {"id": "rm-hasta", "first": "rm-hastad", "form": false, "child": false, "invalid": false, "labelled": false,
                "arialabel": "Último día para contestar", "describedby": false, "mirror": false, "value": "2027-03-15",
                "parts": [{"key": "d", "id": "rm-hastad", "name": "untild", "label": "Día", "value": "15", "size": 2, "months": false}]},
            "tell": "Escribir a las 2 familias que no han contestado", "told": "", "sending": ""},
        "roster": {"students": "Alumnos en Family: 312", "nameless": "Sin cuenta de Moodle: 24.",
            "kinds": [{"key": "cohort", "arg": "", "label": "En las cohortes", "pressed": true}], "kind": "cohort", "arg": "",
            "years": [{"year": "2026-27", "label": "Curso 2026-27", "pressed": true}], "year": "2026-27", "noyear": false, "nooffer": "",
            "hasvalues": true, "values": [{"pending": true}], "summary": "Con su curso: 290 de 312 alumnos.",
            "guesses": "Dar por buenos los propuestos (1)", "canbring": true, "brought": "", "open": true,
            "rack": [{"key": "s006", "name": "Primaria", "ages": "de 6 a 11 años", "grades": [
                {"value": "1.º de Primaria", "hook": "1.º de Primaria", "name": "1.º de Primaria", "tags": [{"id": "a1", "value": "1.º Primaria A",
                    "count": "Alumnos: 24", "guess": true, "grade": "1.º de Primaria", "picked": false, "url": "#"}]},
                {"value": "2.º de Primaria", "hook": "2.º de Primaria", "name": "2.º de Primaria", "tags": []}]}],
            "hasloose": true, "loose": [{"id": "b2", "value": "3.º B", "count": "Alumnos: 22", "guess": false, "grade": "",
                "picked": true, "url": "#"}],
            "notcourses": [{"id": "c3", "value": "Comedor", "count": "Alumnos: 80", "guess": false, "grade": "", "picked": false,
                "url": "#"}],
            "picked": {"id": "b2", "value": "3.º B", "count": "Alumnos: 22"}, "dropurl": "/local/oksigeniaeguahe/renewal.php?c=1"},
        "hasgroups": true, "canact": true, "action": "/local/oksigeniaeguahe/renewal.php?c=1", "sesskey": "abc",
        "groups": [{"offerid": 7, "title": "Infantil 3 años", "next": "Pasan a Infantil 4 años", "count": "1 de 2 siguen", "leave": 1, "listed": true, "listurl": "",
            "rows": [{"id": 4, "kind": "leave", "tag": "Leo", "adults": "Marta Ruiz", "url": "#", "said": "Lo dijo la familia el 3/12/26: no sigue.",
                "note": "", "search": "leo", "answers": [{"key": "stay", "label": "Sigue", "pressed": false},
                {"key": "leave", "label": "No sigue", "pressed": true}, {"key": "unsure", "label": "No lo saben", "pressed": false}]}]}]
    }
}}
<div class="pagina pagina-quien-sigue">
    {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
    <section class="quien-sigue-pregunta" id="pregunta" aria-label="{{#str}}panel_renewal_question, local_oksigeniaeguahe{{/str}}">
        {{#start}}
        {{#closed}}<p class="pd-dia"><b>{{closed}}</b></p>{{/closed}}
        {{#hascandidates}}
        <p>{{#str}}panel_renewal_pick, local_oksigeniaeguahe{{/str}}</p>
        <div class="quien-sigue-anos">
            {{#candidates}}
            <form method="post" action="{{action}}#pregunta">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="start"><input type="hidden" name="year" value="{{year}}">
                <button class="hoja-ano" type="submit"{{^ready}} disabled{{/ready}}{{^canact}} disabled{{/canact}}><b>{{label}}</b><span>{{line}}</span></button>
            </form>
            {{/candidates}}
        </div>
        {{/hascandidates}}
        {{^hascandidates}}<p class="secundario">{{#str}}panel_renewal_none_yet, local_oksigeniaeguahe{{/str}}</p>{{/hascandidates}}
        {{#closed}}{{#canact}}
        <form method="post" action="{{action}}#pregunta">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="reopen">
            <button class="enlace" type="submit">{{#str}}panel_renewal_reopen, local_oksigeniaeguahe{{/str}}</button>
        </form>
        {{/canact}}{{/closed}}
        {{/start}}
        {{#open}}
        <div class="pd-fecha{{^hasend}} pd-falta{{/hasend}}">
            <span class="hoja-cal pd-hoja" aria-hidden="true">{{#leaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/leaf}}</span>
            <div class="pd-texto">
                <p class="pd-dia"><b>{{until}}</b> <span>{{since}}</span></p>
                {{#told}}<p class="secundario">{{told}}</p>{{/told}}
                {{#sending}}<p class="secundario" role="status">{{sending}}</p>{{/sending}}
                {{#canact}}
                <div class="pd-acciones">
                    {{#tell}}
                    <form method="post" action="{{action}}#pregunta">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="tell">
                        <button class="boton principal" type="submit">{{tell}}</button>
                    </form>
                    {{/tell}}
                    <details class="pd-otra">
                        <summary>{{#hasend}}{{#str}}panel_renewal_change_end, local_oksigeniaeguahe{{/str}}{{/hasend}}{{^hasend}}{{#str}}panel_renewal_set_end, local_oksigeniaeguahe{{/str}}{{/hasend}}</summary>
                        <form method="post" action="{{action}}#pregunta" class="pd-cambiar">
                            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="until">
                            {{#date}}{{> local_oksigeniaeguahe/public_date }}{{/date}}
                            <button class="boton principal pequeno" type="submit">{{#str}}panel_firstday_course_save, local_oksigeniaeguahe{{/str}}</button>
                        </form>
                        {{#hasend}}
                        <form method="post" action="{{action}}#pregunta">
                            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="noend">
                            <button class="enlace" type="submit">{{#str}}panel_renewal_no_end_button, local_oksigeniaeguahe{{/str}}</button>
                        </form>
                        {{/hasend}}
                    </details>
                    <form method="post" action="{{action}}#pregunta">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="stop">
                        <button class="enlace" type="submit">{{#str}}panel_renewal_stop, local_oksigeniaeguahe{{/str}}</button>
                    </form>
                </div>
                {{/canact}}
            </div>
        </div>
        {{/open}}
    </section>
    {{#roster}}
    <details class="apartado padron" id="padron"{{#open}} open{{/open}}>
        <summary><h2>{{#str}}panel_roster, local_oksigeniaeguahe{{/str}}</h2> <span class="secundario">{{students}}</span></summary>
        <p>{{#str}}panel_roster_help, local_oksigeniaeguahe{{/str}}</p>
        {{#nameless}}<p class="secundario">{{nameless}}</p>{{/nameless}}
        <p class="padron-etiqueta">{{#str}}panel_roster_where, local_oksigeniaeguahe{{/str}}</p>
        <div class="padron-fichas">
            {{#kinds}}
            <form method="post" action="{{action}}#padron">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rosterkind"><input type="hidden" name="kind" value="{{key}}"><input type="hidden" name="arg" value="{{arg}}">
                <button class="ficha-boton" type="submit" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"{{^canact}} disabled{{/canact}}>{{label}}</button>
            </form>
            {{/kinds}}
        </div>
        {{#kind}}
        <p class="padron-etiqueta">{{#str}}panel_roster_year, local_oksigeniaeguahe{{/str}}</p>
        <div class="padron-fichas">
            {{#years}}
            <form method="post" action="{{action}}#padron">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rosteryear"><input type="hidden" name="year" value="{{year}}">
                <button class="hoja-ano padron-ano" type="submit" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"{{^canact}} disabled{{/canact}}><small>{{#str}}offer_year, local_oksigeniaeguahe{{/str}}</small><b>{{year}}</b></button>
            </form>
            {{/years}}
        </div>
        {{/kind}}
        {{#nooffer}}<p class="padron-aviso">{{nooffer}}</p>{{/nooffer}}
        {{#hasvalues}}
        <p class="padron-resumen"><b>{{summary}}</b></p>
        {{#canact}}{{#guesses}}
        <form method="post" action="{{action}}#padron">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rosteraccept">
            <button class="boton secundario pequeno" type="submit">{{guesses}}</button>
        </form>
        {{/guesses}}{{/canact}}
        {{#picked}}
        <div class="padron-tengo" id="padron-tengo" role="status">
            <span class="padron-tag padron-tag-alzada"><b dir="auto">{{value}}</b><span>{{count}}</span></span>
            <p>{{#str}}panel_roster_hang, local_oksigeniaeguahe, {{value}}{{/str}}</p>
            <a class="enlace" href="{{dropurl}}">{{#str}}panel_roster_drop, local_oksigeniaeguahe{{/str}}</a>
        </div>
        {{/picked}}
        {{#hasloose}}
        <div class="padron-bandeja" aria-labelledby="padron-sueltas">
            <p class="padron-etiqueta" id="padron-sueltas">{{#str}}panel_roster_loose, local_oksigeniaeguahe{{/str}}</p>
            <ul class="padron-tags">{{#loose}}<li><a class="padron-tag{{#picked}} padron-tag-alzada{{/picked}}" href="{{url}}" id="pv{{id}}"><b dir="auto">{{value}}</b><span>{{count}}</span></a></li>{{/loose}}</ul>
        </div>
        {{/hasloose}}
        <form class="padron-perchero" method="post" action="{{action}}#padron-perchero" id="padron-perchero">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rostermap">
            {{#picked}}<input type="hidden" name="value" value="{{value}}">{{/picked}}
            {{#rack}}
            <section class="padron-etapa" aria-labelledby="pe-{{key}}">
                <h3 id="pe-{{key}}">{{name}} <span class="secundario">{{ages}}</span></h3>
                <ul class="padron-ganchos">
                    {{#grades}}
                    <li class="padron-gancho{{#tags.0}} con-algo{{/tags.0}}">
                        {{#picked}}<button class="padron-pomo" type="submit" name="grade" value="{{hook}}"{{^canact}} disabled{{/canact}}><span class="oculto">{{#str}}panel_roster_hang_here, local_oksigeniaeguahe{{/str}}: </span>{{name}}</button>{{/picked}}
                        {{^picked}}<span class="padron-pomo">{{name}}</span>{{/picked}}
                        <ul class="padron-colgadas">{{#tags}}<li><a class="padron-tag{{#guess}} padron-tag-propuesta{{/guess}}" href="{{url}}" id="pv{{id}}"><b dir="auto">{{value}}</b><span>{{count}}</span></a>{{#guess}}{{#canact}}<button class="padron-si" type="submit" form="pf{{id}}" aria-label="{{#str}}panel_roster_yes, local_oksigeniaeguahe, {{value}}{{/str}}">{{{i.check}}}</button>{{/canact}}{{/guess}}</li>{{/tags}}</ul>
                    </li>
                    {{/grades}}
                </ul>
            </section>
            {{/rack}}
            <section class="padron-etapa padron-cajon" aria-labelledby="pe-no">
                <h3 id="pe-no">{{#str}}panel_roster_none_box, local_oksigeniaeguahe{{/str}}</h3>
                {{#picked}}<button class="padron-pomo padron-pomo-no" type="submit" name="grade" value=""{{^canact}} disabled{{/canact}}>{{#str}}panel_roster_none, local_oksigeniaeguahe{{/str}}</button>{{/picked}}
                <ul class="padron-tags">{{#notcourses}}<li><a class="padron-tag padron-tag-no" href="{{url}}" id="pv{{id}}"><b dir="auto">{{value}}</b><span>{{count}}</span></a></li>{{/notcourses}}</ul>
            </section>
        </form>
        {{#rack}}{{#grades}}{{#tags}}{{#guess}}<form id="pf{{id}}" method="post" action="{{action}}#padron-perchero"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rostermap"><input type="hidden" name="value" value="{{value}}"><input type="hidden" name="grade" value="{{grade}}"></form>{{/guess}}{{/tags}}{{/grades}}{{/rack}}
        {{#canact}}{{#canbring}}
        <form method="post" action="{{action}}#padron">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rostersync">
            <button class="boton principal" type="submit">{{#str}}panel_roster_bring, local_oksigeniaeguahe{{/str}}</button>
        </form>
        {{/canbring}}{{/canact}}
        {{#brought}}<p class="secundario">{{brought}}</p>{{/brought}}
        {{/hasvalues}}
        {{#kind}}{{#canact}}
        <form method="post" action="{{action}}#padron">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="rosteroff">
            <button class="enlace" type="submit">{{#str}}panel_roster_off, local_oksigeniaeguahe{{/str}}</button>
        </form>
        {{/canact}}{{/kind}}
    </details>
    {{/roster}}
    {{#hasgroups}}
    <section class="llegadas primer-dia quien-sigue" aria-label="{{#str}}panel_renewal, local_oksigeniaeguahe{{/str}}">
        <div class="buscar-puerta">
            <label class="buscar"><span class="oculto">{{#str}}panel_firstday_search, local_oksigeniaeguahe{{/str}}</span>{{{i.buscar}}}<input type="search" data-filtrar=".empieza" placeholder="{{#str}}panel_firstday_search, local_oksigeniaeguahe{{/str}}" spellcheck="false" autocomplete="off"></label>
        </div>
        {{#groups}}
        <details class="turno-p" open id="curso{{offerid}}">
            <summary><span class="hora">{{title}}</span><span class="sigue-riel" aria-hidden="true">{{#rows}}<i class="peg-{{kind}}"></i>{{/rows}}</span><span class="cuantos"><span>{{count}}</span>{{{i.chev}}}</span></summary>
            <p class="secundario quien-sigue-pasan">{{next}}</p>
            {{^listed}}<p class="quien-sigue-lista"><a class="enlace" href="{{listurl}}">{{#str}}panel_renewal_list_course, local_oksigeniaeguahe{{/str}}</a></p>{{/listed}}
            {{#rows}}
            <div class="empieza sigue-{{kind}}" id="n{{id}}" data-buscar="{{search}}">
                <div class="quien"><b><a href="{{url}}">{{adults}}</a></b><span class="ninos-l"><span class="nino"><span class="etq etq-puerta" translate="no" dir="auto">{{tag}}</span>{{#answers}}{{#pressed}}<span class="sello-sigue sello-{{key}}">{{label}}</span>{{/pressed}}{{/answers}}<span class="curso">{{said}}</span></span></span>{{#note}}<span class="sigue-nota" dir="auto">{{note}}</span>{{/note}}</div>
                {{#canact}}
                <form class="quien-sigue-botones respuesta3" method="post" action="{{action}}#n{{id}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="answer"><input type="hidden" name="child" value="{{id}}">
                    {{#answers}}<button class="eleccion" type="submit" name="answer" value="{{key}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/answers}}
                </form>
                {{/canact}}
            </div>
            {{/rows}}
        </details>
        {{/groups}}
        <p class="secundario sin-resultados" hidden>{{#str}}panel_search_none, local_oksigeniaeguahe{{/str}}</p>
    </section>
    {{/hasgroups}}
</div>
