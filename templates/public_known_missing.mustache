{{!
    @template local_oksigeniaeguahe/public_known_missing

    What is left to be written to by the phones they marked: a line for each one not joined yet, with its button and, at a
    computer, the code to point the phone at; and that until then they are written to by email.

    Example context (json):
    {
        "missing": {"hasrows": true, "rows": [{"label": "Falta unir WhatsApp", "url": "#", "icon": "", "open": "Abrir WhatsApp", "qr": "",
            "qrline": "¿Están en el ordenador? Apunten la cámara del teléfono a este código."}],
            "until": "Hasta entonces, les seguimos escribiendo por correo."}
    }
}}
{{#missing}}{{#rows}}<div class="unir-falta"><p><b>{{label}}</b> <a class="unir-abrir" href="{{url}}" target="_blank" rel="noopener noreferrer">{{{icon}}}<span>{{open}}</span></a></p>{{#qr}}<div class="unir-codigo"><span>{{{qr}}}</span><small>{{qrline}}</small></div>{{/qr}}</div>{{/rows}}{{#until}}<p class="unir-hasta">{{until}}</p>{{/until}}{{/missing}}
