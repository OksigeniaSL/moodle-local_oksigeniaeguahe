{{!
    @template local_oksigeniaeguahe/panel_notices

    What the centre sends a family by itself, on its file. First what is still to go and what did not go and still could;
    then the last ones; and those before, folded.

    Example context (json):
    {
        "hasnotices": true, "sesskey": "abc", "action": "#", "ahead": [], "hasolder": true,
        "recent": [{"id": 4, "kind": "invitation", "name": "Su cita", "what": "Visita", "day": "jueves 26 de noviembre, 10:00", "state": "sent", "went": true, "didnot": false, "isqueued": false, "isunknown": false, "text": "Salió por correo hoy a las 8:15", "again": true, "sesskey": "abc", "action": "#"}],
        "older": [{"id": 4, "kind": "invitation", "name": "Su cita", "what": "Visita", "day": "jueves 26 de noviembre, 10:00", "state": "sent", "went": true, "didnot": false, "isqueued": false, "isunknown": false, "text": "Salió por correo hoy a las 8:15", "again": true, "sesskey": "abc", "action": "#"}]
    }
}}
{{#hasnotices}}
<section class="apartado sus-avisos" aria-labelledby="sus-avisos-t">
    <header><h2 id="sus-avisos-t">{{#str}}notice_title, local_oksigeniaeguahe{{/str}}</h2></header>
    {{#ahead}}{{> local_oksigeniaeguahe/panel_notice }}{{/ahead}}
    {{#recent}}{{> local_oksigeniaeguahe/panel_notice }}{{/recent}}
    {{#hasolder}}<details class="avisos-antes"><summary>{{#str}}notice_before, local_oksigeniaeguahe{{/str}}{{{i.chev}}}</summary>{{#older}}{{> local_oksigeniaeguahe/panel_notice }}{{/older}}</details>{{/hasolder}}
</section>
{{/hasnotices}}
