{{#measure}}<span class="mide" data-mide="{{url}}" data-sesskey="{{sesskey}}" data-de="{{de}}" hidden></span>{{/measure}}
{{#hall}}
<div class="sala-familia" data-vestibulo data-escena="{{json}}" data-base="{{base}}" aria-hidden="true"><div class="sala"></div></div>
{{/hall}}
<section class="pared{{#hall}} con-sala{{/hall}}" aria-labelledby="titulo" data-parte="wall">
    <div class="saludo-arriba">
        <h1 class="titular" id="titulo">{{greeting}}{{#names}} <span class="mano-titular" translate="no" dir="auto">{{names}}</span>{{/names}}</h1>
    </div>
    <div class="riel" aria-hidden="true"></div>
    <div class="heroe-ancho">
        {{#pegs}}{{> local_oksigeniaeguahe/public_pegs }}{{/pegs}}
        <div class="bajo-riel">
            <p class="entradilla">{{{lead}}}</p>
            {{#new}}
            <div class="aviso en-heroe" role="status">
                <span class="icono">{{{i.check}}}</span>
                <p><b>{{saved}}.</b> {{savedline}} {{emailed}}</p>
            </div>
            {{/new}}
            {{#outcome}}<p class="lo-que-hacemos"><b>{{title}}</b> <span dir="auto">{{text}}</span></p>{{/outcome}}
            {{#stories}}
            <a class="cuento-tarjeta" href="{{url}}">
                <span class="cuento-portada" aria-hidden="true"><img src="{{cover}}" alt="" loading="lazy"></span>
                <span class="cuento-que"><span class="cuento-etiqueta" dir="auto">{{kicker}}</span><b>{{title}}</b><span>{{lead}}</span></span>
            </a>
            {{/stories}}
            {{#turns}}
            <form class="le-toca" method="post" action="{{action}}" id="le-toca-{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="siblingconfirm"><input type="hidden" name="hermano" value="{{id}}">
                <p><b>{{title}}</b> <span>{{text}}</span></p>
                <button class="boton principal" type="submit">{{yes}}</button>
            </form>
            {{/turns}}
            {{#settled}}
            <div class="quien-lleva">
                {{#person}}
                <p class="etiqueta-lleva">{{label}}</p>
                <p class="persona-lleva">{{#photo}}<img class="retrato" src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="retrato ini" aria-hidden="true">{{initials}}</span>{{/photo}}<span><b>{{name}}</b>{{#role}}<span class="papel" dir="auto">{{role}}</span>{{/role}}</span></p>
                {{/person}}
                {{#place}}
                <p class="etiqueta-lleva">{{label}}</p>
                <p class="placa-sitio">{{name}}</p>
                {{/place}}
                {{#team}}<p class="etiqueta-lleva">{{team}}</p>{{/team}}
                {{#how}}<p class="por-donde" dir="auto">{{how}}</p>{{/how}}
            </div>
            {{/settled}}
            {{#wallask}}
            <form class="hoja-pregunta" method="post" action="{{action}}" data-preguntar>
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="{{do}}">
                {{> local_oksigeniaeguahe/public_ask }}
            </form>
            {{/wallask}}
            {{#siblingoffers}}
            {{#question}}
            <form class="ofrecimiento" id="avisar-{{id}}" method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="siblingnotify"><input type="hidden" name="hermano" value="{{id}}">
                <p>{{question}}</p>
                <button class="boton secundario" type="submit">{{yes}}</button>
            </form>
            {{/question}}
            {{#done}}<p class="ofrecimiento hecho" id="avisar-{{id}}"><span class="marca-hecho" aria-hidden="true">{{{i.check}}}</span><span>{{done}}</span></p>{{/done}}
            {{/siblingoffers}}
            {{#settled}}
            {{#volunteer}}
            <form class="ofrecimiento" id="ofrecimiento" method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="volunteer">
                <p>{{question}}</p>
                <button class="boton secundario" type="submit">{{yes}}</button>
            </form>
            {{/volunteer}}
            {{#volunteered}}<p class="ofrecimiento hecho" id="ofrecimiento"><span class="marca-hecho" aria-hidden="true">{{{i.check}}}</span><span>{{volunteered}}</span></p>{{/volunteered}}
            {{#thanks}}
            <p class="gracias-firmadas"><span class="texto-gracias">{{text}}</span>{{#hashost}}<span class="firma">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="ini" aria-hidden="true">{{initials}}</span>{{/photo}}<span>{{who}}</span></span>{{/hashost}}</p>
            {{/thanks}}
            {{/settled}}
        </div>
    </div>
</section>

{{#hasnext}}
<section class="banda" aria-label="{{bandlabel}}" data-parte="visit">
    <p class="etiqueta">{{bandlabel}}</p>
    {{#first}}
    <p class="cuando"><span>{{weekday}}</span><span>{{daymonth}}</span></p>
    <div class="detalles">
        <b>{{name}}</b>
        <span>{{hours}}{{#turn}} · {{pub_your_turn}}{{/turn}}</span>
        {{#place}}<span>{{place}}</span>{{/place}}
        {{#arrive}}<span class="llegar" dir="auto">{{arrive}}</span>{{/arrive}}
        <span>{{people}}</span>
        <div class="acciones">
            <a class="boton inverso" href="{{ics}}">{{{i.cal}}}{{pub_add_calendar}}</a>
            {{#mapurl}}<a class="enlace" href="{{mapurl}}" rel="noopener noreferrer" data-toca="directions">{{{i.map}}}{{pub_how_get}}</a>{{/mapurl}}
        </div>
    </div>
    {{/first}}
    {{#others}}
    <div class="otra">
        <div><b>{{name}}</b><span>{{long}} · {{hours}}</span></div>
        <a class="enlace" href="{{ics}}" aria-label="{{addlabel}}">{{{i.cal}}}</a>
    </div>
    {{/others}}
</section>
{{/hasnext}}
{{#howitwent}}
<section class="banda banda-encuesta" id="como-fue" aria-labelledby="como-fue-t" data-parte="visit">
    <div class="cabeza-encuesta">
        <h2 class="titulo-encuesta" id="como-fue-t">{{label}}</h2>
        <p class="siguiente">{{lead}}</p>
        {{#reads}}
        <p class="lo-lee">
            {{#hashosts}}<span class="caras-lee" aria-hidden="true">{{#hosts}}{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="ini">{{initials}}</span>{{/photo}}{{/hosts}}</span>{{/hashosts}}
            <span>{{reads}}</span>
        </p>
        {{/reads}}
        {{#saved}}<p class="guardado-todo" role="status">{{saved}}</p>{{/saved}}
        {{#pegs}}{{> local_oksigeniaeguahe/public_tags }}{{/pegs}}
    </div>
    <form class="hoja-encuesta" method="post" action="{{action}}" data-encuesta data-guardado-texto="{{savedtext}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="survey">
        {{#pegs}}{{> local_oksigeniaeguahe/public_tags }}{{/pegs}}
        {{#ask}}{{> local_oksigeniaeguahe/public_ask }}{{/ask}}
        <div class="preguntas-encuesta">
            {{> local_oksigeniaeguahe/public_questions }}
        </div>
        <div class="despedida" data-despedida{{^done}} hidden{{/done}}>
            <p class="gracias">{{farewell}}{{#names}} <span class="mano-titular" translate="no" dir="auto">{{names}}</span>{{/names}}</p>
            {{#changeline}}<p class="cambiar">{{changeline}}</p>{{/changeline}}
        </div>
        <div class="acciones guardar-encuesta"><button class="boton secundario" type="submit">{{savetext}}</button></div>
    </form>
</section>
{{/howitwent}}
{{^howitwent}}
{{^hasnext}}
{{^quiet}}
<section class="banda" aria-label="{{bandnext}}" data-parte="visit">
    <p class="etiqueta">{{bandnext}}</p>
    <p class="siguiente">{{nextline}}</p>
    <div class="detalles">
        <p>{{novisit}}</p>
        <div class="acciones">
            {{#email}}<a class="boton inverso" href="mailto:{{email}}" data-toca="write">{{{i.mail}}}{{writeus}}</a>{{/email}}
            {{#phone}}<a class="enlace" href="tel:{{tel}}" dir="ltr" data-toca="call">{{{i.phone}}}{{phone}}</a>{{/phone}}
        </div>
    </div>
</section>
{{/quiet}}
{{/hasnext}}
{{/howitwent}}

{{^quiet}}
{{#hashosts}}
<section class="seccion dos-col" data-parte="hosts">
    <div class="cabeza">
        <h2>{{pub_receives}}</h2>
        <p class="sub">{{pub_receives_sub}}</p>
    </div>
    <div class="personas">
        {{#hosts}}
        <article class="persona">
            {{#photo}}<img class="retrato" src="{{photo}}" alt="">{{/photo}}
            {{^photo}}<span class="retrato ini" aria-hidden="true">{{initials}}</span>{{/photo}}
            <b>{{name}}</b>
            {{#role}}<span class="papel" dir="auto">{{role}}</span>{{/role}}
            {{#says}}<p class="dice" dir="auto">{{says}}</p>{{/says}}
        </article>
        {{/hosts}}
    </div>
</section>
{{/hashosts}}
{{^hashosts}}
<section class="seccion" data-parte="hosts">
    <h2>{{pub_receives}}</h2>
    <p class="equipo">{{#receivespending}}{{receivespending}}{{/receivespending}}{{^receivespending}}{{pub_receives_team}}{{/receivespending}}</p>
</section>
{{/hashosts}}
{{/quiet}}

<section class="seccion" data-parte="told">
    <h2>{{pub_told}}</h2>
    <div class="lo-contado">
        {{#haschildren}}
        <div>
            <h3 id="quien-vendria">{{pub_who_comes}}</h3>
            <dl>{{#children}}<div class="nino-fila"><dt>{{name}}</dt><dd>{{course}}{{#ontag}}<br>{{ontag}}{{/ontag}}{{#tales}}<br><a class="enlace cuentos" href="{{tales}}" data-toca="tales">{{talesname}}</a>{{/tales}}{{#drawing}}<a class="dibujo-nino" href="{{drawing}}" data-ampliar="{{pub_drawing_close}}"{{#drawingstrokes}} data-trazos="{{.}}"{{/drawingstrokes}}><img src="{{drawing}}" alt="{{drawingalt}}" loading="lazy"></a>{{/drawing}}{{^drawing}}<br>{{/drawing}}<a class="enlace mandar-dibujo" href="{{drawingsend}}">{{drawingsendname}}</a></dd></div>{{/children}}</dl>
            {{#hassiblings}}<h3>{{siblingstitle}}</h3><dl>{{#siblings}}<div><dt>{{name}}</dt><dd>{{line}}</dd></div>{{/siblings}}</dl>{{/hassiblings}}
        </div>
        {{/haschildren}}
        <div>
            <h3>{{pub_contact}}</h3>
            <dl>
                {{#adults}}<div><dt>{{name}}</dt><dd>{{#reach}}{{.}}<br>{{/reach}}</dd></div>{{/adults}}
            </dl>
            {{#writeby}}<p class="muted escribimos">{{writeby}}</p>{{/writeby}}
        </div>
        {{#hobbies}}
        <div class="aficiones" id="aficiones">
            <h3>{{title}}</h3>
            <p class="muted">{{lead}}</p>
            <form class="hoja-aficiones" method="post" action="{{action}}" data-aficiones data-guardado-texto="{{savedtext}}" data-contar="{{tellus}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#adults}}
                <details class="aficiones-adulto" data-adulto="{{adultid}}">
                    <summary><span class="quien" dir="auto">{{name}}</span><span class="lo-dicho{{^told}} por-contar{{/told}}" data-lo-dicho dir="auto">{{said}}</span><span class="cambiar" data-cambiar{{^told}} hidden{{/told}}>{{changetext}}</span></summary>
                    <fieldset>
                        <legend class="oculto">{{name}}</legend>
                        <div class="fichas-papel">
                            {{#options}}<label class="ficha-papel"><input type="checkbox" name="h{{adultid}}[]" value="{{key}}"{{#checked}} checked{{/checked}}><span class="palabra">{{label}}</span></label>{{/options}}
                        </div>
                        <div class="campo otra-aficion">
                            <label for="o{{adultid}}">{{othertext}}</label>
                            <input id="o{{adultid}}" name="o{{adultid}}" type="text" value="{{other}}" maxlength="100" placeholder="{{otherexample}}" dir="auto">
                        </div>
                        <p class="guardado" data-guardado aria-live="polite"></p>
                    </fieldset>
                </details>
                {{/adults}}
                <div class="acciones guardar-aficiones">
                    <button class="boton secundario" type="submit">{{savetext}}</button>
                    {{#saved}}<p class="guardado" role="status">{{savedtext}}</p>{{/saved}}
                </div>
            </form>
        </div>
        {{/hobbies}}
        {{#hasjoin}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinlead}}</p>
            <div class="acciones">
                {{#joinlinks}}<a class="boton secundario" href="{{url}}" rel="noopener noreferrer" data-toca="phone_join">{{name}}</a>{{/joinlinks}}
            </div>
        </div>
        {{/hasjoin}}
        {{#joined}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinedline}}</p>
        </div>
        {{/joined}}
        {{#hasanswers}}
        <div>
            <h3>{{answerstitle}}</h3>
            <dl>{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>
        </div>
        {{/hasanswers}}
        <div data-parte="data">
            <h3>{{pub_data}}</h3>
            <p class="muted">{{pub_data_hint}}</p>
            <div class="acciones datos">
                <a class="boton secundario" href="{{downloadurl}}">{{{i.down}}}{{pub_data_download}}</a>
                <a class="boton rojo" href="{{eraseurl}}">{{pub_data_erase}}</a>
            </div>
        </div>
    </div>
</section>
