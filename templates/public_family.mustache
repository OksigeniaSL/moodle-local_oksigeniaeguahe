{{!
    @template local_oksigeniaeguahe/public_family

    The page of a family, theirs, from the link they got. The heading is the name the family uses at home, written by
    hand, as on the label of the backpack on its hook. Then their visit, in a band of the colour of the centre, with
    the calendar; the people who will receive them, with their face; and what they told us, with their data to take or
    to erase. After the visit, the label on the backpack is stuck down, as it was at the door, and one open question
    waits on the wall, «What were you left to ask?», as a note on lined paper; or, if the centre turned it on for that
    visit, the survey «How did it go?» in the band: who reads it, with their faces, then a sheet with the label of each
    child stuck in its corner (beside it, large, on a wide screen), the open question first and the words of each scale, each answer kept when it is touched; when
    the last one is answered, the thanks with the name used at home, written by hand. And what the centre does with what
    they told, under the thanks, as a note of the centre.

    Example context (json):
    {
        "i": {"check": "", "cal": "", "map": "", "mail": "", "phone": "", "down": ""},
        "greeting": "Los esperamos,", "names": "Leo",
        "pegs": {"count": 1, "live": false, "came": false, "pegs": [{"index": 0, "name": "Leo", "style": "", "arrive": true,
            "delay": "0.15", "tilt": "-3.5", "hidden": false}]},
        "lead": "El <b>sábado 21 de noviembre</b> los recibe Lucía.", "new": true, "saved": "Ya está, los esperamos",
        "savedline": "Guarden esta página.", "emailed": "También se la hemos enviado por correo.",
        "hasnext": true, "bandlabel": "Su visita", "wallask": false, "outcome": false, "hall": false,
        "howitwent": {"label": "¿Cómo fue?", "lead": "Son 4 preguntas, y todas si quieren.",
            "reads": "Lo lee el equipo que los recibió.", "ask": false, "fields": [], "autosave": true, "saved": "",
            "done": "", "farewell": "Gracias por contárnoslo,", "changeline": "Pueden cambiar cualquier respuesta hasta el 21 de noviembre.",
            "savetext": "Guardar", "savedtext": "Guardado", "action": "#", "sesskey": "abc"},
        "first": {"weekday": "Sábado", "daymonth": "21 de noviembre", "name": "Jornada de puertas abiertas",
            "hours": "De 10:00 a 13:00", "turn": false, "place": "Entrada principal", "people": "Para 3 personas",
            "ics": "#"},
        "pub_your_turn": "su turno", "pub_add_calendar": "Añadir a mi calendario", "mapurl": "#",
        "pub_how_get": "Cómo llegar", "others": [], "pub_band_next": "Lo siguiente", "bandnext": "Lo siguiente", "nextline": "",
        "novisit": "", "email": "admisiones@example.com", "phone": "+34 900 000 000", "tel": "+34900000000",
        "writeus": "Escribirnos", "pub_receives": "Quién los recibe", "pub_receives_sub": "Son las personas…",
        "hashosts": true, "hosts": [{"name": "Lucía Medina", "role": "Tutora", "says": "Les enseño la clase.",
            "photo": "", "initials": "LM"}], "pub_receives_team": "Los recibe el equipo.", "receivespending": "",
        "pub_told": "Lo que nos contaron", "pub_who_comes": "Quién vendría", "hasanswers": false, "answers": [], "hasjoin": false, "joinlinks": [], "joined": false,
        "jointitle": "", "joinlead": "", "joinedline": "",
        "answerstitle": "",
        "children": [{"name": "Leonardo", "course": "Infantil 3 años · curso 2027-28", "ontag": "En su etiqueta: Leo",
            "tales": "#", "talesname": "Cuentos para leer juntos en casa", "drawing": "", "drawingalt": "El dibujo de Leo",
            "drawingsend": "#", "drawingsendname": "Mandar su dibujo"}],
        "haschildren": true, "pub_contact": "Sus datos de contacto",
        "adults": [{"name": "Marta Ruiz", "reach": ["+34 611 22 23 33", "marta@example.com"]}],
        "writeby": "Les escribimos por WhatsApp y correo.", "pub_data": "Sus datos",
        "pub_data_hint": "Son suyos.", "pub_data_download": "Descargar nuestros datos",
        "pub_data_erase": "Borrar nuestros datos", "downloadurl": "#", "eraseurl": "#"
    }
}}
{{#hall}}
<div class="sala-familia" data-vestibulo data-escena="{{json}}" data-base="{{base}}" aria-hidden="true"><div class="sala"></div></div>
{{/hall}}
<section class="pared{{#hall}} con-sala{{/hall}}" aria-labelledby="titulo">
    <div class="saludo-arriba">
        <h1 class="titular" id="titulo">{{greeting}}{{#names}} <span class="mano-titular" translate="no" dir="auto">{{names}}</span>{{/names}}</h1>
    </div>
    <div class="riel" aria-hidden="true"></div>
    <div class="heroe-ancho">
        {{#pegs}}{{> local_oksigeniaeguahe/public_pegs }}{{/pegs}}
        <div class="bajo-riel">
            <p class="entradilla">{{{lead}}}</p>
            {{#new}}
            <div class="aviso en-heroe" role="status">
                <span class="icono">{{{i.check}}}</span>
                <p><b>{{saved}}.</b> {{savedline}} {{emailed}}</p>
            </div>
            {{/new}}
            {{#outcome}}<p class="lo-que-hacemos"><b>{{title}}</b> <span>{{text}}</span></p>{{/outcome}}
            {{#wallask}}
            <form class="hoja-pregunta" method="post" action="{{action}}" data-preguntar>
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="ask">
                {{> local_oksigeniaeguahe/public_ask }}
            </form>
            {{/wallask}}
        </div>
    </div>
</section>

{{#hasnext}}
<section class="banda" aria-label="{{bandlabel}}">
    <p class="etiqueta">{{bandlabel}}</p>
    {{#first}}
    <p class="cuando"><span>{{weekday}}</span><span>{{daymonth}}</span></p>
    <div class="detalles">
        <b>{{name}}</b>
        <span>{{hours}}{{#turn}} · {{pub_your_turn}}{{/turn}}</span>
        {{#place}}<span>{{place}}</span>{{/place}}
        {{#arrive}}<span class="llegar">{{arrive}}</span>{{/arrive}}
        <span>{{people}}</span>
        <div class="acciones">
            <a class="boton inverso" href="{{ics}}">{{{i.cal}}}{{pub_add_calendar}}</a>
            {{#mapurl}}<a class="enlace" href="{{mapurl}}" rel="noopener noreferrer">{{{i.map}}}{{pub_how_get}}</a>{{/mapurl}}
        </div>
    </div>
    {{/first}}
    {{#others}}
    <div class="otra">
        <div><b>{{name}}</b><span>{{long}} · {{hours}}</span></div>
        <a class="enlace" href="{{ics}}" aria-label="{{addlabel}}">{{{i.cal}}}</a>
    </div>
    {{/others}}
</section>
{{/hasnext}}
{{#howitwent}}
<section class="banda banda-encuesta" id="como-fue" aria-labelledby="como-fue-t">
    <div class="cabeza-encuesta">
        <h2 class="titulo-encuesta" id="como-fue-t">{{label}}</h2>
        <p class="siguiente">{{lead}}</p>
        {{#reads}}
        <p class="lo-lee">
            {{#hashosts}}<span class="caras-lee" aria-hidden="true">{{#hosts}}{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="ini">{{initials}}</span>{{/photo}}{{/hosts}}</span>{{/hashosts}}
            <span>{{reads}}</span>
        </p>
        {{/reads}}
        {{#saved}}<p class="guardado-todo" role="status">{{saved}}</p>{{/saved}}
        {{#pegs}}{{> local_oksigeniaeguahe/public_tags }}{{/pegs}}
    </div>
    <form class="hoja-encuesta" method="post" action="{{action}}" data-encuesta data-guardado-texto="{{savedtext}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="survey">
        {{#pegs}}{{> local_oksigeniaeguahe/public_tags }}{{/pegs}}
        {{#ask}}{{> local_oksigeniaeguahe/public_ask }}{{/ask}}
        <div class="preguntas-encuesta">
            {{> local_oksigeniaeguahe/public_questions }}
        </div>
        <div class="despedida" data-despedida{{^done}} hidden{{/done}}>
            <p class="gracias">{{farewell}}{{#names}} <span class="mano-titular" translate="no" dir="auto">{{names}}</span>{{/names}}</p>
            {{#changeline}}<p class="cambiar">{{changeline}}</p>{{/changeline}}
        </div>
        <div class="acciones guardar-encuesta"><button class="boton secundario" type="submit">{{savetext}}</button></div>
    </form>
</section>
{{/howitwent}}
{{^howitwent}}
{{^hasnext}}
<section class="banda" aria-label="{{bandnext}}">
    <p class="etiqueta">{{bandnext}}</p>
    <p class="siguiente">{{nextline}}</p>
    <div class="detalles">
        <p>{{novisit}}</p>
        <div class="acciones">
            {{#email}}<a class="boton inverso" href="mailto:{{email}}">{{{i.mail}}}{{writeus}}</a>{{/email}}
            {{#phone}}<a class="enlace" href="tel:{{tel}}">{{{i.phone}}}{{phone}}</a>{{/phone}}
        </div>
    </div>
</section>
{{/hasnext}}
{{/howitwent}}

{{#hashosts}}
<section class="seccion dos-col">
    <div class="cabeza">
        <h2>{{pub_receives}}</h2>
        <p class="sub">{{pub_receives_sub}}</p>
    </div>
    <div class="personas">
        {{#hosts}}
        <article class="persona">
            {{#photo}}<img class="retrato" src="{{photo}}" alt="">{{/photo}}
            {{^photo}}<span class="retrato ini" aria-hidden="true">{{initials}}</span>{{/photo}}
            <b>{{name}}</b>
            {{#role}}<span class="papel">{{role}}</span>{{/role}}
            {{#says}}<p class="dice">{{says}}</p>{{/says}}
        </article>
        {{/hosts}}
    </div>
</section>
{{/hashosts}}
{{^hashosts}}
<section class="seccion">
    <h2>{{pub_receives}}</h2>
    <p class="equipo">{{#receivespending}}{{receivespending}}{{/receivespending}}{{^receivespending}}{{pub_receives_team}}{{/receivespending}}</p>
</section>
{{/hashosts}}

<section class="seccion">
    <h2>{{pub_told}}</h2>
    <div class="lo-contado">
        {{#haschildren}}
        <div>
            <h3 id="quien-vendria">{{pub_who_comes}}</h3>
            <dl>{{#children}}<div class="nino-fila"><dt>{{name}}</dt><dd>{{course}}{{#ontag}}<br>{{ontag}}{{/ontag}}{{#tales}}<br><a class="enlace cuentos" href="{{tales}}">{{talesname}}</a>{{/tales}}{{#drawing}}<a class="dibujo-nino" href="{{drawing}}" data-ampliar="{{pub_drawing_close}}"><img src="{{drawing}}" alt="{{drawingalt}}" loading="lazy"></a>{{/drawing}}{{^drawing}}<br>{{/drawing}}<a class="enlace mandar-dibujo" href="{{drawingsend}}">{{drawingsendname}}</a></dd></div>{{/children}}</dl>
        </div>
        {{/haschildren}}
        <div>
            <h3>{{pub_contact}}</h3>
            <dl>
                {{#adults}}<div><dt>{{name}}</dt><dd>{{#reach}}{{.}}<br>{{/reach}}</dd></div>{{/adults}}
            </dl>
            {{#writeby}}<p class="muted escribimos">{{writeby}}</p>{{/writeby}}
        </div>
        {{#hasjoin}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinlead}}</p>
            <div class="acciones">
                {{#joinlinks}}<a class="boton secundario" href="{{url}}" rel="noopener noreferrer">{{name}}</a>{{/joinlinks}}
            </div>
        </div>
        {{/hasjoin}}
        {{#joined}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinedline}}</p>
        </div>
        {{/joined}}
        {{#hasanswers}}
        <div>
            <h3>{{answerstitle}}</h3>
            <dl>{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>
        </div>
        {{/hasanswers}}
        <div>
            <h3>{{pub_data}}</h3>
            <p class="muted">{{pub_data_hint}}</p>
            <div class="acciones datos">
                <a class="boton secundario" href="{{downloadurl}}">{{{i.down}}}{{pub_data_download}}</a>
                <a class="boton rojo" href="{{eraseurl}}">{{pub_data_erase}}</a>
            </div>
        </div>
    </div>
</section>
