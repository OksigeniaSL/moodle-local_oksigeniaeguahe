{{#measure}}<span class="mide" data-mide="{{url}}" data-sesskey="{{sesskey}}" data-de="{{de}}" hidden></span>{{/measure}}
<div class="familia-arriba{{#hall}} con-sala{{/hall}}">
{{#hall}}
<div class="sala-familia" data-vestibulo data-escena="{{json}}" data-base="{{base}}" aria-hidden="true"><div class="sala"></div></div>
{{/hall}}
<section class="pared{{#hall}} con-sala{{/hall}}" aria-labelledby="titulo" data-parte="wall">
    <div class="saludo-arriba">
        <h1 class="titular" id="titulo">{{greeting}}{{#names}} <span class="mano-titular" translate="no" dir="auto">{{names}}</span>{{/names}}</h1>
    </div>
    <div class="riel" aria-hidden="true"></div>
    <div class="heroe-ancho">
        {{#pegs}}{{> local_oksigeniaeguahe/public_pegs }}{{/pegs}}
        <div class="bajo-riel">
            <p class="entradilla">{{{lead}}}</p>
            {{#guidehello}}<div class="guia guia-saluda"><img src="{{img.src}}" srcset="{{img.srcset}}" alt="" width="96" height="96"><p class="bocadillo" dir="auto">{{bubble}}</p></div>{{/guidehello}}
            {{#new}}
            <div class="aviso en-heroe" role="status">
                <span class="icono">{{{i.check}}}</span>
                <p><b>{{saved}}.</b> {{savedline}} {{emailed}}</p>
            </div>
            {{/new}}
            {{#outcome}}<p class="lo-que-hacemos"><b>{{title}}</b> <span dir="auto">{{text}}</span></p>{{/outcome}}
            {{#settled}}
            <div class="quien-lleva">
                {{#person}}
                <p class="etiqueta-lleva">{{label}}</p>
                <p class="persona-lleva">{{#photo}}<img class="retrato" src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="retrato ini" aria-hidden="true">{{initials}}</span>{{/photo}}<span><b>{{name}}</b>{{#role}}<span class="papel" dir="auto">{{role}}</span>{{/role}}</span></p>
                {{/person}}
                {{#place}}
                <p class="etiqueta-lleva">{{label}}</p>
                <p class="placa-sitio">{{name}}</p>
                {{/place}}
                {{#team}}<p class="etiqueta-lleva">{{team}}</p>{{/team}}
                {{#how}}<p class="por-donde" dir="auto">{{how}}</p>{{/how}}
            </div>
            {{#thanks}}
            <p class="gracias-firmadas"><span class="texto-gracias">{{text}}</span>{{#hashost}}<span class="firma">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}<span class="ini" aria-hidden="true">{{initials}}</span>{{/photo}}<span>{{who}}</span></span>{{/hashost}}</p>
            {{/thanks}}
            {{/settled}}
            {{#nowcard}}<div class="ahora">{{> local_oksigeniaeguahe/public_thing }}</div>{{/nowcard}}
        </div>
    </div>
</section>
</div>
{{#nowband}}{{> local_oksigeniaeguahe/public_thing }}{{/nowband}}

{{#hasmore}}
<section class="seccion tambien" aria-labelledby="tambien-t">
    <h2 id="tambien-t">{{moretitle}}</h2>
    <div class="tambien-cosas">
        {{#more}}
        {{#fold}}
        <details class="otra-cosa">
            <summary><span class="otra-cosa-que">{{#kicker}}<span class="otra-cosa-antes" dir="auto">{{kicker}}</span>{{/kicker}}<b dir="auto">{{title}}</b>{{#state}}<span class="otra-cosa-estado" dir="auto">{{state}}</span>{{/state}}</span>{{{i.chev}}}</summary>
            <div class="otra-cosa-dentro">{{> local_oksigeniaeguahe/public_thing }}</div>
        </details>
        {{/fold}}
        {{^fold}}<div class="otra-cosa suelta">{{> local_oksigeniaeguahe/public_thing }}</div>{{/fold}}
        {{/more}}
    </div>
</section>
{{/hasmore}}

{{^quiet}}
{{#hashosts}}
<section class="seccion dos-col" data-parte="hosts">
    <div class="cabeza">
        <h2>{{receivestitle}}</h2>
        <p class="sub">{{receivessub}}</p>
        {{#guidehosts}}<div class="guia guia-presenta"><img src="{{img.src}}" srcset="{{img.srcset}}" alt="" width="96" height="96"><p class="bocadillo" dir="auto">{{bubble}}</p></div>{{/guidehosts}}
    </div>
    <div class="personas">
        {{#hosts}}
        <article class="persona">
            {{#photo}}<img class="retrato" src="{{photo}}" alt="">{{/photo}}
            {{^photo}}<span class="retrato ini" aria-hidden="true">{{initials}}</span>{{/photo}}
            <b>{{name}}</b>
            {{#role}}<span class="papel" dir="auto">{{role}}</span>{{/role}}
            {{#says}}<p class="dice" dir="auto">{{says}}</p>{{/says}}
        </article>
        {{/hosts}}
    </div>
</section>
{{/hashosts}}
{{/quiet}}

<section class="seccion" data-parte="told">
    <h2>{{pub_told}}</h2>
    <div class="lo-contado">
        {{#haschildren}}
        <div>
            <h3 id="quien-vendria">{{whocomes}}</h3>
            <dl>{{#children}}<div class="nino-fila"><dt>{{name}}</dt><dd>{{course}}{{#ontag}}<br>{{ontag}}{{/ontag}}{{#birthline}}<br>{{birthline}}{{/birthline}}{{#home}}{{#saved}}<br><span class="casa-guardado" role="status">{{saved}}</span>{{/saved}}<details class="en-casa"><summary class="enlace">{{open}}</summary><form class="hoja-casa" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="nino" value="{{id}}"><div class="campo"><label for="casa-{{id}}">{{label}}</label><input id="casa-{{id}}" name="casa" value="{{value}}" maxlength="100" autocomplete="off" dir="auto" aria-describedby="casa-{{id}}-ayuda"><p class="ayuda-campo" id="casa-{{id}}-ayuda">{{hint}}</p></div>{{#latin}}<div class="campo"><label for="latina-{{id}}">{{label}}</label><input id="latina-{{id}}" name="latina" value="{{value}}" maxlength="100" dir="ltr" lang="en" autocomplete="off" aria-describedby="latina-{{id}}-ayuda"><p class="ayuda-campo" id="latina-{{id}}-ayuda">{{hint}}</p></div>{{/latin}}<div class="campo"><label id="cumple-{{id}}-l" for="{{birthdate.first}}">{{birthlabel}}</label>{{#birthdate}}{{> local_oksigeniaeguahe/public_date }}{{/birthdate}}<p class="ayuda-campo" id="cumple-{{id}}-ayuda">{{birthhint}}</p></div><button class="boton secundario" type="submit">{{save}}</button></form></details>{{/home}}{{#tales}}<br><a class="enlace cuentos" href="{{tales}}" data-toca="tales">{{talesname}}</a>{{/tales}}{{#drawing}}<a class="dibujo-nino" href="{{drawing}}" data-ampliar="{{pub_drawing_close}}"{{#drawingstrokes}} data-trazos="{{.}}"{{/drawingstrokes}}><img src="{{drawing}}" alt="{{drawingalt}}" loading="lazy"></a>{{/drawing}}{{#drawingsend}}{{^drawing}}<br>{{/drawing}}<a class="enlace mandar-dibujo" href="{{drawingsend}}">{{drawingsendname}}</a>{{/drawingsend}}{{#drawingshare}}<span class="pasar"><button class="enlace mandar-dibujo" type="button" data-compartir="{{url}}" data-titulo="{{title}}" data-texto="{{text}}" data-copiado="{{copied}}"{{#video}} data-video="{{.}}"{{/video}} data-toca="share_drawing">{{{i.send}}}<span>{{label}}</span></button><span class="compartir-aviso" aria-live="polite"></span></span>{{/drawingshare}}</dd></div>{{/children}}</dl>
            {{#hassiblings}}<h3>{{siblingstitle}}</h3><dl>{{#siblings}}<div><dt>{{name}}</dt><dd>{{line}}</dd></div>{{/siblings}}</dl>{{/hassiblings}}
        </div>
        {{/haschildren}}
        <div>
            <h3>{{pub_contact}}</h3>
            <dl>
                {{#adults}}<div><dt>{{name}}</dt><dd>{{#reach}}{{.}}<br>{{/reach}}</dd></div>{{/adults}}
            </dl>
            {{#writeby}}<p class="muted escribimos">{{writeby}}</p>{{/writeby}}
        </div>
        {{#hobbies}}
        <div class="aficiones" id="aficiones">
            <h3>{{title}}</h3>
            <p class="muted">{{lead}}</p>
            <form class="hoja-aficiones" method="post" action="{{action}}" data-aficiones data-guardado-texto="{{savedtext}}" data-contar="{{tellus}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#adults}}
                <details class="aficiones-adulto" data-adulto="{{adultid}}">
                    <summary><span class="quien" dir="auto">{{name}}</span><span class="lo-dicho{{^told}} por-contar{{/told}}" data-lo-dicho dir="auto">{{said}}</span><span class="cambiar" data-cambiar{{^told}} hidden{{/told}}>{{changetext}}</span></summary>
                    <fieldset>
                        <legend class="oculto">{{name}}</legend>
                        <div class="fichas-papel">
                            {{#options}}<label class="ficha-papel"><input type="checkbox" name="h{{adultid}}[]" value="{{key}}"{{#checked}} checked{{/checked}}><span class="palabra">{{label}}</span></label>{{/options}}
                        </div>
                        <div class="campo otra-aficion">
                            <label for="o{{adultid}}">{{othertext}}</label>
                            <input id="o{{adultid}}" name="o{{adultid}}" type="text" value="{{other}}" maxlength="100" placeholder="{{otherexample}}" dir="auto">
                        </div>
                        <p class="guardado" data-guardado aria-live="polite"></p>
                    </fieldset>
                </details>
                {{/adults}}
                <div class="acciones guardar-aficiones">
                    <button class="boton secundario" type="submit">{{savetext}}</button>
                    {{#saved}}<p class="guardado" role="status">{{savedtext}}</p>{{/saved}}
                </div>
            </form>
        </div>
        {{/hobbies}}
        {{#hasjoin}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinlead}}</p>
            <div class="acciones">
                {{#joinlinks}}<a class="boton secundario" href="{{url}}" rel="noopener noreferrer" data-toca="phone_join">{{name}}</a>{{/joinlinks}}
            </div>
        </div>
        {{/hasjoin}}
        {{#joined}}
        <div>
            <h3>{{jointitle}}</h3>
            <p class="muted">{{joinedline}}</p>
        </div>
        {{/joined}}
        {{#hasanswers}}
        <div>
            <h3>{{answerstitle}}</h3>
            <dl>{{#answers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/answers}}</dl>
        </div>
        {{/hasanswers}}
        <details class="sus-datos" data-parte="data">
            <summary><h3>{{pub_data}}</h3><span class="muted">{{pub_data_hint}}</span>{{{i.chev}}}</summary>
            <div class="acciones datos">
                <a class="boton secundario" href="{{downloadurl}}">{{{i.down}}}{{pub_data_download}}</a>
                <a class="enlace borrar-datos" href="{{eraseurl}}">{{pub_data_erase}}</a>
            </div>
        </details>
    </div>
</section>
