{{!
    @template local_oksigeniaeguahe/panel_inbox

    The inbox, three things and an epilogue. The sentence (the h1), the tab «Waiting | All» with the search and the
    filters, and the list: by the rule of time, each day written once, big, and its families hanging from it with their
    hour; on top, only on days with visits, «Today» with the families that come, and the promises that are due. The
    epilogue, at the end and folded on a phone: the places of each course on their rail, the way of the campaign and the
    next open days. With twenty families or more the list turns into a ledger, one line each. On a wide screen a family
    opens in a sheet beside the list (the script fetches its page); without the script, its link opens the whole page.
    No colour says anything of a family.

    New in this round: days (replaces rows), density, densityurls, filters, checkurl, checkevery, path, nextevents,
    hasnextevents, keyhint. Kept: head, fresh, showtools, all, waiting, total, waitingurl, allurl, hasrows, emptybag,
    emptytitle, emptytext, newevent, newform, year, places, hasplaces. No longer drawn: rows (now inside days),
    visits (now «Today» and «Open days and visits»), chev.

    Example context (json):
    {
        "i": {"atras": "", "buscar": "", "der": "", "actos": "", "formulario": "", "mas1": "", "fichero": "", "filas": ""},
        "head": {"title": "5 familias esperan respuesta", "sub": "La que más lleva espera desde el jueves a las 18:40.",
            "action": {"url": "#", "name": "Apuntar a una familia", "icon": ""} },
        "hall": false, "cine": false, "fresh": false, "showtools": true, "waitingurl": "#", "allurl": "#", "all": false, "waiting": 5, "total": 9,
        "density": "fichas", "fichas": true, "lista": false, "densityurls": {"fichas": "#", "lista": "#"},
        "checkurl": "#", "checkevery": 60,
        "filters": {"courses": [{"name": "Todos los cursos", "key": "", "url": "#", "current": true}],
            "stages": [{"name": "Todas las etapas", "key": "", "url": "#", "current": true}]},
        "hasrows": true,
        "firstday": false, "topics": {"list": [{"theme": "El comedor", "texts": "3 mensajes"}], "url": "/local/oksigeniaeguahe/report.php?c=1"}, "siblingsdue": false, "startingdue": false, "birthdaysdue": false, "days": [{"key": "espera2", "kind": "espera", "day": "Jueves 5", "sub": "hace 6 días", "answered": false, "count": 1,
            "rows": [{"id": "1", "url": "#", "waiting": true, "answered": false, "hour": "18:40",
                "stamp": {"top": "Llegó", "day": "jue 5", "hour": "18:40"}, "adults": "Marta Ruiz y Daniel Ortega",
                "children": [{"tag": "Leo", "course": "Infantil 3 años", "stage": ""}],
                "via": "Por WhatsApp, el viernes a las 9:02", "viaicon": "",
                "owner": {"first": "Lucía", "picture": "", "initials": "LM", "mine": false},
                "typing": {"first": "Lucía", "picture": "", "initials": "LM"}, "promise": null, "visit": null,
                "courses": "i3", "stages": "inquiry", "search": "marta leo"}]}],
        "emptybag": {"name": "", "style": ""}, "emptytitle": "Al día", "emptytext": "Cuando alguien escriba, aparecerá aquí.",
        "newevent": "#", "newform": "#",
        "year": "2027-28", "hasplaces": true,
        "places": [{"name": "Infantil 3 años", "free": 19, "total": 25, "rail": "", "interested": 19, "visited": 11, "enrolled": 6, "ropero": false}],
        "path": {"total": 96, "sentence": "96 familias en esta campaña.", "def": "Cada familia cuenta donde va su hijo más adelantado.",
            "steps": [{"key": "inquiry", "name": "Consulta", "n": 38, "line": "38 familias han preguntado."}]},
        "hasnextevents": true, "nextevents": [{"url": "#", "weekday": "sáb", "day": "21", "month": "nov",
            "name": "Jornada de puertas abiertas", "load": "87 de 120 personas", "percent": 72, "hasbar": true}],
        "keyhint": "Teclas: / buscar · j y k para pasar de familia"
    }
}}
<div class="pagina pagina-bandeja" data-bandeja{{#checkurl}} data-comprobar="{{checkurl}}" data-cada="{{checkevery}}"{{/checkurl}}>
    {{#hall}}
    <section class="vestibulo-sala" aria-labelledby="titular">
        <div class="vestibulo-escena" data-vestibulo data-escena="{{json}}" data-base="{{base}}"><div class="sala" aria-hidden="true"></div></div>
        <div class="vestibulo-tarjeta">
            {{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}
            {{#hascard}}<ul class="cola-sala">{{#card}}<li><a href="{{url}}"><b>{{adults}}</b><span>{{since}}</span></a><span class="ninos" translate="no" dir="auto">{{tags}}</span></li>{{/card}}</ul>{{/hascard}}
        </div>
    </section>
    {{/hall}}
    {{#cine}}{{> local_oksigeniaeguahe/panel_inbox_rio }}{{/cine}}
    {{^hall}}{{^cine}}{{#head}}{{> local_oksigeniaeguahe/panel_head }}{{/head}}{{/cine}}{{/hall}}
    <p class="novedad" data-novedad role="status" hidden></p>
    <div class="mostrador" data-mostrador>
        <section class="bandeja" aria-labelledby="titular">
            {{#showtools}}
            <div class="herramientas">
                <div class="segmentos" role="group" aria-label="{{#str}}panel_which, local_oksigeniaeguahe{{/str}}">
                    <a href="{{waitingurl}}"{{^all}} aria-current="true"{{/all}}>{{#str}}inbox_filter_waiting, local_oksigeniaeguahe{{/str}} <span class="num" data-cuenta-espera>{{waiting}}</span></a>
                    <a href="{{allurl}}"{{#all}} aria-current="true"{{/all}}>{{#str}}inbox_filter_all, local_oksigeniaeguahe{{/str}} <span class="num">{{total}}</span></a>
                </div>
                <label class="buscar"><span class="oculto">{{#str}}panel_search_label, local_oksigeniaeguahe{{/str}}</span>{{{i.buscar}}}<input type="search" data-filtrar=".fila" data-tecla="/" data-tecla-que="{{#str}}panel_search_label, local_oksigeniaeguahe{{/str}}" placeholder="{{#str}}panel_search, local_oksigeniaeguahe{{/str}}" spellcheck="false" autocomplete="off"></label>
                <div class="vista" role="group" aria-label="{{#str}}panel_view, local_oksigeniaeguahe{{/str}}">
                    <a href="{{densityurls.fichas}}"{{#fichas}} aria-current="true"{{/fichas}} title="{{#str}}panel_view_cards, local_oksigeniaeguahe{{/str}}">{{{i.fichero}}}<span class="oculto">{{#str}}panel_view_cards, local_oksigeniaeguahe{{/str}}</span></a>
                    <a href="{{densityurls.lista}}"{{#lista}} aria-current="true"{{/lista}} title="{{#str}}panel_view_list, local_oksigeniaeguahe{{/str}}">{{{i.filas}}}<span class="oculto">{{#str}}panel_view_list, local_oksigeniaeguahe{{/str}}</span></a>
                </div>
            </div>
            <details class="filtros" open data-plegar-movil>
                <summary class="filtros-titulo">{{#str}}panel_filters, local_oksigeniaeguahe{{/str}}</summary>
                <div class="pastillas" role="group" aria-label="{{#str}}panel_filter_course, local_oksigeniaeguahe{{/str}}">{{#filters.courses}}<a class="pastilla" href="{{url}}" data-filtro="curso" data-clave="{{key}}"{{#current}} aria-current="true"{{/current}}>{{name}}</a>{{/filters.courses}}</div>
                <div class="pastillas" role="group" aria-label="{{#str}}panel_filter_stage, local_oksigeniaeguahe{{/str}}">{{#filters.stages}}<a class="pastilla" href="{{url}}" data-filtro="etapa" data-clave="{{key}}"{{#current}} aria-current="true"{{/current}}>{{name}}</a>{{/filters.stages}}</div>
            </details>
            {{/showtools}}
            {{#hasrows}}
            <div class="lista" id="lista" data-lista data-densidad="{{density}}">
                {{#days}}
                <section class="dia-g dia-{{kind}}" aria-labelledby="dia-{{key}}">
                    <h2 class="dia" id="dia-{{key}}"><b>{{day}}</b> <span>{{sub}}</span></h2>
                    <ol class="filas">
                        {{#rows}}<li class="fila{{^waiting}} contestada{{/waiting}}{{#promise}} con-promesa{{/promise}}{{#visit}} con-visita{{/visit}}" data-fila="{{id}}" data-buscar="{{search}}" data-cursos="{{courses}}" data-etapas="{{stages}}">{{> local_oksigeniaeguahe/panel_inbox_row }}</li>{{/rows}}
                    </ol>
                </section>
                {{/days}}
            </div>
            <p class="secundario sin-resultados" hidden>{{#str}}panel_search_none, local_oksigeniaeguahe{{/str}}</p>
            {{/hasrows}}
            {{^hasrows}}
            <div class="vacio">
                <div class="vacio-percha" aria-hidden="true"><div class="riel-corto"></div>{{#emptybag}}{{> local_oksigeniaeguahe/panel_hanging }}{{/emptybag}}</div>
                <h2>{{emptytitle}}</h2>
                <p>{{emptytext}}</p>
                {{#fresh}}
                <div class="cabeza-acciones">
                    <a class="boton principal" href="{{newevent}}">{{{i.actos}}}{{#str}}panel_new_event, local_oksigeniaeguahe{{/str}}</a>
                    <a class="boton secundario" href="{{newform}}">{{{i.formulario}}}{{#str}}panel_new_form, local_oksigeniaeguahe{{/str}}</a>
                </div>
                {{/fresh}}
                {{^fresh}}<a class="enlace" href="{{allurl}}">{{#str}}panel_see_all, local_oksigeniaeguahe{{/str}} {{{i.der}}}</a>{{/fresh}}
            </div>
            {{/hasrows}}
            {{#keyhint}}<p class="pista-teclas" data-pista-teclas>{{keyhint}}</p>{{/keyhint}}
        </section>
        <aside class="epilogo" aria-labelledby="epilogo-t" data-epilogo>
            <details class="plegable" open data-plegar-movil>
                <summary><h2 id="epilogo-t">{{#str}}panel_epilogue, local_oksigeniaeguahe, {{year}}{{/str}}</h2>{{{i.chev}}}</summary>
                {{#hasplaces}}
                <section class="bloque bloque-plazas">
                    <h3>{{#str}}panel_places_for, local_oksigeniaeguahe, {{year}}{{/str}}</h3>
                    <div class="plazas">
                        {{#places}}
                        <div class="curso-plazas">
                            <div class="cab"><b>{{name}}</b><span class="libres">{{#str}}panel_free_of, local_oksigeniaeguahe, {"free": {{free}}, "total": {{total}} }{{/str}}</span></div>
                            <div class="riel-caja"{{#ropero}} data-ropero="{{.}}"{{/ropero}}>{{{rail}}}</div>
                            <span class="tres"><span><b>{{interested}}</b> {{#str}}panel_interested, local_oksigeniaeguahe{{/str}}</span><span><b>{{visited}}</b> {{#str}}panel_visited, local_oksigeniaeguahe{{/str}}</span><span><b>{{enrolled}}</b> {{#str}}panel_enrolled, local_oksigeniaeguahe{{/str}}</span></span>
                        </div>
                        {{/places}}
                    </div>
                    <p class="def">{{#str}}panel_places_def, local_oksigeniaeguahe{{/str}}</p>
                </section>
                {{/hasplaces}}
                {{#path}}
                <section class="bloque bloque-camino" data-camino>
                    <h3>{{#str}}panel_path_title, local_oksigeniaeguahe{{/str}}</h3>
                    <div class="camino-figura" data-figura="camino" aria-hidden="true"></div>
                    <p class="linea-dato" data-linea-dato data-reposo="{{sentence}}">{{sentence}}</p>
                    <ol class="paradas">
                        {{#steps}}<li data-parada="{{key}}" data-linea="{{line}}"><b>{{n}}</b><span>{{name}}</span></li>{{/steps}}
                    </ol>
                    <p class="def">{{def}}</p>
                </section>
                {{/path}}
                {{#siblingsdue}}
                <section class="bloque bloque-hermanos">
                    <h3>{{#str}}panel_siblings, local_oksigeniaeguahe{{/str}}</h3>
                    <p>{{text}}</p>
                    <p>{{^on}}<a class="enlace" href="{{url}}">{{#str}}panel_siblings_see, local_oksigeniaeguahe{{/str}}</a>{{/on}}{{#on}}<a class="enlace" href="{{allurl}}">{{#str}}panel_siblings_all, local_oksigeniaeguahe{{/str}}</a>{{/on}}</p>
                </section>
                {{/siblingsdue}}
                {{#startingdue}}
                <section class="bloque bloque-hermanos">
                    <h3>{{#str}}panel_story_inbox, local_oksigeniaeguahe{{/str}}</h3>
                    <p>{{text}}</p>
                    <p>{{^on}}<a class="enlace" href="{{url}}">{{#str}}panel_story_inbox_see, local_oksigeniaeguahe{{/str}}</a>{{/on}}{{#on}}<a class="enlace" href="{{allurl}}">{{#str}}panel_siblings_all, local_oksigeniaeguahe{{/str}}</a>{{/on}}</p>
                </section>
                {{/startingdue}}
                {{#birthdaysdue}}
                <section class="bloque bloque-hermanos">
                    <h3>{{#str}}panel_birthday_inbox, local_oksigeniaeguahe{{/str}}</h3>
                    <p>{{text}}</p>
                    <p>{{^on}}<a class="enlace" href="{{url}}">{{#str}}panel_story_inbox_see, local_oksigeniaeguahe{{/str}}</a>{{/on}}{{#on}}<a class="enlace" href="{{allurl}}">{{#str}}panel_siblings_all, local_oksigeniaeguahe{{/str}}</a>{{/on}}</p>
                </section>
                {{/birthdaysdue}}
                {{#topics}}
                <section class="bloque bloque-preguntan">
                    <h3>{{#str}}panel_topics, local_oksigeniaeguahe{{/str}}</h3>
                    <ul class="preguntan">{{#list}}<li><b>{{theme}}</b> <span class="secundario">{{texts}}</span></li>{{/list}}</ul>
                    <p><a class="enlace" href="{{url}}">{{#str}}panel_topics_report, local_oksigeniaeguahe{{/str}}</a></p>
                </section>
                {{/topics}}
                {{#firstday}}
                <section class="bloque bloque-primer-dia">
                    <h3>{{#str}}panel_firstday, local_oksigeniaeguahe{{/str}}</h3>
                    {{#hasasks}}<ul class="pd-pide-lista">{{#asks}}<li><a class="acto-corto pd-pide-fila" href="{{url}}" aria-label="{{text}}">
                        <span class="hoja-cal{{^leaf}} pd-hoja-vacia{{/leaf}}" aria-hidden="true">{{#leaf}}<small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span>{{/leaf}}</span>
                        <span class="que"><b>{{title}}</b><span class="secundario">{{sub}}</span></span>
                    </a></li>{{/asks}}</ul>{{/hasasks}}
                    <p><a class="enlace" href="{{url}}">{{text}}</a></p>
                </section>
                {{/firstday}}
                {{#hasnextevents}}
                <section class="bloque bloque-jornadas">
                    <h3>{{#str}}panel_next_events, local_oksigeniaeguahe{{/str}}</h3>
                    {{#nextevents}}
                    <a class="acto-corto" href="{{url}}">
                        <span class="hoja-cal"><small>{{weekday}}</small><b>{{day}}</b><span>{{month}}</span></span>
                        <span class="que"><b>{{name}}</b><span class="secundario">{{load}}</span>{{#hasbar}}<span class="barra-aforo" aria-hidden="true"><i style="width:{{percent}}%"></i></span>{{/hasbar}}</span>
                    </a>
                    {{/nextevents}}
                </section>
                {{/hasnextevents}}
            </details>
        </aside>
        <section class="hoja-lateral" id="hoja" aria-label="{{#str}}panel_sheet, local_oksigeniaeguahe{{/str}}" data-hoja-caja hidden></section>
    </div>
</div>
