{{!
    @template local_oksigeniaeguahe/inbox

    The inbox of a centre: how many households wait for an answer and since when, the longest wait first; the button
    to note a family by hand; and how each offer is going against its places.

    Example context (json):
    {
        "tabs": [], "waiting": 2, "waitingtext": "2 familias esperan respuesta", "all": false, "waitingurl": "#",
        "allurl": "#", "newurl": "#", "canact": true, "settingsurl": "#", "hasrows": true,
        "rows": [{"url": "#", "names": "Lucas Pérez y Ana Gil", "channel": "Jornada", "incentre": false, "waiting": true, "waited": "3 horas",
            "last": "21/11/26, 10:12", "children": [{"name": "Daniel", "offer": "Infantil 3 años", "stage": "Consulta"}]}],
        "hasoffers": true,
        "offers": [{"name": "Infantil 3 años", "year": "2027-28", "open": 14, "visited": 6, "enrolled": 3, "places": 25,
            "hasplaces": true, "left": 22}]
    }
}}
<div class="eguahe">
    {{> local_oksigeniaeguahe/tabs }}

    <div class="eguahe-head">
        <p class="eguahe-waiting{{#waiting}} is-waiting{{/waiting}}" role="status">{{waitingtext}}</p>
        {{#canact}}<a class="btn btn-primary" href="{{newurl}}">{{#str}}household_new, local_oksigeniaeguahe{{/str}}</a>{{/canact}}
    </div>

    <nav class="eguahe-filter" aria-label="{{#str}}inbox, local_oksigeniaeguahe{{/str}}">
        <a href="{{waitingurl}}"{{^all}} aria-current="page"{{/all}}>{{#str}}inbox_filter_waiting, local_oksigeniaeguahe{{/str}}</a>
        <a href="{{allurl}}"{{#all}} aria-current="page"{{/all}}>{{#str}}inbox_filter_all, local_oksigeniaeguahe{{/str}}</a>
    </nav>

    {{#hasrows}}
    <ul class="eguahe-inbox">
        {{#rows}}
        <li class="eguahe-row{{#waiting}} is-waiting{{/waiting}}">
            <a href="{{url}}">
                <span class="eguahe-row-main">
                    <strong>{{names}}</strong>{{#incentre}} <span class="badge bg-secondary">{{#str}}incentre_tag, local_oksigeniaeguahe{{/str}}</span>{{/incentre}}
                    <span class="eguahe-children">{{#children}}<span>{{name}} · {{offer}} · {{stage}}</span>{{/children}}</span>
                </span>
                <span class="eguahe-row-side">
                    {{#waiting}}<span class="eguahe-wait">{{#str}}inbox_waits_for, local_oksigeniaeguahe, {{waited}}{{/str}}</span>{{/waiting}}
                    <span class="eguahe-quiet">{{channel}} · {{last}}</span>
                </span>
            </a>
        </li>
        {{/rows}}
    </ul>
    {{/hasrows}}
    {{^hasrows}}
    <div class="eguahe-empty">
        {{^all}}<p>{{#str}}inbox_empty_waiting, local_oksigeniaeguahe{{/str}}</p>{{/all}}
        {{#all}}<p>{{#str}}inbox_empty_all, local_oksigeniaeguahe{{/str}}</p>{{/all}}
    </div>
    {{/hasrows}}

    <section class="eguahe-offers" aria-labelledby="eguahe-offers-title">
        <h3 id="eguahe-offers-title">{{#str}}offers_title, local_oksigeniaeguahe{{/str}}</h3>
        {{#hasoffers}}
        <table class="table eguahe-table">
            <thead><tr>
                <th scope="col">{{#str}}offer, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}offers_open, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}offers_visited, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}offers_enrolled, local_oksigeniaeguahe{{/str}}</th>
                <th scope="col" class="eguahe-num">{{#str}}offers_left, local_oksigeniaeguahe{{/str}}</th>
            </tr></thead>
            <tbody>
            {{#offers}}
                <tr>
                    <th scope="row">{{name}} <span class="eguahe-quiet">{{year}}</span></th>
                    <td class="eguahe-num">{{open}}</td>
                    <td class="eguahe-num">{{visited}}</td>
                    <td class="eguahe-num">{{enrolled}}</td>
                    <td class="eguahe-num">{{#hasplaces}}{{left}} / {{places}}{{/hasplaces}}{{^hasplaces}}–{{/hasplaces}}</td>
                </tr>
            {{/offers}}
            </tbody>
        </table>
        <p class="eguahe-quiet">{{#str}}offers_definitions, local_oksigeniaeguahe{{/str}}</p>
        {{/hasoffers}}
        {{^hasoffers}}
        <p>{{#str}}offers_none, local_oksigeniaeguahe{{/str}}</p>
        {{#settingsurl}}<p><a href="{{settingsurl}}">{{#str}}offers_add, local_oksigeniaeguahe{{/str}}</a></p>{{/settingsurl}}
        {{/hasoffers}}
    </section>
</div>
